      {equip:"CIGALEROS P&P",pts:708,proves:[80,72,56,100,100,100,100,100]},
      {equip:"ROC & ROLL",pts:624,roc:true,proves:[56,100,100,64,64,80,80,80]},
      {equip:"CAN RAFEL 2017",pts:606,proves:[100,80,90,56,90,90,50,50]},
      {equip:"BEN TROBATS LA GARRIGA",pts:509,proves:[90,90,44,90,44,72,23,56]},
      {equip:"EVEREST GOLF VALLES",pts:475,proves:[72,33,50,80,56,56,38,90]},
      {equip:"TEAM VALLES",pts:460,proves:[50,64,64,72,38,64,64,44]},
      {equip:"BLAUMAT NEW OLEASTRUM",pts:413,proves:[28,38,80,38,23,44,90,72]},
      {equip:"TEE-GREENS VALLROMANES",pts:367,proves:[33,56,72,33,72,19,44,38]},
      {equip:"GOLFRIENDS",pts:347,proves:[64,23,33,19,80,33,72,23]},
      {equip:"VILA GOLF",pts:337,proves:[44,50,38,50,33,38,56,28]},
      {equip:"CLINICA PINYOL P&P i GOLF PENEDES",pts:237,proves:[23,28,23,15,28,28,28,64]},
      {equip:"C.E. PERITAS MIAMI-PLAYA",pts:227,proves:[19,15,28,44,19,50,33,19]},
      {equip:"DREAM PIM BADALONA",pts:226,proves:[15,44,19,23,50,23,19,33]},
      {equip:"LOS IRREDUCTIBLES",pts:160,proves:[38,19,15,28,15,15,15,15]},
    ]},
    2026:{pos:null,totalEquips:null,punts:null,divisio:"3ª",ascens:false,pruebas:[
      {camp:"Lleida",fecha:"15/02/2026",total:42,ind1:["Ferran Lobón Sorando",7,"Quim Pallares Rius",10],ind2:["Oscar Pique Parrot",12,"Ferran Esteller Valen",13],par1:["Enrique Caro García","Manuel Gómez Ramirez",3],par2:["Alvaro Jimenez-Asenjo","Lluis Carrera Malla",9]},
      {camp:"Vendrell",fecha:"28/02/2026",total:38,ind1:["Jordi García Cabra",8,"Quim Pallares Rius",10],ind2:["Ferran Lobón Sorando",9,"Ferran Esteller Valen",11],par1:["Lluis Carrera Malla","Manuel Gómez Ramirez",2],par2:["Alvaro Jimenez-Asenjo","Jordi García Cabra",7]},
      {camp:"Bellpuig",fecha:"22/03/2026",total:32,ind1:["Ferran Lobón Sorando",5,"Jordi García Cabra",4],ind2:["Quim Pallares Rius",6,"Ferran Esteller Valen",17],par1:["Enrique Caro García","Manuel Gómez Ramirez",2],par2:["Quim Bofarull Mora","Lluis Carrera Malla",13]},
      {camp:"El Vallès",fecha:"18/04/2026",total:26,ind1:["Ferran Lobón Sorando",7,"Alvaro Jimenez-Asenjo",7],ind2:["Jordi García Cabra",12,"Quim Pallares Rius",13],par1:["Quim Bofarull Mora","Ferran Esteller Valen",0],par2:["Lluis Carrera Malla","Albert Bedos Torrens",1]},
      {camp:"Canal Olímpic",total:null,ind1:null,ind2:null,par1:null,par2:null},
      {camp:"Can Mascaró",total:null,ind1:null,ind2:null,par1:null,par2:null},
      {camp:"Lleida (2)",total:null,ind1:null,ind2:null,par1:null,par2:null},
      {camp:"Bon Area",total:null,ind1:null,ind2:null,par1:null,par2:null},
    ],clas:null},
  };

function renderInterclubs(el){
  function abrev(name){const p=name.split(' ');return p.length<=1?name:p[0]+' '+p[p.length-1];}

  // ── Normalizar nombre de campos (acento) ──
  function normCamp(c){return c==='El Valles'||c==='El Vallés'?'El Vallès':c;}

  // ── Calcular playerStats automáticamente desde IC — solo individuales ──
  const playerStatsMap={};
  Object.values(IC).forEach(yearData=>{
    yearData.pruebas.forEach(prueba=>{
      if(!prueba.total)return;
      // Los 4 individuales con sus scores
      const all=[];
      if(prueba.ind1){all.push({name:prueba.ind1[0],score:prueba.ind1[1]},{name:prueba.ind1[2],score:prueba.ind1[3]});}
      if(prueba.ind2){all.push({name:prueba.ind2[0],score:prueba.ind2[1]},{name:prueba.ind2[2],score:prueba.ind2[3]});}
      // Registrar participación
      all.forEach(({name})=>{
        if(!playerStatsMap[name])playerStatsMap[name]={name,p1:0,p2:0,p3:0,p4:0,total:0,totalInd:0};
        playerStatsMap[name].total++;
        playerStatsMap[name].totalInd++;
      });
      // Asignar posiciones con empates: todos los del mismo score comparten posición
      all.forEach(({name,score})=>{
        if(!playerStatsMap[name])playerStatsMap[name]={name,p1:0,p2:0,p3:0,p4:0,total:0,totalInd:0};
        const pos=all.filter(x=>x.score<score).length+1;
        if(pos===1)playerStatsMap[name].p1++;
        else if(pos===2)playerStatsMap[name].p2++;
        else if(pos===3)playerStatsMap[name].p3++;
        else if(pos===4)playerStatsMap[name].p4++;
      });
      // Parejas — solo participación total, sin posiciones ni totalInd
      [prueba.par1,prueba.par2].forEach(par=>{
        if(!par||par[2]===null||par[2]===undefined)return;
        [par[0],par[1]].forEach(name=>{
          if(!playerStatsMap[name])playerStatsMap[name]={name,p1:0,p2:0,p3:0,p4:0,total:0,totalInd:0};
          playerStatsMap[name].total++;
        });
      });
    });
  });
  const playerStats=Object.values(playerStatsMap).sort((a,b)=>b.total-a.total);

  // Stats totals
  const totalP1=playerStats.reduce((s,p)=>s+p.p1,0);
  const totalP2=playerStats.reduce((s,p)=>s+p.p2,0);
  const totalP3=playerStats.reduce((s,p)=>s+p.p3,0);
  const totalPodium=totalP1+totalP2+totalP3;
  const totalJornades=playerStats.reduce((s,p)=>s+p.total,0);
  const pctT=(n)=>totalJornades>0?Math.round(n/totalJornades*100)+'%':'-';

  // ── Posiciones del equipo por prueba — desde proves de cada año ──
  let teamP1=0,teamP2=0,teamP3=0;
  Object.values(IC).forEach(yearData=>{
    if(!yearData.clas)return;
    const rocRow=yearData.clas.find(c=>c.roc===true);
    if(!rocRow)return;
    rocRow.proves.forEach(pts=>{
      if(pts===100)teamP1++;
      else if(pts===90)teamP2++;
      else if(pts===80)teamP3++;
    });
  });
  const teamPruebas=Object.values(IC).reduce((s,y)=>s+y.pruebas.filter(p=>p.total!==null&&p.total>0).length,0);
  const tpct=(n)=>teamPruebas>0?Math.round(n/teamPruebas*100)+'%':'0%';

  let h='';

  // Row 1: general (4 cards)
  h+='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px">';
  // Calcular campos jugados y más visitado desde IC (con acento normalizado)
  const campCount={};
  Object.values(IC).forEach(y=>y.pruebas.forEach(p=>{if(p.total!==null&&p.total>0){const c=normCamp(p.camp);campCount[c]=(campCount[c]||0)+1;}}));
  const campsJugados=Object.keys(campCount).length;
  const maxVisitas=Math.max(...Object.values(campCount));
  const camposMasVisitados=Object.entries(campCount).filter(([,v])=>v===maxVisitas).map(([k])=>k);
  const temporadas=[...new Set(Object.keys(IC).map(Number))].sort();
  const camposSorted=Object.entries(campCount).sort((a,b)=>b[1]-a[1]);

  h+='<div style="background:#f0fdf4;border-radius:12px;padding:14px 16px;border:1px solid #bbf7d0"><div style="font-size:11px;color:#555;margin-bottom:4px">Temporadas</div><div style="font-size:32px;font-weight:700;color:#15803d;line-height:1">'+temporadas.length+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">'+temporadas.join(' · ')+'</div></div>';
  const pruebasJugadas=Object.values(IC).reduce((s,y)=>s+y.pruebas.filter(p=>p.total!==null&&p.total>0).length,0);
  h+='<div style="background:#eff6ff;border-radius:12px;padding:14px 16px;border:1px solid #bfdbfe"><div style="font-size:11px;color:#555;margin-bottom:4px">Jornadas jugadas</div><div style="font-size:32px;font-weight:700;color:#1d4ed8;line-height:1">'+pruebasJugadas+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">en '+temporadas.length+' temporadas</div></div>';
  h+='<div style="background:#fefce8;border-radius:12px;padding:14px 16px;border:1px solid #fde68a"><div style="font-size:11px;color:#555;margin-bottom:4px">Campos jugados</div><div style="font-size:32px;font-weight:700;color:#854d0e;line-height:1">'+campsJugados+'</div></div>';
  h+='<div onclick="window._showCamposPopup()" style="cursor:pointer;background:#fff0f0;border-radius:12px;padding:14px 16px;border:1px solid #fecaca"><div style="font-size:11px;color:#555;margin-bottom:4px">Campo más visitado</div><div style="font-size:13px;font-weight:700;color:#dc2626;line-height:1.5">'+camposMasVisitados.join('<br>')+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">'+maxVisitas+' veces</div></div>';
  h+='</div>';
  h+=`<div id="campos-popup" onclick="this.style.display='none'" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center">
    <div onclick="event.stopPropagation()" style="background:#fff;border-radius:16px;padding:20px;max-width:340px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3)">
      <div style="font-weight:700;font-size:14px;color:#1a1a1a;margin-bottom:14px">⛳ Campos jugados — historial</div>
      ${camposSorted.map(([camp,n],i)=>`<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:${i%2===0?'#fff0f0':'#fff'};border-radius:8px;margin-bottom:4px;border:1px solid #fecaca44">
        <div style="font-size:18px;font-weight:700;color:#dc2626;min-width:24px;text-align:center">${n}</div>
        <div style="font-size:12px;font-weight:${n===maxVisitas?700:400};color:#333;flex:1">${camp}</div>
        ${n===maxVisitas?'<div style="font-size:14px">⭐</div>':''}
      </div>`).join('')}
      <div onclick="document.getElementById('campos-popup').style.display='none'" style="margin-top:14px;text-align:center;padding:8px;background:#f3f4f6;border-radius:8px;font-size:12px;color:#555;cursor:pointer">Cerrar</div>
    </div>
  </div>`;
  window._showCamposPopup=function(){const p=document.getElementById('campos-popup');if(p)p.style.display='flex';};
  // Row 2: team positions
  const teamPodium=teamP1+teamP2+teamP3;
  h+='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px">';
  h+='<div style="background:#f0fdf4;border-radius:12px;padding:14px 16px;border:1px solid #bbf7d0"><div style="font-size:11px;color:#555;margin-bottom:4px">🥇 Veces 1º equipo</div><div style="font-size:32px;font-weight:700;color:#15803d;line-height:1">'+teamP1+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">('+tpct(teamP1)+') · 100 pts</div></div>';
  h+='<div style="background:#eff6ff;border-radius:12px;padding:14px 16px;border:1px solid #bfdbfe"><div style="font-size:11px;color:#555;margin-bottom:4px">🥈 Veces 2º equipo</div><div style="font-size:32px;font-weight:700;color:#0e7490;line-height:1">'+teamP2+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">('+tpct(teamP2)+') · 90 pts</div></div>';
  h+='<div style="background:#fff7ed;border-radius:12px;padding:14px 16px;border:1px solid #fed7aa"><div style="font-size:11px;color:#555;margin-bottom:4px">🥉 Veces 3º equipo</div><div style="font-size:32px;font-weight:700;color:#c2410c;line-height:1">'+teamP3+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">('+tpct(teamP3)+') · 80 pts</div></div>';
  h+='<div style="background:#fdf4ff;border-radius:12px;padding:14px 16px;border:1px solid #e9d5ff"><div style="font-size:11px;color:#555;margin-bottom:4px">🏆 Podio equipo total</div><div style="font-size:32px;font-weight:700;color:#7c3aed;line-height:1">'+teamPodium+'</div><div style="font-size:10px;color:#aaa;margin-top:4px">('+tpct(teamPodium)+')</div></div>';
  h+='</div>';

  // === 4 EXTRA CARDS — calculadas desde playerStats ──
  const sortedByTotal=[...playerStats].sort((a,b)=>b.total-a.total);

  // Scores individuales desde IC para medias
  const playerScoresMap={};
  Object.values(IC).forEach(y=>y.pruebas.forEach(p=>{
    if(!p.total)return;
    [[p.ind1],[p.ind2]].forEach(arr=>arr.forEach(ind=>{
      if(!ind)return;
      const n1=ind[0],s1=ind[1],n2=ind[2],s2=ind[3];
      if(n1){if(!playerScoresMap[n1])playerScoresMap[n1]=[];playerScoresMap[n1].push(s1);}
      if(n2){if(!playerScoresMap[n2])playerScoresMap[n2]=[];playerScoresMap[n2].push(s2);}
    }));
  }));
  const playerAvgMap={};
  Object.entries(playerScoresMap).forEach(([n,scores])=>{playerAvgMap[n]=scores.reduce((s,v)=>s+v,0)/scores.length;});
  const topAvg=Object.entries(playerAvgMap).sort((a,b)=>a[1]-b[1]).slice(0,3);

  // Scores parejas desde IC para medias
  const parScoresMap={};
  Object.values(IC).forEach(y=>y.pruebas.forEach(p=>{
    if(!p.total)return;
    [p.par1,p.par2].forEach(par=>{
      if(!par||par[2]===null||par[2]===undefined)return;
      const key=abrev(par[0])+' & '+abrev(par[1]);
      if(!parScoresMap[key])parScoresMap[key]=[];
      parScoresMap[key].push(par[2]);
    });
  }));
  const topParAvg=Object.entries(parScoresMap).sort((a,b)=>a[1].reduce((s,v)=>s+v,0)/a[1].length - b[1].reduce((s,v)=>s+v,0)/b[1].length).slice(0,3);

  h+='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px">';

  h+='<div style="background:#f0fdf4;border-radius:12px;padding:14px 16px;border:1px solid #bbf7d0">';
  h+='<div style="font-size:11px;color:#555;margin-bottom:6px;font-weight:600">Más participaciones individual</div>';
  sortedByTotal.slice(0,3).forEach((p,i)=>{
    const medal=i===0?'🥇':i===1?'🥈':'🥉';
    h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px"><span style="font-size:12px;color:'+(i===0?'#222':'#555')+'">'+medal+' '+abrev(p.name)+'</span><span style="font-size:14px;font-weight:700;color:#15803d">'+p.total+'</span></div>';
  });
  h+='</div>';

  h+='<div style="background:#eff6ff;border-radius:12px;padding:14px 16px;border:1px solid #bfdbfe">';
  h+='<div style="font-size:11px;color:#555;margin-bottom:6px;font-weight:600">Más participaciones en pareja</div>';
  const topPar=Object.entries(parScoresMap).sort((a,b)=>b[1].length-a[1].length).slice(0,3);
  topPar.forEach(([name,scores],i)=>{
    const medal=i===0?'🥇':i===1?'🥈':'🥉';
    h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px"><span style="font-size:11px;color:'+(i===0?'#222':'#555')+'">'+medal+' '+name+'</span><span style="font-size:14px;font-weight:700;color:#1d4ed8">'+scores.length+'</span></div>';
  });
  h+='</div>';

  h+='<div style="background:#fefce8;border-radius:12px;padding:14px 16px;border:1px solid #fde68a">';
  h+='<div style="font-size:11px;color:#555;margin-bottom:6px;font-weight:600">Mejor media individual</div>';
  topAvg.forEach(([name,avg],i)=>{
    const medal=i===0?'🥇':i===1?'🥈':'🥉';
    h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px"><span style="font-size:12px;color:'+(i===0?'#222':'#555')+'">'+medal+' '+abrev(name)+'</span><span style="font-size:14px;font-weight:700;color:#854d0e">+'+avg.toFixed(1)+'</span></div>';
  });
  h+='</div>';

  h+='<div style="background:#fdf4ff;border-radius:12px;padding:14px 16px;border:1px solid #e9d5ff">';
  h+='<div style="font-size:11px;color:#555;margin-bottom:6px;font-weight:600">Mejor media en pareja</div>';
  topParAvg.forEach(([name,scores],i)=>{
    const avg=scores.reduce((s,v)=>s+v,0)/scores.length;
    const medal=i===0?'🥇':i===1?'🥈':'🥉';
    h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px"><span style="font-size:11px;color:'+(i===0?'#222':'#555')+'">'+medal+' '+name+'</span><span style="font-size:14px;font-weight:700;color:#7c3aed">+'+avg.toFixed(1)+'</span></div>';
  });
  h+='</div>';

  h+='</div>';

  // === RECORDS ===
  h+='<div style="margin-bottom:20px"><div style="font-weight:600;font-size:13px;color:#555;margin-bottom:10px">Records</div>';
  h+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">';
  const bestInd=[
    {name:"Ferran Esteller Valen",score:-5,camp:"Badalona",year:2025},
    {name:"Jose Millan Navarrete",score:-1,camp:"Tennis Mora",year:2023},
    {name:"Ferran Esteller Valen",score:0,camp:"El Vallès",year:2025},
    {name:"Ferran Esteller Valen",score:2,camp:"ROC 3",year:2023},
    {name:"Ferran Esteller Valen",score:2,camp:"HCP 1",year:2023},
  ];

  h+='<div style="border-radius:10px;border:1px solid #e5e7eb;overflow:hidden">';
  h+='<div style="padding:7px 12px;background:#f9fafb;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#555">🏅 Mejores resultados individuales</div>';
  bestInd.forEach((r,i)=>{
    const bg=i%2===0?"#fff":"#fafafa";
    const medal=i===0?"🥇":i===1?"🥈":i===2?"🥉":"  ";
    const col=r.score<0?"#65d000":r.score===0?"#6b7280":"#222";
    h+="<div style='display:flex;align-items:center;gap:8px;padding:7px 12px;background:"+bg+"'>";
    h+="<span style='font-size:14px'>"+medal+"</span>";
    h+="<div style='flex:1'><div style='font-size:12px;font-weight:500;color:#222'>"+r.name+"</div><div style='font-size:10px;color:#aaa'>"+r.camp+" · "+r.year+"</div></div>";
    h+="<span style='font-size:16px;font-weight:700;color:"+col+"'>"+(r.score>=0?"+":"")+r.score+"</span>";
    h+="</div>";
  });
  h+='</div>';

  const bestPar=[
    {names:"Aleix Martí & Jordi Cabra",score:-2,camp:"Bellpuig",year:2025},
    {names:"Manolo & Enrique Caro",score:-1,camp:"Badalona",year:2025},
    {names:"Jordi Cabra & Alvaro",score:-1,camp:"Badalona",year:2025},
    {names:"Alvaro & Quim Bofarull",score:-1,camp:"El Vallès",year:2025},
    {names:"Manolo & Lluis Carrera",score:-1,camp:"Mas Gurumbau",year:2025},
  ];

  h+='<div style="border-radius:10px;border:1px solid #e5e7eb;overflow:hidden">';
  h+='<div style="padding:7px 12px;background:#f9fafb;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#555">🏅 Mejores resultados en pareja</div>';
  bestPar.forEach((r,i)=>{
    const bg=i%2===0?"#fff":"#fafafa";
    const medal=i===0?"🥇":i===1?"🥈":i===2?"🥉":"  ";
    const col=r.score<0?"#65d000":r.score===0?"#6b7280":"#222";
    h+="<div style='display:flex;align-items:center;gap:8px;padding:7px 12px;background:"+bg+"'>";
    h+="<span style='font-size:14px'>"+medal+"</span>";
    h+="<div style='flex:1'><div style='font-size:12px;font-weight:500;color:#222'>"+r.names+"</div><div style='font-size:10px;color:#aaa'>"+r.camp+" · "+r.year+"</div></div>";
    h+="<span style='font-size:16px;font-weight:700;color:"+col+"'>"+(r.score>=0?"+":"")+r.score+"</span>";
    h+="</div>";
  });
  h+='</div>';
  h+='</div></div>';

  let icSortCol='total', icSortDir=1;
  function renderICTable(){
    const sorted=[...playerStats].sort((a,b)=>{
      const pctVal=(p,k)=>p.totalInd>0?p[k]/p.totalInd:0;
      const podVal=(p)=>p.p1+p.p2+p.p3;
      let va,vb;
      if(icSortCol==='name'){va=a.name;vb=b.name;}
      else if(icSortCol==='podium'){va=podVal(a);vb=podVal(b);}
      else if(icSortCol==='pct1'){va=pctVal(a,'p1');vb=pctVal(b,'p1');}
      else if(icSortCol==='pct2'){va=pctVal(a,'p2');vb=pctVal(b,'p2');}
      else if(icSortCol==='pct3'){va=pctVal(a,'p3');vb=pctVal(b,'p3');}
      else if(icSortCol==='pctPod'){va=pctVal(a,'p1')+pctVal(a,'p2')+pctVal(a,'p3');vb=pctVal(b,'p1')+pctVal(b,'p2')+pctVal(b,'p3');}
      else if(icSortCol==='pct4'){va=pctVal(a,'p4');vb=pctVal(b,'p4');}
      else{va=a[icSortCol]??0;vb=b[icSortCol]??0;}
      if(typeof va==='string') return va.localeCompare(vb)*icSortDir;
      return (vb-va)*icSortDir;
    });
    function thBtn(col,label,align){
      const active=icSortCol===col;
      const arrow=active?(icSortDir===1?'↓':'↑'):'';
      return '<th style="padding:7px 8px;text-align:'+(align||'center')+';font-weight:600;color:#fff;cursor:pointer;white-space:nowrap;user-select:none" onclick="window._icSort(\''+col+'\')" >'+label+(arrow?' '+arrow:'')+'</th>';
    }
    const tdP='padding:6px 4px;text-align:center;color:#555;font-size:10px';
    let t='<table style="border-collapse:collapse;width:100%;font-size:11px"><thead><tr style="background:#1e3a8a">';
    t+=thBtn('name','Jugador','left');
    t+=thBtn('p1','🥇')+thBtn('pct1','📊');
    t+=thBtn('p2','🥈')+thBtn('pct2','📊');
    t+=thBtn('p3','🥉')+thBtn('pct3','📊');
    t+=thBtn('podium','🏆')+thBtn('pctPod','📊');
    t+=thBtn('p4','4️⃣')+thBtn('pct4','📊');
    t+=thBtn('total','Total');
    t+='</tr></thead><tbody>';
    sorted.forEach((p,i)=>{
      const bg=i%2===0?'#f3f4f6':'#e5e7eb';
      const pod=p.p1+p.p2+p.p3;
      const pct=(n)=>p.totalInd>0?Math.round(n/p.totalInd*100)+'%':'-';
      t+='<tr style="background:'+bg+'">';
      t+='<td style="padding:6px 10px;font-weight:500;color:#222;white-space:nowrap">'+p.name+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;font-weight:600;color:#15803d">'+p.p1+'</td><td style="'+tdP+'">'+pct(p.p1)+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;font-weight:600;color:#0e7490">'+p.p2+'</td><td style="'+tdP+'">'+pct(p.p2)+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;font-weight:600;color:#c2410c">'+p.p3+'</td><td style="'+tdP+'">'+pct(p.p3)+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;font-weight:700;color:#1e40af;background:'+bg+'">'+pod+'</td>';
      t+='<td style="'+tdP+'background:'+bg+'">'+pct(pod)+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;color:#555">'+p.p4+'</td><td style="'+tdP+'">'+pct(p.p4)+'</td>';
      t+='<td style="padding:6px 8px;text-align:center;font-weight:600;color:#555">'+p.total+'</td>';
      t+='</tr>';
    });
    t+='</tbody></table>';
    const el2=document.getElementById('ic-rank-table');
    if(el2) el2.innerHTML=t;
  }
  window._icSort=function(col){
    if(icSortCol===col) icSortDir*=-1; else {icSortCol=col;icSortDir=1;}
    renderICTable();
  };

  h+='<div style="margin-bottom:20px"><div style="font-weight:600;font-size:13px;color:#555;margin-bottom:10px">Clasificación individual interclubs</div>';
  h+='<div id="ic-rank-table" style="border-radius:10px;border:1px solid #e5e7eb;overflow:hidden;overflow-x:auto"></div></div>';

  // === TEMPORADES ===
  const years=[2026,2025,2024,2023];
  years.forEach(year=>{
    const data=IC[year];
    const isActive=year===2026;
    const completedPruebas=data.pruebas.filter(p=>p.total!==null&&p.total>0);
    const runningTotal=completedPruebas.reduce((s,p)=>s+p.total,0);

    h+='<div style="margin-bottom:28px">';
    h+='<div style="display:inline-flex;align-items:center;gap:10px;margin-bottom:10px;padding:8px 16px;background:#4a6fa5;border-radius:10px">';
    h+='<span style="font-size:22px;font-weight:700;color:#fff">Temporada '+year+'</span>';
    h+='<span style="font-size:16px;color:#fff">'+data.divisio+' división</span>';
    if(isActive) h+='<span style="font-size:13px;font-weight:600;color:#fff;background:rgba(101,208,0,0.7);padding:2px 8px;border-radius:6px">EN CURSO</span>';
    if(data.ascens) h+='<span style="font-size:13px;font-weight:600;color:#fff;background:rgba(245,158,11,0.8);padding:2px 8px;border-radius:6px">🏆 ASCENSO</span>';
    h+='<span style="font-size:20px;font-weight:700;color:#fff">'+runningTotal+(isActive?' ('+completedPruebas.length+'/8)':'')+'</span>';
    h+='</div><br>';

    h+='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:14px">';
    data.pruebas.forEach((p,pi)=>{
      const done=p.total!==null&&p.total>0;
      const popupId=`ic-popup-${year}-${pi}`;
      // Card — clickable if done
      const clickAttr=done?'onclick="window._showICPopup(\''+popupId+'\')" style="cursor:pointer;border-radius:8px;border:1px solid #e5e7eb;overflow:hidden;background:#fff"':'style="border-radius:8px;border:1px solid #e5e7eb;overflow:hidden;background:#fff"';
      h+='<div '+clickAttr+'>';
      h+='<div style="display:flex;align-items:center;gap:4px;padding:6px 8px;background:#4a6fa5">';
      h+='<span style="font-size:16px;font-weight:700;color:#fff;min-width:20px">'+(pi+1)+'</span>';
      h+='<div style="flex:1;text-align:center;line-height:1.15">';
      h+='<div style="font-size:16px;font-weight:700;color:#fff">'+p.camp+'</div>';
      if(p.fecha) h+='<div style="font-size:10px;font-weight:500;color:#fff;opacity:0.78;margin-top:1px">'+p.fecha+'</div>';
      h+='</div>';
      if(done) h+='<span style="font-size:18px;font-weight:700;color:#fff">'+p.total+'</span>';
      h+='</div>';
      if(done){
        if(p.ind1){
          const allS=[p.ind1[1],p.ind1[3],p.ind2[1],p.ind2[3]];
          const wI=Math.min(...allS);
          h+='<div style="padding:5px 7px;background:#fff">';
          h+='<div style="font-size:11px;color:#aaa;font-weight:600;margin-bottom:3px;text-transform:uppercase">Individuals</div>';
          [[p.ind1[0],p.ind1[1]],[p.ind1[2],p.ind1[3]],[p.ind2[0],p.ind2[1]],[p.ind2[2],p.ind2[3]]].forEach(([n,s])=>{
            const isW=s===wI;
            h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;padding:1px 2px;'+(isW?'background:#f0fdf4;border-radius:4px':'')+'">';
            h+='<span style="font-size:14px;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+abrev(n)+'</span>';
            h+='<span style="font-size:14px;font-weight:600;color:'+(isW?'#15803d':'#222')+';flex-shrink:0;margin-left:4px">'+(s>=0?'+':'')+s+'</span>';
            h+='</div>';
          });
          h+='</div>';
        }
        if(p.par1){
          const wP=Math.min(p.par1[2],p.par2[2]);
          h+='<div style="padding:5px 7px;border-top:1px solid #f0f0f0;background:#fff">';
          h+='<div style="font-size:11px;color:#aaa;font-weight:600;margin-bottom:3px;text-transform:uppercase">Parejas</div>';
          [p.par1,p.par2].forEach(par=>{
            const isW=par[2]===wP;
            h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;padding:1px 2px;'+(isW?'background:#f0fdf4;border-radius:4px':'')+'">';
            h+='<span style="font-size:14px;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+abrev(par[0])+' & '+abrev(par[1])+'</span>';
            h+='<span style="font-size:14px;font-weight:600;color:'+(isW?'#15803d':'#222')+';flex-shrink:0;margin-left:4px">'+(par[2]>=0?'+':'')+par[2]+'</span>';
            h+='</div>';
          });
          h+='</div>';
        }
      } else {
        h+='<div style="padding:20px;text-align:center;color:#ccc;font-size:16px">Pendiente</div>';
      }
      h+='</div>';

      // ── POPUP detalle jornada ──
      if(done){
        const allInd=p.ind1&&p.ind2?[[p.ind1[0],p.ind1[1]],[p.ind1[2],p.ind1[3]],[p.ind2[0],p.ind2[1]],[p.ind2[2],p.ind2[3]]]:[];
        const indSorted=[...allInd].sort((a,b)=>a[1]-b[1]);
        h+=`<div id="${popupId}" onclick="this.style.display='none'" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.55);z-index:9999;align-items:center;justify-content:center">
          <div onclick="event.stopPropagation()" style="background:#fff;border-radius:16px;padding:0;max-width:400px;width:92%;box-shadow:0 24px 64px rgba(0,0,0,0.3);overflow:hidden">
            <div style="background:#4a6fa5;padding:14px 18px;display:flex;align-items:center;justify-content:space-between">
              <div>
                <div style="font-size:16px;font-weight:700;color:#fff">${p.camp} · ${year}</div>
                <div style="font-size:12px;color:#cbd5e1;margin-top:2px">Prueba ${pi+1} · Total equipo: <b style="color:#fff">${p.total>=0?'+'+p.total:p.total}</b></div>
              </div>
              <div onclick="document.getElementById('${popupId}').style.display='none'" style="cursor:pointer;font-size:20px;color:#fff;padding:4px 8px">✕</div>
            </div>
            <div style="padding:16px 18px">
              <div style="font-size:11px;font-weight:700;color:#4a6fa5;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px">Individuales</div>
              ${indSorted.map(([n,s],i)=>{
                const pos=allInd.filter(([,ss])=>ss<s).length+1;
                const medal=pos===1?'🥇':pos===2?'🥈':pos===3?'🥉':'4️⃣';
                const bg=pos===1?'#f0fdf4':pos===2?'#eff6ff':pos===3?'#fff7ed':'#fafafa';
                return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:${bg};border-radius:9px;margin-bottom:6px">
                  <div style="font-size:20px">${medal}</div>
                  <div style="flex:1;font-size:13px;font-weight:500;color:#222">${n}</div>
                  <div style="font-size:18px;font-weight:700;color:${s<0?'#15803d':s===0?'#6b7280':'#1e3a8a'}">${s>=0?'+'+s:s}</div>
                </div>`;
              }).join('')}
              ${p.par1?`<div style="font-size:11px;font-weight:700;color:#4a6fa5;text-transform:uppercase;letter-spacing:0.5px;margin:14px 0 10px">Parejas</div>
              ${[p.par1,p.par2].sort((a,b)=>a[2]-b[2]).map((par,i)=>{
                const isW=par[2]===Math.min(p.par1[2],p.par2[2]);
                return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:${isW?'#f0fdf4':'#fafafa'};border-radius:9px;margin-bottom:6px">
                  <div style="font-size:20px">${i===0?'🥇':'🥈'}</div>
                  <div style="flex:1;font-size:13px;font-weight:500;color:#222">${par[0].split(' ')[0]} & ${par[1].split(' ')[0]}</div>
                  <div style="font-size:18px;font-weight:700;color:${par[2]<0?'#15803d':par[2]===0?'#6b7280':'#1e3a8a'}">${par[2]>=0?'+'+par[2]:par[2]}</div>
                </div>`;
              }).join('')}`:''}
            </div>
          </div>
        </div>`;
      }
    });
    h+='</div>';

    if(data.clas){
      h+='<div style="border-radius:10px;border:1px solid #e5e7eb;overflow:hidden;overflow-x:auto">';
      h+='<div style="padding:6px 12px;background:#f9fafb;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#555">Clasificación final '+year+'</div>';
      h+='<table style="border-collapse:collapse;width:100%;font-size:11px"><thead><tr>';
      h+='<th style="padding:5px 8px;background:#f3f4f6;color:#888;font-weight:600;text-align:center;white-space:nowrap">Pos</th>';
      h+='<th style="padding:5px 8px;background:#f3f4f6;color:#888;font-weight:600;text-align:left;white-space:nowrap">Equip</th>';
      for(let i=1;i<=8;i++) h+='<th style="padding:5px 6px;background:#f3f4f6;color:#888;font-weight:600;text-align:center;white-space:nowrap">'+i+'</th>';
      h+='<th style="padding:5px 8px;background:#f3f4f6;color:#888;font-weight:600;text-align:center;white-space:nowrap">Total</th>';
      h+='</tr></thead><tbody>';
      data.clas.forEach((c,i)=>{
        const isRoc=c.roc===true;
        const bg=isRoc?'#fef9c3':i%2===0?'#fff':'#fafafa';
        const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':'';
        h+='<tr style="background:'+bg+'">';
        h+='<td style="padding:4px 8px;text-align:center;font-weight:'+(isRoc?700:400)+';color:#555">'+medal+(medal?'':i+1)+'</td>';
        h+='<td style="padding:4px 8px;font-weight:'+(isRoc?700:400)+';color:'+(isRoc?'#854d0e':'#333')+';white-space:nowrap">'+c.equip+(isRoc?' ⭐':'')+'</td>';
        c.proves.forEach(pts=>{
          h+='<td style="padding:4px 6px;text-align:center;font-weight:'+(pts===100?600:400)+';color:'+(pts===100?'#15803d':pts>=80?'#1e40af':'#555')+'">'+(pts||'—')+'</td>';
        });
        h+='<td style="padding:4px 8px;text-align:center;font-weight:700;color:'+(isRoc?'#854d0e':'#1e3a8a')+'">'+c.pts+'</td>';
        h+='</tr>';
      });
      h+='</tbody></table></div>';
    }
    h+='</div>';
  });

  window._showICPopup=function(id){const p=document.getElementById(id);if(p)p.style.display='flex';};

  el.innerHTML=h;
  renderICTable();
}

function renderCopaRocRoll(el){
  const COPA=[
    {
      año:2025,
      fecha:"25/11/2025",
      ganador:"Sucio",
      desempate:{jugadores:["Sucio","Luichy"],hoyo1:[3,3],hoyo2:[2,2],hoyo3:[null,null],resultado:"Sucio gana en el hoyo 3 · Luichy levanta bola"},
      jugadores:[
        {n:"Sucio",    f:[3,3,3,3,3,3,4,3,6], b:[4,3,3,3,3,4,3,3,2,3], tot:4,  bir:1,par:14,bog:2,dbl:1},
        {n:"Luichy",   f:[3,3,3,3,3,3,2,3,4], b:[0,3,3,2,3,3,4,6,3,4], tot:4,  bir:2,par:12,bog:3,dbl:1},
        {n:"Finestres",f:[3,4,3,3,3,3,4,3,3], b:[2,3,3,6,2,4,2,4,3,3], tot:5,  bir:2,par:11,bog:4,dbl:1},
        {n:"Kike",     f:[2,4,4,3,4,3,4,2,2], b:[1,4,3,3,7,4,2,4,3,2], tot:6,  bir:5,par:5, bog:7,dbl:1},
        {n:"Manolo",   f:[4,3,4,3,3,3,4,2,4], b:[3,4,5,3,3,3,3,3,3,3], tot:6,  bir:1,par:11,bog:5,dbl:1},
        {n:"Cabra",    f:[2,3,3,4,3,4,4,3,3], b:[2,4,3,5,5,3,3,4,3,3], tot:8,  bir:1,par:10,bog:5,dbl:2},
        {n:"Bofarull", f:[3,4,2,2,3,3,5,3,3], b:[1,3,5,4,3,4,6,3,6,3], tot:11, bir:2,par:9, bog:3,dbl:4},
        {n:"Alvaro",   f:[4,4,3,3,5,4,4,3,3], b:[6,3,4,2,3,7,2,4,3,4], tot:11, bir:2,par:7, bog:7,dbl:2},
        {n:"David",    f:[5,5,5,2,3,3,5,6,2], b:[9,5,6,2,3,3,2,4,2,3], tot:12, bir:5,par:5, bog:1,dbl:7},
        {n:"Aleix",    f:[2,5,3,4,3,4,3,5,4], b:[6,3,5,3,4,3,3,5,4,3], tot:12, bir:1,par:8, bog:5,dbl:4},
        {n:"Capi",     f:[5,5,3,6,4,3,3,4,5], b:[11,3,4,2,2,2,3,5,5,7],tot:17, bir:3,par:5, bog:3,dbl:7},
      ]
    }
  ];

  function hCell(v){
    if(v===null||v===undefined)return'<td style="text-align:center;padding:2px 3px;color:#ccc">—</td>';
    const s=v<=2?{bg:'#65d000',col:'#fff',fw:700,round:true}:v===3?{bg:'transparent',col:'#333',fw:400}:v===4?{bg:'#06b6d4',col:'#fff',fw:600}:{bg:'#1e3a8a',col:'#fff',fw:700};
    const inner=s.round
      ?`<span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:${s.bg};color:${s.col};font-weight:${s.fw};font-size:11px">${v}</span>`
      :`<span style="display:inline-block;width:18px;height:18px;line-height:18px;text-align:center;border-radius:3px;background:${s.bg};color:${s.col};font-weight:${s.fw};font-size:11px">${v}</span>`;
    return`<td style="text-align:center;padding:2px 1px">${inner}</td>`;
  }

  function totCell(v){
    const bg=v<0?'#65d000':v===0?'#6b7280':v<=6?'#1e3a8a':'#991b1b';
    const txt=v<0?String(v):v===0?'E':'+'+v;
    return`<td style="text-align:center;padding:2px 6px;font-weight:700;font-size:12px;color:#fff;background:${bg};border-radius:4px">${txt}</td>`;
  }

  let h=`<div style="max-width:780px">`;
  h+=`<div style="display:flex;align-items:center;gap:10px;margin-bottom:20px">
    <span style="font-size:28px">🎸</span>
    <div>
      <div style="font-size:16px;font-weight:700;color:#1a1a1a">Copa Roc&Roll</div>
      <div style="font-size:11px;color:#aaa">Campeonato anual individual — todos contra todos</div>
    </div>
  </div>`;

  COPA.forEach(ed=>{
    // ── Cuadro de honor ──
    const birdieLider=ed.jugadores.reduce((a,b)=>b.bir>a.bir?b:a);
    h+=`<div style="border:2px solid #fde68a;border-radius:14px;margin-bottom:20px;overflow:hidden">
      <div style="background:linear-gradient(135deg,#78350f,#92400e);padding:10px 16px">
        <div style="font-size:12px;font-weight:700;color:#fde68a;letter-spacing:1px;text-transform:uppercase">🏅 Cuadro de Honor</div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0">
        <div style="padding:14px 16px;border-right:1px solid #fde68a22;border-bottom:1px solid #fde68a22">
          <div style="font-size:10px;font-weight:600;color:#92400e;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px">Año</div>
          <div style="font-size:22px;font-weight:700;color:#1a1a1a">${ed.año}</div>
          <div style="font-size:10px;color:#aaa;margin-top:2px">${ed.fecha}</div>
        </div>
        <div style="padding:14px 16px;border-right:1px solid #fde68a22;border-bottom:1px solid #fde68a22;background:#fef9c3">
          <div style="font-size:10px;font-weight:600;color:#92400e;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px">🥇 Campeón</div>
          <div style="font-size:20px;font-weight:700;color:#78350f">${ed.ganador}</div>
          <div style="display:inline-block;margin-top:4px;padding:2px 8px;background:${COLORS[ed.ganador]||'#eee'};border-radius:8px;font-size:10px;color:#333;font-weight:500">ganador</div>
        </div>
        <div style="padding:14px 16px;border-bottom:1px solid #fde68a22">
          <div style="font-size:10px;font-weight:600;color:#92400e;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px">🐦 Más birdies</div>
          <div style="font-size:20px;font-weight:700;color:#854d0e">${birdieLider.n}</div>
          <div style="font-size:13px;font-weight:600;color:#854d0e;margin-top:2px">${birdieLider.bir} birdies</div>
        </div>
      </div>
    </div>`;

    // ── Tarjeta edición ──
    h+=`<div style="border:2px solid #fde68a;border-radius:14px;margin-bottom:24px;overflow:hidden">`;

    // Cabecera edición
    h+=`<div style="background:linear-gradient(135deg,#92400e,#b45309);padding:12px 16px;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div style="font-size:15px;font-weight:700;color:#fff">🏆 Copa Roc&Roll ${ed.año}</div>
        <div style="font-size:11px;color:#fde68a;margin-top:2px">${ed.fecha}</div>
      </div>
      <div style="text-align:right">
        <div style="font-size:11px;color:#fde68a;margin-bottom:2px">Campeón</div>
        <div style="font-size:20px;font-weight:700;color:#fff">🥇 ${ed.ganador}</div>
      </div>
    </div>`;

    // Scorecard
    h+=`<div style="padding:12px 14px;overflow-x:auto">
      <div style="font-size:11px;font-weight:600;color:#555;margin-bottom:8px">Scorecard completo</div>
      <table style="border-collapse:collapse;font-size:11px;min-width:600px">
        <thead>
          <tr style="background:#f9fafb">
            <th style="padding:4px 8px;text-align:left;font-weight:600;color:#555;white-space:nowrap">Jugador</th>
            ${Array.from({length:9},(_,i)=>`<th style="padding:3px 2px;text-align:center;color:#888;font-weight:500;width:22px">${i+1}</th>`).join('')}
            <th style="padding:3px 5px;text-align:center;color:#1e40af;font-weight:700;font-size:10px">OUT</th>
            ${Array.from({length:9},(_,i)=>`<th style="padding:3px 2px;text-align:center;color:#888;font-weight:500;width:22px">${i+10}</th>`).join('')}
            <th style="padding:3px 5px;text-align:center;color:#1e40af;font-weight:700;font-size:10px">IN</th>
            <th style="padding:3px 6px;text-align:center;color:#fff;font-weight:700;font-size:10px;background:#1e3a8a;border-radius:4px">TOT</th>
            <th style="padding:3px 4px;text-align:center;color:#854d0e;font-size:10px">🐦</th>
            <th style="padding:3px 4px;text-align:center;color:#555;font-size:10px">✅</th>
            <th style="padding:3px 4px;text-align:center;color:#c2410c;font-size:10px">❌</th>
            <th style="padding:3px 4px;text-align:center;color:#991b1b;font-size:10px">❌❌</th>
          </tr>
        </thead>
        <tbody>`;

    ed.jugadores.forEach((p,i)=>{
      const bg=i%2===0?'#fff':'#fafafa';
      const isWinner=p.n===ed.ganador;
      const frontSum=p.f.reduce((s,v)=>s+(v||0),0);
      const backSum=p.b.slice(1).reduce((s,v)=>s+(v||0),0); // skip front subtotal col
      const nameBg=COLORS[p.n]||'#e5e7eb';
      h+=`<tr style="background:${isWinner?'#fef9c3':bg}">
        <td style="padding:4px 8px;font-weight:${isWinner?700:500};background:${nameBg};white-space:nowrap">${isWinner?'🥇 ':''  }${p.n}</td>
        ${p.f.map(v=>hCell(v)).join('')}
        <td style="text-align:center;padding:2px 5px;font-weight:700;color:#1e40af;font-size:11px">${p.b[0]>=0?'+'+p.b[0]:p.b[0]}</td>
        ${p.b.slice(1).map(v=>hCell(v)).join('')}
        <td style="text-align:center;padding:2px 5px;font-weight:700;color:#1e40af;font-size:11px">${p.b[0]>=0?'+'+p.b[0]:p.b[0]}</td>
        ${totCell(p.tot)}
        <td style="text-align:center;padding:2px 4px;color:#854d0e;font-weight:600">${p.bir}</td>
        <td style="text-align:center;padding:2px 4px;color:#555">${p.par}</td>
        <td style="text-align:center;padding:2px 4px;color:#c2410c">${p.bog}</td>
        <td style="text-align:center;padding:2px 4px;color:#991b1b;font-weight:${p.dbl>3?600:400}">${p.dbl}</td>
      </tr>`;
    });

    h+=`</tbody></table></div>`;

    // Desempate
    if(ed.desempate){
      const d=ed.desempate;
      h+=`<div style="margin:0 14px 14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:10px 14px">
        <div style="font-size:11px;font-weight:600;color:#1e40af;margin-bottom:8px">⚡ Desempate — ${d.resultado}</div>
        <table style="border-collapse:collapse;font-size:11px">
          <thead><tr>
            <th style="padding:3px 8px;text-align:left;color:#555">Jugador</th>
            <th style="padding:3px 8px;text-align:center;color:#555">H1</th>
            <th style="padding:3px 8px;text-align:center;color:#555">H2</th>
            <th style="padding:3px 8px;text-align:center;color:#555">H3</th>
          </tr></thead>
          <tbody>
            ${d.jugadores.map((jug,i)=>{
              const isW=jug===ed.ganador;
              const h3cell=i===1
                ?`<td style="text-align:center;padding:2px 8px;font-size:11px;color:#7c3aed;font-weight:600;font-style:italic">levanta</td>`
                :hCell(3);
              return`<tr style="background:${isW?'#fef9c3':'#fff'}">
                <td style="padding:4px 8px;font-weight:${isW?700:500};background:${COLORS[jug]||'#eee'}">${isW?'🥇 ':''}${jug}</td>
                ${hCell(d.hoyo1[i])}
                ${hCell(d.hoyo2[i])}
                ${h3cell}
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>`;
    }

    h+=`</div>`;
  });

  h+=`</div>`;
  el.innerHTML=h;
}

// Constante CAMPOS — listado de campos de Pitch & Putt de la Federació Catalana
// (al menos los que conoce el equipo / aparecen en el calendario IC).
// Para añadir uno nuevo: APPEND al array. La pestaña se actualiza sola.
const CAMPOS = [
  { nombre: "Áccura Teià Pitch & Putt",                localidad: "Teià" },
  { nombre: "Can Cuyàs Golf i Pitch & Putt",           localidad: "Sant Feliu de Llobregat",
    metros: [110,88,79,52,107,99,77,104,100,104,106,83,64,83,76,81,89,88] },
  { nombre: "Canal Olímpic de Catalunya (Pitch & Putt)", localidad: "Castelldefels" },
  { nombre: "El Vallès Golf - Pitch & Putt",           localidad: "Terrassa" },
  { nombre: "HCP1 Pitch & Putt",                       localidad: "Sant Vicenç de Montalt" },
  { nombre: "Mas Gurumbau Golf i Pitch & Putt",        localidad: "Taradell" },
  { nombre: "Oller del Mas Pitch & Putt",              localidad: "Manresa" },
  { nombre: "Pitch & Putt Badalona",                   localidad: "Badalona" },
  { nombre: "Pitch & Putt Can Mascaró",                localidad: "La Palma de Cervelló" },
  { nombre: "Pitch & Putt Can Rafel",                  localidad: "Cervelló" },
  { nombre: "Pitch & Putt del Tennis Mora",            localidad: "Sant Andreu de Llavaneres" },
  { nombre: "Pitch & Putt La Garriga",                 localidad: "La Garriga" },
  { nombre: "Pitch & Putt Montseny",                   localidad: "Gualba" },
  { nombre: "Pitch & Putt Portal del Roc",             localidad: "Vilanova i la Geltrú" },
  { nombre: "Pitch & Putt Vallromanes",                localidad: "Vilanova del Vallès" },
  { nombre: "Pitch and Putt Sant Cebrià",              localidad: "Sant Cebrià de Vallalta" },
  { nombre: "Roc 3 Pitch & Putt",                      localidad: "Santa Coloma de Cervelló",
    metros:     [103,120,74,70,87,67,80,95,95,58,115,72,76,93,62,89,95,101],
    metrosEppa: [ 60, 41,74,70,87,67,80,41,57,58, 54,72,76,40,62,89,87, 66] },
];

function renderCampos(el){
  const ordenados = [...CAMPOS].sort((a,b) => a.nombre.localeCompare(b.nombre, 'ca'));
  let h = `<div style="max-width:900px;margin:0 auto">
    <div style="font-size:13px;color:#555;margin-bottom:14px">
      <b>${CAMPOS.length}</b> campos de Pitch &amp; Putt registrados
      <span style="margin-left:8px;color:#888;font-size:11px">(click en una card para ver distancias)</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px">`;
  ordenados.forEach((c, i) => {
    const tieneMetros = Array.isArray(c.metros) && c.metros.length === 18;
    const idx = `campo-${i}`;
    const flecha = tieneMetros ? '<span style="margin-left:auto;color:#15803d;font-size:11px;transition:transform 0.2s">▼</span>' : '';
    const cursor = tieneMetros ? 'cursor:pointer;' : '';
    const onclick = tieneMetros ? `onclick="(function(el){const t=el.querySelector('.campo-detalle');const f=el.querySelector('.campo-flecha');const open=t.style.display!=='none';t.style.display=open?'none':'block';f.style.transform=open?'rotate(0deg)':'rotate(180deg)';})(this)"` : '';
    h += `<div ${onclick} style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;${cursor}transition:border-color 0.15s">
      <div style="display:flex;align-items:flex-start;gap:8px">
        <div style="flex:1">
          <div style="font-weight:600;font-size:13px;color:#15803d;line-height:1.3;margin-bottom:4px">${c.nombre}</div>
          <div style="font-size:11px;color:#6b7280">📍 ${c.localidad}</div>
        </div>
        ${tieneMetros ? '<span class="campo-flecha" style="color:#15803d;font-size:11px;transition:transform 0.2s;margin-top:2px">▼</span>' : ''}
      </div>`;
    if(tieneMetros){
      const front = c.metros.slice(0,9), back = c.metros.slice(9,18);
      const sumFront = front.reduce((s,v)=>s+v,0), sumBack = back.reduce((s,v)=>s+v,0);
      const sumTotal = sumFront + sumBack;
      const tieneEppa = Array.isArray(c.metrosEppa) && c.metrosEppa.length === 18;
      let frontEppa, backEppa, sumFrontEppa, sumBackEppa, sumTotalEppa;
      if(tieneEppa){
        frontEppa = c.metrosEppa.slice(0,9);
        backEppa  = c.metrosEppa.slice(9,18);
        sumFrontEppa = frontEppa.reduce((s,v)=>s+v,0);
        sumBackEppa  = backEppa.reduce((s,v)=>s+v,0);
        sumTotalEppa = sumFrontEppa + sumBackEppa;
      }
      const renderBloque = (arr, arrEppa, offset, suma, sumaEppa, label) => {
        const headers = arr.map((_,j) => `<td style="text-align:center;padding:3px 5px;font-weight:600;color:#374151;font-size:10px">${j+1+offset}</td>`).join('');
        const valores = arr.map(v => `<td style="text-align:center;padding:3px 5px;font-size:11px;color:#1a1a1a">${v}</td>`).join('');
        let filaEppa = '';
        if(arrEppa){
          const valoresEppa = arrEppa.map((v,i) => {
            // Si difiere del país, lo destacamos en color
            const distinto = v !== arr[i];
            const style = distinto ? 'color:#c2410c;font-weight:500' : 'color:#6b7280';
            return `<td style="text-align:center;padding:3px 5px;font-size:11px;${style}">${v}</td>`;
          }).join('');
          filaEppa = `<tr><td style="text-align:center;padding:3px 5px;font-weight:600;color:#6b7280;font-size:10px">eppa</td>${valoresEppa}<td style="text-align:center;padding:3px 5px;font-weight:600;color:#c2410c;font-size:11px">${sumaEppa}</td></tr>`;
        }
        return `<div style="margin-top:8px">
          <div style="font-size:10px;color:#6b7280;font-weight:500;margin-bottom:3px">${label}</div>
          <table style="width:100%;border-collapse:collapse;background:#fafaf5;border-radius:5px;overflow:hidden">
            <tr style="background:#dcfce7"><td style="text-align:center;padding:3px 5px;font-weight:600;color:#15803d;font-size:10px">Hoyo</td>${headers}<td style="text-align:center;padding:3px 5px;font-weight:600;color:#15803d;font-size:10px">Σ</td></tr>
            <tr><td style="text-align:center;padding:3px 5px;font-weight:600;color:#374151;font-size:10px">m</td>${valores}<td style="text-align:center;padding:3px 5px;font-weight:600;color:#15803d;font-size:11px">${suma}</td></tr>
            ${filaEppa}
          </table>
        </div>`;
      };
      const totalEppaLine = tieneEppa
        ? `<span style="color:#c2410c;font-weight:500"> · EPPA ${sumTotalEppa} m</span>`
        : '';
      h += `<div class="campo-detalle" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid #f0eee2">
        ${renderBloque(front, frontEppa, 0, sumFront, sumFrontEppa, 'Front 9 (hoyos 1-9)')}
        ${renderBloque(back, backEppa, 9, sumBack, sumBackEppa, 'Back 9 (hoyos 10-18)')}
        <div style="margin-top:8px;display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:#f0fdf4;border-radius:5px;font-size:11px">
          <span style="color:#374151"><b>Total recorrido</b></span>
          <span style="color:#15803d;font-weight:600">${sumTotal} m${totalEppaLine} · par 54</span>
        </div>
        ${tieneEppa ? '<div style="margin-top:6px;font-size:10px;color:#888;font-style:italic">Fila <span style="color:#c2410c">eppa</span>: distancias en naranja indican que difieren del estándar país</div>' : ''}
      </div>`;
    }
    h += `</div>`;
  });
  h += `</div></div>`;
  el.innerHTML = h;
}

function renderEquipo(el){
  function calcEdad(nac){
    if(!nac) return '—';
    const hoy=new Date(), n=new Date(nac);
    let e=hoy.getFullYear()-n.getFullYear();
    if(hoy<new Date(hoy.getFullYear(),n.getMonth(),n.getDate())) e--;
    return e;
  }
  const ex=[
    {num:0,apodo:"Jose Luis",nombre:"Jose Luis Martín",licencia:"ACPP05134",nac:"",talla:"XXL",desde:"2023",hasta:"2024"},
    {num:0,apodo:"Juan Manuel",nombre:"Juan Manuel Pérez",licencia:"ACPP024549",nac:"",talla:"L",desde:"2023",hasta:"2024"},
    {num:0,apodo:"Aleix",nombre:"Aleix Martí Roure",licencia:"ACCP032643",nac:"",talla:"XXL",desde:"2024",hasta:"2025"},
    {num:0,apodo:"Alejandro",nombre:"Alejandro Basart Gorry",licencia:"",nac:"",talla:"",desde:"2023",hasta:"2023"},
    {num:0,apodo:"Lluís",nombre:"Lluis Freixenet",licencia:"ACPP005759",nac:"",talla:"M",desde:"2023",hasta:"2023"},
    {num:0,apodo:"Guillermo",nombre:"Guillermo Castillo Viesa",licencia:"ACPP029621",nac:"",talla:"L",desde:"2023",hasta:"2023"},
  ];

  const W={nick:140,nom:240,lic:110,desde:55,edad:50,talla:60,hasta:55};
  const tdL='padding:6px 10px;border-bottom:1px solid #f0f0f0;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
  const tdC=tdL+'text-align:center;';
  const thL='padding:7px 10px;font-size:11px;font-weight:600;background:#ede9fe;color:#5b21b6;white-space:nowrap;text-align:left;';
  const thC='padding:7px 10px;font-size:11px;font-weight:600;background:#ede9fe;color:#5b21b6;white-space:nowrap;text-align:center;';

  function cg(hasta){
    return '<colgroup>'
      +'<col style="width:'+W.nick+'px"><col style="width:'+W.nom+'px"><col style="width:'+W.lic+'px">'
      +'<col style="width:'+W.desde+'px"><col style="width:'+W.edad+'px"><col style="width:'+W.talla+'px">'
      +(hasta?'<col style="width:'+W.hasta+'px">':'')
      +'</colgroup>';
  }

  function th(hasta, mediaEdad){
    const edadTxt=mediaEdad!==null?'Edad<br><span style="font-weight:400;font-size:10px">('+mediaEdad+')</span>':'Edad';
    return '<thead><tr>'
      +'<th style="'+thL+'">Nickname</th>'
      +'<th style="'+thL+'">Nombre</th>'
      +'<th style="'+thL+'">Licencia</th>'
      +'<th style="'+thC+'">Desde</th>'
      +'<th style="'+thC+'">'+edadTxt+'</th>'
      +'<th style="'+thC+'">Talla</th>'
      +(hasta?'<th style="'+thC+'">Hasta</th>':'')
      +'</tr></thead>';
  }

  function tbodyActivos(){
    let t='<tbody>';
    EQUIPO.forEach((p,i)=>{
      const bg=i%2===0?'#f3f4f6':'#e5e7eb';
      const badge='<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:3px;background:'+(COLORS[p.apodo]||'#e5e7eb')+';font-size:9px;font-weight:700;color:#333;margin-right:5px;flex-shrink:0">'+p.num+'</span>';
      t+='<tr style="background:'+bg+'">';
      t+='<td style="'+tdL+'">'+badge+'<strong>'+p.apodo+'</strong></td>';
      t+='<td style="'+tdL+'color:#444">'+p.nombre+'</td>';
      t+='<td style="'+tdL+'font-family:monospace;color:#777">'+p.licencia+'</td>';
      t+='<td style="'+tdC+'">'+p.desde+'</td>';
      t+='<td style="'+tdC+'">'+calcEdad(p.nac)+'</td>';
      t+='<td style="'+tdC+'">'+(p.talla?'<span style="font-size:10px;font-weight:600;color:#6d28d9;background:#f5f3ff;padding:2px 6px;border-radius:8px">'+p.talla+'</span>':'—')+'</td>';
      t+='</tr>';
    });
    return t+'</tbody>';
  }

  function tbodyEx(){
    let t='<tbody>';
    ex.forEach((p,i)=>{
      const bg=i%2===0?'#f3f4f6':'#e5e7eb';
      const badge='<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:3px;background:#e5e7eb;font-size:9px;font-weight:700;color:#555;margin-right:5px;flex-shrink:0">'+p.num+'</span>';
      t+='<tr style="background:'+bg+'">';
      t+='<td style="'+tdL+'">'+badge+'<strong>'+p.apodo+'</strong></td>';
      t+='<td style="'+tdL+'color:#444">'+p.nombre+'</td>';
      t+='<td style="'+tdL+'font-family:monospace;color:#777">'+p.licencia+'</td>';
      t+='<td style="'+tdC+'">'+p.desde+'</td>';
      t+='<td style="'+tdC+'">'+calcEdad(p.nac)+'</td>';
      t+='<td style="'+tdC+'">'+(p.talla?'<span style="font-size:10px;font-weight:600;color:#6d28d9;background:#f5f3ff;padding:2px 6px;border-radius:8px">'+p.talla+'</span>':'—')+'</td>';
      t+='<td style="'+tdC+'">'+p.hasta+'</td>';
      t+='</tr>';
    });
    return t+'</tbody>';
  }

  const wA=W.nick+W.nom+W.lic+W.desde+W.edad+W.talla;
  const wE=wA+W.hasta;

  let h='<div style="overflow-x:auto;border-radius:10px;border:1px solid #ede9fe">';
  h+='<div style="font-size:11px;color:#555;padding:6px 10px;font-weight:600;border-bottom:1px solid #ede9fe">Miembros activos</div>';
  const edadesA=EQUIPO.map(p=>calcEdad(p.nac)).filter(e=>e!=='—');
  const mediaA=edadesA.length?(edadesA.reduce((s,e)=>s+e,0)/edadesA.length).toFixed(1):null;
  h+='<table style="border-collapse:collapse;table-layout:fixed;width:'+wA+'px">'+cg(false)+th(false,mediaA)+tbodyActivos()+'</table>';
  h+='<div style="font-size:11px;color:#888;background:#f9fafb;padding:6px 10px;border-top:2px solid #e5e7eb;border-bottom:1px solid #e5e7eb">Antiguos miembros</div>';
  h+='<table style="border-collapse:collapse;table-layout:fixed;width:'+wE+'px">'+cg(true)+th(true,null)+tbodyEx()+'</table>';
  h+='</div>';
  el.innerHTML=h;
}

function renderTabla(el){
  const W={j:28,f:80,p:80,h:22};
  el.innerHTML=`<div style="display:flex;gap:5px;margin-bottom:8px;flex-wrap:wrap;align-items:center"><input id="ts" type="text" placeholder="Buscar…" style="width:100px" oninput="fT()"><select id="tp" onchange="fT()" style="width:110px"><option value="">Todos</option>${PLAYERS.map(p=>`<option>${p}</option>`).join('')}</select><select id="to" onchange="fT()" style="width:120px"><option value="j-asc">Jornada ↑</option><option value="j-desc" selected>Jornada ↓</option><option value="total-asc">Mejor resultado</option><option value="total-desc">Peor resultado</option><option value="bir-desc">Más birdies</option></select><span id="tc2" style="font-size:10px;color:#888;margin-left:auto"></span></div>
  <div style="overflow-x:auto"><table style="table-layout:fixed;border-collapse:collapse;font-size:11px">
  <colgroup>
    <col style="width:${W.j}px"><col style="width:${W.f}px"><col style="width:${W.p}px">
    ${Array.from({length:9},()=>`<col style="width:${W.h}px">`).join('')}
    ${Array.from({length:9},()=>`<col style="width:${W.h}px">`).join('')}
    <col style="width:36px">
    <col style="width:28px"><col style="width:28px"><col style="width:28px"><col style="width:28px">
  </colgroup>
  <thead><tr>
    <th style="padding:3px 2px;background:#f9fafb;border:1px solid #e5e7eb">J</th>
    <th style="padding:3px 4px;background:#f9fafb;border:1px solid #e5e7eb;text-align:left">Fecha</th>
    <th style="padding:3px 4px;background:#f9fafb;border:1px solid #e5e7eb;text-align:left">Jugador</th>
    ${Array.from({length:9},(_,i)=>`<th style="padding:2px 1px;background:#e5e7eb;color:#555;font-size:10px;border:1px solid #d1d5db">${i+1}</th>`).join('')}
    ${Array.from({length:9},(_,i)=>`<th style="padding:2px 1px;background:#e5e7eb;color:#555;font-size:10px;border:1px solid #d1d5db">${i+10}</th>`).join('')}
    <th style="padding:3px 2px;background:#1e40af;color:#fff;font-size:11px;font-weight:600;border:1px solid #1e3a8a">Tot</th>
    <th style="padding:3px 1px;background:#f9fafb;font-size:10px;border:1px solid #e5e7eb" title="Birdies">🐦</th>
    <th style="padding:3px 1px;background:#f9fafb;font-size:10px;border:1px solid #e5e7eb" title="Pares">✅</th>
    <th style="padding:3px 1px;background:#f9fafb;font-size:10px;border:1px solid #e5e7eb" title="Bogeys">❌</th>
    <th style="padding:3px 1px;background:#f9fafb;font-size:10px;border:1px solid #e5e7eb" title="Dobles">❌❌</th>
  </tr></thead>
  <tbody id="tb"></tbody></table></div>`;
  fT();
}

function holeStyle(v){
  if(v===null||v===undefined)return{bg:'transparent',col:'#ccc',fw:400,txt:'—'};
  if(v<=2)return{bg:'#65d000',col:'#fff',fw:700,txt:String(v),round:true};
  if(v===3)return{bg:'#fff',col:'#333',fw:400,txt:'3'};
  if(v===4)return{bg:'#06b6d4',col:'#fff',fw:600,txt:'4'};
  if(v===5)return{bg:'#1e3a8a',col:'#fff',fw:700,txt:'5'};
  return{bg:'#1e3a8a',col:'#fff',fw:700,txt:String(v)};
}

function totalStyle(t){
  if(t<0)return{bg:'#65d000',col:'#fff',txt:String(t)};
  if(t===0)return{bg:'#6b7280',col:'#fff',txt:'par'};
  return{bg:'#1e3a8a',col:'#fff',txt:'+'+t};
}

function fT(){
  const q=(document.getElementById('ts')||{value:''}).value.toLowerCase();
  const pf=(document.getElementById('tp')||{value:''}).value;
  const s=(document.getElementById('to')||{value:'j-desc'}).value;
  let d=[...RAW];
  if(pf)d=d.filter(r=>r.jugador===pf);
  if(q)d=d.filter(r=>r.jugador.toLowerCase().includes(q)||r.f.includes(q));
  d.sort((a,b)=>{if(s==='j-asc')return a.j-b.j||a.jugador.localeCompare(b.jugador);if(s==='j-desc')return b.j-a.j||a.jugador.localeCompare(b.jugador);if(s==='total-asc')return a.total-b.total;if(s==='total-desc')return b.total-a.total;if(s==='bir-desc')return b.bir-a.bir;return 0;});
  const cnt=document.getElementById('tc2');if(cnt)cnt.textContent=d.length+' registros';
  const tbody=document.getElementById('tb');if(!tbody)return;
  tbody.innerHTML=d.map((r,i)=>{
    const bg=i%2===0?'#fff':'#fafafa';
    const prevJ=i>0?d[i-1].j:null;
    const jBorder=prevJ!==null&&prevJ!==r.j?'border-top:2px solid #d1d5db':'';
    const holes=HM[`${r.j}_${r.jugador}`]||Array(18).fill(null);
    const ts=totalStyle(r.total);
    const fmtT=ts.txt!==undefined?ts.txt:(r.total===0?'par':r.total>0?'+'+r.total:''+r.total);
    const hCells=holes.map((h,hi)=>{
      const hs=holeStyle(h);
      const inner=hs.round
        ?`<span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:${hs.bg};color:${hs.col};font-weight:${hs.fw};font-size:11px">${hs.txt}</span>`
        :`<span style="color:${hs.bg==='#fff'||!hs.bg||hs.bg==='transparent'?hs.col:hs.col};font-weight:${hs.fw};font-size:11px;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:3px;background:${hs.bg}">${hs.txt}</span>`;
      return `<td style="text-align:center;padding:1px 0;background:#fff;border:1px solid #fff">${inner}</td>`;
    }).join('');
    return `<tr style="background:${bg};${jBorder}">
      <td style="text-align:center;color:#aaa;padding:3px 2px;font-size:11px;border:1px solid #e5e7eb">${r.j}</td>
      <td style="color:#555;padding:3px 4px;font-size:11px;border:1px solid #e5e7eb">${r.f}</td>
      <td style="background:${COLORS[r.jugador]||'#eee'};font-weight:500;color:#333;padding:3px 5px;font-size:11px;border:1px solid #e5e7eb;overflow:hidden;text-overflow:ellipsis">${r.jugador}</td>
      ${hCells}
      <td style="text-align:center;padding:2px 4px;background:${ts.bg};color:${ts.col};font-weight:700;font-size:12px;border:none;border-radius:4px">${fmtT}</td>
      <td style="text-align:center;padding:2px 1px;color:${r.bir>0?'#854d0e':'#ccc'};background:${r.bir>0?'#fef9c3':'transparent'};font-size:11px;font-weight:${r.bir>0?600:400};border:1px solid #e5e7eb">${r.bir||0}</td>
      <td style="text-align:center;padding:2px 1px;color:#555;font-size:11px;border:1px solid #e5e7eb">${r.par||0}</td>
      <td style="text-align:center;padding:2px 1px;color:${r.bog>0?'#c2410c':'#ccc'};font-size:11px;border:1px solid #e5e7eb">${r.bog||0}</td>
      <td style="text-align:center;padding:2px 1px;color:${r.dbl>0?'#991b1b':'#ccc'};background:${r.dbl>0?'rgba(220,38,38,0.1)':'transparent'};font-size:11px;font-weight:${r.dbl>0?600:400};border:1px solid #e5e7eb">${r.dbl||0}</td>
    </tr>`;
  }).join('');
}


function renderStats(el){
  let h='';
  const totalPartidos=RAW.length;
  const totalHoyos=totalPartidos*18;
  const totalBirdies=RAW.reduce((s,r)=>s+r.bir,0);
  const totalBajopar=RAW.filter(r=>r.total<0).length;
  const ratioHoyo=(totalHoyos/totalBirdies).toFixed(1);
  const pctBajo=((totalBajopar/totalPartidos)*100).toFixed(1);
  const totalJornadas=[...new Set(RAW.map(r=>r.j))].length;
  const totalHIO=0;
  h+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px">'
   +'<div style="background:#f0fdf4;border-radius:12px;padding:14px 16px;border:1px solid #bbf7d0">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Total partidos</div>'
   +'<div style="font-size:32px;font-weight:700;color:#15803d;line-height:1">'+totalPartidos+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">desde 14/01/2025</div>'
   +'</div>'
   +'<div style="background:#eff6ff;border-radius:12px;padding:14px 16px;border:1px solid #bfdbfe">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Total hoyos jugados</div>'
   +'<div style="font-size:32px;font-weight:700;color:#1d4ed8;line-height:1">'+totalHoyos.toLocaleString("es-ES")+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">18 hoyos × '+totalPartidos+' rondas</div>'
   +'</div>'
   +'<div style="background:#fefce8;border-radius:12px;padding:14px 16px;border:1px solid #fde68a">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Total birdies</div>'
   +'<div style="font-size:32px;font-weight:700;color:#854d0e;line-height:1">'+totalBirdies+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">1 birdie cada '+ratioHoyo+' hoyos</div>'
   +'</div>'
   +'<div style="background:#f0fdf4;border-radius:12px;padding:14px 16px;border:1px solid #bbf7d0">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Rondas bajo par</div>'
   +'<div style="font-size:32px;font-weight:700;color:#65d000;line-height:1">'+totalBajopar+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">'+pctBajo+'% de las rondas</div>'
   +'</div>'
   +'<div style="background:#fdf4ff;border-radius:12px;padding:14px 16px;border:1px solid #e9d5ff">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Jornadas disputadas</div>'
   +'<div style="font-size:32px;font-weight:700;color:#7c3aed;line-height:1">'+totalJornadas+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">desde 14/01/2025</div>'
   +'</div>'
   +'<div style="background:#fff7ed;border-radius:12px;padding:14px 16px;border:1px solid #fed7aa">'
   +'<div style="font-size:11px;color:#555;margin-bottom:4px">Holes in one</div>'
   +'<div style="font-size:32px;font-weight:700;color:#ea580c;line-height:1">'+totalHIO+'</div>'
   +'<div style="font-size:10px;color:#aaa;margin-top:4px">ninguno aún ⛳</div>'
   +'</div>'
   +'</div>';

  // ── Media por jugador (partidos completados) ──
  h += _renderMediaPorJugadorBlock();

  // ── Media por jornada ──
  const byJ={};RAW.forEach(r=>{if(!byJ[r.j])byJ[r.j]={j:r.j,f:r.f,scores:[]};byJ[r.j].scores.push(r.total);});
  const jornadas=Object.values(byJ).sort((a,b)=>b.j-a.j); // últimas primero
  h+=`<div style="margin-top:24px;margin-bottom:8px;font-weight:600;font-size:13px;color:#1a1a1a">Media por jornada</div>`;
  h+=`<div style="overflow-x:auto"><table style="width:100%"><thead><tr><th>J</th><th>Fecha</th><th>Jug.</th><th>Media</th><th>Mejor</th><th>Peor</th></tr></thead><tbody>`;
  jornadas.forEach((j,i)=>{
    const avg=(j.scores.reduce((s,v)=>s+v,0)/j.scores.length).toFixed(1);
    const best=Math.min(...j.scores);
    const worst=Math.max(...j.scores);
    h+=`<tr style="background:${i%2===0?'#fff':'#fafafa'}"><td style="text-align:center;font-weight:500">${j.j}</td><td style="font-size:11px;color:#666">${j.f}</td><td style="text-align:center">${j.scores.length}</td><td style="text-align:center;font-weight:500;color:${parseFloat(avg)<5?'#15803d':parseFloat(avg)<8?'#1a1a1a':'#b91c1c'}">${parseFloat(avg)>=0?'+'+avg:avg}</td><td style="text-align:center;color:#15803d">${best>=0?'+'+best:best}</td><td style="text-align:center;color:#b91c1c">+${worst}</td></tr>`;
  });
  h+=`</tbody></table></div>`;

  el.innerHTML=h;
}

// Función global para renderizar la tabla de Media por hoyo (con filtro click)
window.__renderStatsMediaHoyo = function(orderBy){
  const data = window.__statsMediaHoyoData;
  if(!data) return;
  const target = document.getElementById('tab-stats-mediahoyo');
  if(!target) return;

  const colorCell = (m) => {
    if(m === null || m === undefined) return { bg:'#f9fafb', col:'#bbb' };
    if(m < 2.7)      return { bg:'#dcfce7', col:'#15803d' };
    if(m < 3.0)      return { bg:'#f0fdf4', col:'#166534' };
    if(m < 3.3)      return { bg:'#ffffff', col:'#1a1a1a' };
    if(m < 3.7)      return { bg:'#fff7ed', col:'#c2410c' };
    if(m < 4.3)      return { bg:'#ffedd5', col:'#9a3412' };
    return                  { bg:'#fee2e2', col:'#991b1b' };
  };

  let filas = [...data.filas];
  if(orderBy === -1 || orderBy === undefined){
    filas.sort((a,b) => a.mediaTotal - b.mediaTotal);
    orderBy = -1;
  } else {
    filas.sort((a,b) => {
      const va = a.mediasPorHoyo[orderBy];
      const vb = b.mediasPorHoyo[orderBy];
      if(va === null && vb === null) return 0;
      if(va === null) return 1;
      if(vb === null) return -1;
      return va - vb;
    });
  }

  let html = '<div style="overflow-x:auto;border:1px solid #e5e7eb;border-radius:8px">' +
    '<table style="width:100%;border-collapse:collapse;font-size:11px;min-width:720px">' +
    '<thead><tr style="background:#f3f4f6;border-bottom:1px solid #e5e7eb">' +
    '<th onclick="window.__renderStatsMediaHoyo(-1)" style="text-align:left;padding:6px 10px;font-weight:600;color:#374151;position:sticky;left:0;background:#f3f4f6;z-index:1;cursor:pointer;user-select:none" title="Ordenar por media total">Jugador'+(orderBy===-1?' ▼':'')+'</th>';
  for(let i = 0; i < 18; i++){
    const activo = i === orderBy;
    const bg = activo ? '#dcfce7' : '#f3f4f6';
    const col = activo ? '#15803d' : '#374151';
    html += '<th onclick="window.__renderStatsMediaHoyo('+i+')" style="text-align:center;padding:6px 2px;font-weight:600;color:'+col+';width:36px;cursor:pointer;user-select:none;background:'+bg+'" title="Ordenar por hoyo '+(i+1)+'">'+(i+1)+(activo?' ▼':'')+
      (data.metros ? '<div style="font-size:9px;font-weight:400;color:#888;margin-top:2px">'+data.metros[i]+'m</div>' : '')+
      '</th>';
  }
  html += '<th style="text-align:center;padding:6px 8px;font-weight:600;color:#15803d;border-left:1px solid #e5e7eb">Media</th>' +
    '<th style="text-align:center;padding:6px 6px;font-weight:600;color:#888;width:30px">n</th>' +
    '</tr></thead><tbody>';
  filas.forEach((f, i) => {
    const nombreStyle = 'color:#1a1a1a';
    const rowBg = i%2===0 ? '#fff' : '#fafafa';
    html += '<tr style="background:'+rowBg+';border-bottom:1px solid #f0f0f0">' +
      '<td style="padding:5px 10px;position:sticky;left:0;background:'+rowBg+';z-index:1;border-right:1px solid #e5e7eb">' +
      '<span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:'+f.color+';margin-right:6px;vertical-align:middle"></span>' +
      '<span style="font-weight:500;'+nombreStyle+'">'+f.jugador+'</span></td>';
    f.mediasPorHoyo.forEach((m, hi) => {
      const c = colorCell(m);
      const txt = m === null ? '—' : m.toFixed(1);
      const highlight = hi === orderBy ? 'box-shadow:inset 0 0 0 1.5px #15803d;' : '';
      html += '<td style="text-align:center;padding:4px 0;background:'+c.bg+';color:'+c.col+';font-weight:500;'+highlight+'">'+txt+'</td>';
    });
    const mediaTotalStr = f.mediaTotal !== null && f.mediaTotal < 99 ? f.mediaTotal.toFixed(2) : '—';
    const cT = colorCell(f.mediaTotal);
    html += '<td style="text-align:center;padding:4px 6px;background:'+cT.bg+';color:'+cT.col+';font-weight:600;border-left:1px solid #e5e7eb">'+mediaTotalStr+'</td>' +
      '<td style="text-align:center;padding:4px 4px;color:#888;font-size:10px">'+f.n+'</td></tr>';
  });
  // Fila equipo
  html += '<tr style="background:#f0fdf4;border-top:2px solid #15803d;font-weight:600">' +
    '<td style="padding:5px 10px;position:sticky;left:0;background:#f0fdf4;z-index:1;border-right:1px solid #e5e7eb;color:#15803d">Equipo (media)</td>';
  data.equipo.forEach((m, hi) => {
    const c = colorCell(m);
    const txt = m === null ? '—' : m.toFixed(1);
    const highlight = hi === orderBy ? 'box-shadow:inset 0 0 0 1.5px #15803d;' : '';
    html += '<td style="text-align:center;padding:4px 0;background:'+c.bg+';color:'+c.col+';font-weight:600;'+highlight+'">'+txt+'</td>';
  });
  const totE = data.equipo.filter(m=>m!==null);
  const totEq = totE.length>0 ? (totE.reduce((s,v)=>s+v,0)/totE.length) : null;
  const totEqStr = totEq !== null ? totEq.toFixed(2) : '—';
  const cTE = colorCell(totEq);
  html += '<td style="text-align:center;padding:4px 6px;background:'+cTE.bg+';color:'+cTE.col+';font-weight:700;border-left:1px solid #e5e7eb">'+totEqStr+'</td>' +
    '<td style="text-align:center;padding:4px 4px;color:#888;font-size:10px">—</td></tr>';
  html += '</tbody></table></div>';
  target.innerHTML = html;
};


function _campoCalcJugadores(holeIdx){
  // Serie cronológica de scores por jugador en este hoyo
  const series={};
  Object.keys(HM).sort((a,b)=>parseInt(a.split('_')[0])-parseInt(b.split('_')[0])).forEach(key=>{
    const [jStr,jugador]=key.split('_');
    const r=RAW.find(x=>x.j===parseInt(jStr)&&x.jugador===jugador);
    if(!r)return;
    const v=HM[key][holeIdx];
    if(v===null||v===undefined)return;
    if(!series[jugador])series[jugador]=[];
    series[jugador].push({j:parseInt(jStr),score:v});
  });
  // Para cada jugador: mejor ventana de 10 con su composición (birdies, pares, bogeys, dobles+)
  const result=[];
  PLAYERS.forEach(jugador=>{
    const serie=series[jugador]||[];
    const totalVueltas=serie.length;
    if(serie.length<10){
      result.push({jugador,vueltas:totalVueltas,elegible:false});
      return;
    }
    // Buscar ventana de 10 con mejor avg
    let mejorAvg=Infinity,mejorIni=0,mejorFin=0,mejorVentana=null;
    for(let i=0;i<=serie.length-10;i++){
      const ventana=serie.slice(i,i+10);
      const sum=ventana.reduce((s,x)=>s+x.score,0);
      const avg=sum/10;
      if(avg<mejorAvg){
        mejorAvg=avg;
        mejorIni=ventana[0].j;
        mejorFin=ventana[9].j;
        mejorVentana=ventana;
      }
    }
    // Contar composición DENTRO de esa ventana
    let hio=0,birdie=0,par=0,bogey=0,doble=0,triple=0;
    mejorVentana.forEach(({score:v})=>{
      if(v<=1)hio++;
      else if(v===2)birdie++;
      else if(v===3)par++;
      else if(v===4)bogey++;
      else if(v===5)doble++;
      else triple++;
    });
    result.push({
      jugador,vueltas:totalVueltas,elegible:true,
      avg:mejorAvg,sum:mejorAvg*10,iniJ:mejorIni,finJ:mejorFin,
      hio,birdie,par,bogey,doble,triple
    });
  });
  return result;
}

function _campoRenderJugadores(holeIdx){
  const all=_campoCalcJugadores(holeIdx);
  const data=all.filter(s=>s.elegible).sort((a,b)=>a.avg-b.avg);
  const noElegibles=all.filter(s=>!s.elegible).sort((a,b)=>b.vueltas-a.vueltas);

  const medals=['🥇','🥈','🥉'];
  let s=`<table style="width:100%;border-collapse:collapse;font-size:11px">
    <thead>
      <tr style="background:#f9fafb">
        <th style="text-align:center;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:32px">Pos</th>
        <th style="text-align:left;padding:5px 8px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0">Jugador</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:50px">Avg10</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:50px">HiO</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:60px">Bir</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:50px">Par</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:50px">Bog</th>
        <th style="text-align:right;padding:5px 6px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:60px">Bog+</th>
        <th style="text-align:left;padding:5px 8px;font-weight:600;color:#666;border-bottom:1px solid #f0f0f0;width:90px">Ventana</th>
      </tr>
    </thead>
    <tbody>`;

  data.forEach((p,i)=>{
    const bir=p.birdie+p.hio;
    const bogMas=p.bogey+p.doble+p.triple;
    const isMedal=i<3;
    const posCell=isMedal?medals[i]:`${i+1}º`;
    const rowBg=i%2===0?'#fff':'#fafafa';
    const dotColor=COLORS[p.jugador]||'#eee';
    s+=`<tr style="background:${rowBg}">
      <td style="text-align:center;padding:5px 6px;font-size:${isMedal?'14px':'11px'};border-bottom:1px solid #fafafa;color:#666">${posCell}</td>
      <td style="padding:5px 8px;border-bottom:1px solid #fafafa">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};margin-right:6px;vertical-align:middle"></span>
        <span style="font-weight:${isMedal?700:500};color:#333">${p.jugador}</span>
      </td>
      <td style="text-align:right;padding:5px 6px;font-weight:${isMedal?700:500};color:#333;border-bottom:1px solid #fafafa">${p.avg.toFixed(2)}</td>
      <td style="text-align:right;padding:5px 6px;color:${p.hio>0?'#9d174d':'#bbb'};font-weight:${p.hio>0?600:400};border-bottom:1px solid #fafafa">${p.hio||'—'}</td>
      <td style="text-align:right;padding:5px 6px;color:${bir>0?'#854d0e':'#bbb'};border-bottom:1px solid #fafafa">${bir||'—'}</td>
      <td style="text-align:right;padding:5px 6px;color:${p.par>0?'#15803d':'#bbb'};border-bottom:1px solid #fafafa">${p.par||'—'}</td>
      <td style="text-align:right;padding:5px 6px;color:${p.bogey>0?'#c2410c':'#bbb'};border-bottom:1px solid #fafafa">${p.bogey||'—'}</td>
      <td style="text-align:right;padding:5px 6px;color:${bogMas>0?'#991b1b':'#bbb'};font-weight:${isMedal?600:400};border-bottom:1px solid #fafafa">${bogMas||'—'}</td>
      <td style="padding:5px 8px;color:#888;border-bottom:1px solid #fafafa;font-size:10.5px">J${p.iniJ}→J${p.finJ}</td>
    </tr>`;
  });

  // No elegibles (jugadores con <10 vueltas en este hoyo) atenuados al final
  noElegibles.forEach((p,iAbs)=>{
    const i=data.length+iAbs;
    const dotColor=COLORS[p.jugador]||'#eee';
    s+=`<tr style="background:${i%2===0?'#fff':'#fafafa'};opacity:0.55">
      <td style="text-align:center;padding:5px 6px;font-size:11px;border-bottom:1px solid #fafafa;color:#bbb">—</td>
      <td style="padding:5px 8px;border-bottom:1px solid #fafafa">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};margin-right:6px;vertical-align:middle"></span>
        <span style="font-weight:500;color:#666">${p.jugador}</span>
      </td>
      <td colspan="7" style="padding:5px 8px;color:#bbb;border-bottom:1px solid #fafafa;font-size:10.5px;font-style:italic">faltan ${10-p.vueltas} vueltas para clasificar (n=${p.vueltas})</td>
    </tr>`;
  });

  s+=`</tbody></table>`;
  return s;
}

// Serie cronológica de scores de un jugador en un hoyo
function _campoSerieHoyo(holeIdx){
  const series={};
  Object.keys(HM).sort((a,b)=>parseInt(a.split('_')[0])-parseInt(b.split('_')[0])).forEach(key=>{
    const [jStr,jugador]=key.split('_');
    const r=RAW.find(x=>x.j===parseInt(jStr)&&x.jugador===jugador);
    if(!r)return;
    const v=HM[key][holeIdx];
    if(v===null||v===undefined)return;
    if(!series[jugador])series[jugador]=[];
    series[jugador].push({j:parseInt(jStr),score:v});
  });
  return series;
}

// Serie cronológica de SUMA de scores en un tramo de N hoyos por jornada
function _campoSerieTramo(holeIdxs){
  const series={};
  Object.keys(HM).sort((a,b)=>parseInt(a.split('_')[0])-parseInt(b.split('_')[0])).forEach(key=>{
    const [jStr,jugador]=key.split('_');
    const r=RAW.find(x=>x.j===parseInt(jStr)&&x.jugador===jugador);
    if(!r)return;
    const scores=HM[key];
    if(holeIdxs.some(idx=>scores[idx]===null||scores[idx]===undefined))return;
    const suma=holeIdxs.reduce((s,idx)=>s+scores[idx],0);
    if(!series[jugador])series[jugador]=[];
    series[jugador].push({j:parseInt(jStr),score:suma});
  });
  return series;
}

// Mejor ventana móvil de N consecutivas (devuelve {avg,ini,fin} o null)
function _campoMejorVentana(serie,N){
  if(serie.length<N)return null;
  let mejor=Infinity,ini=0,fin=0;
  for(let i=0;i<=serie.length-N;i++){
    const sum=serie.slice(i,i+N).reduce((s,x)=>s+x.score,0);
    const avg=sum/N;
    if(avg<mejor){mejor=avg;ini=serie[i].j;fin=serie[i+N-1].j;}
  }
  return{avg:mejor,ini,fin};
}

// Clasificación por mejor media de N (devuelve array ordenado asc)
function _campoClasificacionMejorN(serieMap,N){

  const result=[];
  PLAYERS.forEach(jug=>{
    const serie=serieMap[jug]||[];
    const mejor=_campoMejorVentana(serie,N);
    if(mejor){
      result.push({jugador:jug,n:serie.length,avg:mejor.avg,ini:mejor.ini,fin:mejor.fin,elegible:true});
    }else{
      result.push({jugador:jug,n:serie.length,avg:null,ini:null,fin:null,elegible:false});
    }
  });
  // Elegibles primero ordenados por avg, no elegibles al final ordenados por nº de vueltas desc
  result.sort((a,b)=>{
    if(a.elegible&&!b.elegible)return -1;
    if(!a.elegible&&b.elegible)return 1;
    if(a.elegible)return a.avg-b.avg;
    return b.n-a.n;
  });
  return result;
}

// Misma clasificación pero solo con datos hasta jornada hastaJ (para detectar movimientos)
function _campoClasificacionMejorNHastaJ(serieMap,N,hastaJ){

  const result=[];
  PLAYERS.forEach(jug=>{
    const serie=(serieMap[jug]||[]).filter(s=>s.j<=hastaJ);
    const mejor=_campoMejorVentana(serie,N);
    if(mejor){
      result.push({jugador:jug,n:serie.length,avg:mejor.avg,ini:mejor.ini,fin:mejor.fin,elegible:true});
    }else{
      result.push({jugador:jug,n:serie.length,avg:null,ini:null,fin:null,elegible:false});
    }
  });
  result.sort((a,b)=>{
    if(a.elegible&&!b.elegible)return -1;
    if(!a.elegible&&b.elegible)return 1;
    if(a.elegible)return a.avg-b.avg;
    return b.n-a.n;
  });
  return result;
}

// Render de una sección destacada con su clasificación
function _campoSeccionDestacada(opts){
  const{titulo,emoji,colorBg,colorBorder,colorTitle,labelHoyo,subtitulo,clasificacion,parRef}=opts;
  let h=`<details class="collapsible-section" style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;margin-bottom:12px">
    <summary style="background:${colorBg};border-bottom:1px solid ${colorBorder};padding:10px 38px 10px 14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div>
        <span style="font-size:11px;font-weight:700;color:${colorTitle};text-transform:uppercase;letter-spacing:0.5px">${emoji} ${titulo}</span>
        <span style="font-size:15px;font-weight:700;color:#1a1a1a;margin-left:10px">${labelHoyo}</span>
      </div>
      <div style="font-size:11px;color:${colorTitle};font-weight:500">${subtitulo}</div>
    </summary>
    <div style="padding:8px 14px;font-size:10px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:0.4px;background:#fafafa;border-bottom:1px solid #f0f0f0">Clasificación · mejor media móvil de 10 · par del tramo: ${parRef}</div>`;
  const elegibles=clasificacion.filter(p=>p.elegible);
  const noElegibles=clasificacion.filter(p=>!p.elegible);
  const medals=['🥇','🥈','🥉'];
  h+=`<table style="width:100%;border-collapse:collapse;font-size:11px"><tbody>`;
  // Elegibles
  elegibles.forEach((p,i)=>{
    const isMedal=i<3;
    const pos=isMedal?medals[i]:`${i+1}º`;
    const dotColor=COLORS[p.jugador]||'#eee';
    const vsPar=p.avg-parRef;
    const vsParCol=vsPar<=0?'#15803d':vsPar<=0.3?'#854d0e':vsPar<=0.6?'#c2410c':'#991b1b';
    h+=`<tr style="background:${i%2===0?'#fff':'#fafafa'}">
      <td style="text-align:center;padding:6px;font-size:${isMedal?'14px':'11px'};border-bottom:1px solid #fafafa;color:#666;width:34px">${pos}</td>
      <td style="padding:6px 8px;border-bottom:1px solid #fafafa">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};margin-right:6px;vertical-align:middle"></span>
        <span style="font-weight:${isMedal?700:500};color:#333">${p.jugador}</span>
      </td>
      <td style="text-align:right;padding:6px;font-weight:${isMedal?700:500};color:#333;border-bottom:1px solid #fafafa;width:60px">${p.avg.toFixed(3)}</td>
      <td style="text-align:right;padding:6px;color:${vsParCol};font-weight:600;border-bottom:1px solid #fafafa;width:60px;font-size:10.5px">${vsPar>=0?'+':''}${vsPar.toFixed(2)}</td>
      <td style="padding:6px 8px;color:#666;border-bottom:1px solid #fafafa;font-size:10.5px">J${p.ini} → J${p.fin}</td>
      <td style="text-align:right;padding:6px;color:#aaa;border-bottom:1px solid #fafafa;width:50px;font-size:10.5px">n=${p.n}</td>
    </tr>`;
  });
  // No elegibles (n<10) con fila atenuada
  noElegibles.forEach((p,iAbs)=>{
    const i=elegibles.length+iAbs;
    const dotColor=COLORS[p.jugador]||'#eee';
    h+=`<tr style="background:${i%2===0?'#fff':'#fafafa'};opacity:0.55">
      <td style="text-align:center;padding:6px;font-size:11px;border-bottom:1px solid #fafafa;color:#bbb;width:34px">—</td>
      <td style="padding:6px 8px;border-bottom:1px solid #fafafa">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};margin-right:6px;vertical-align:middle"></span>
        <span style="font-weight:500;color:#666">${p.jugador}</span>
      </td>
      <td style="text-align:right;padding:6px;color:#bbb;border-bottom:1px solid #fafafa;width:60px">—</td>
      <td style="text-align:right;padding:6px;color:#bbb;border-bottom:1px solid #fafafa;width:60px;font-size:10.5px">—</td>
      <td colspan="2" style="padding:6px 8px;color:#bbb;border-bottom:1px solid #fafafa;font-size:10.5px;font-style:italic">faltan ${10-p.n} jornadas para clasificar (n=${p.n})</td>
    </tr>`;
  });
  h+=`</tbody></table>`;
  // Récord de partido individual en este tramo (debajo de la lista)
  if(opts.idxs){
    h+=_campoRenderRecordPartido(opts.idxs,opts.colorTitle);
  }
  h+=`</details>`;
  return h;
}

// Devuelve los partidos con mejor suma en un tramo (puede haber empates)
function _campoMejorPartidoTramo(idxs){
  const partidas=[];
  Object.entries(HM).forEach(([key,scores])=>{
    const [jStr,jugador]=key.split('_');
    const j=parseInt(jStr);
    const r=RAW.find(x=>x.j===j&&x.jugador===jugador);
    if(!r)return;
    if(idxs.some(i=>scores[i]===null||scores[i]===undefined))return;
    const suma=idxs.reduce((s,i)=>s+scores[i],0);
    partidas.push({jugador,j,f:r.f,suma,split:idxs.map(i=>scores[i])});
  });
  if(partidas.length===0)return null;
  partidas.sort((a,b)=>a.suma-b.suma||a.j-b.j);
  const mejorSuma=partidas[0].suma;
  return{
    suma:mejorSuma,
    empatados:partidas.filter(p=>p.suma===mejorSuma)
  };
}

// Render del bloque "récord de partido" para un tramo
function _campoRenderRecordPartido(idxs,colorTitle){
  const rec=_campoMejorPartidoTramo(idxs);
  if(!rec)return '';
  const parRef=idxs.length*3;
  const vsPar=rec.suma-parRef;
  const vsParStr=vsPar<0?`<span style="color:#15803d;font-weight:600">${vsPar}</span>`:vsPar===0?`<span style="color:#666;font-weight:600">par</span>`:`<span style="color:#854d0e;font-weight:600">+${vsPar}</span>`;
  let h=`<div style="background:#fafafa;border-top:1px solid #f0f0f0;padding:8px 14px">
    <div style="font-size:10px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:6px">🏆 Récord de partido <span style="color:#aaa;font-weight:500;text-transform:none;letter-spacing:0;margin-left:6px">par del tramo: ${parRef}</span></div>`;
  rec.empatados.forEach(p=>{
    const dot=COLORS[p.jugador]||'#eee';
    h+=`<div style="display:flex;align-items:center;gap:8px;padding:3px 0;font-size:11px">
      <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dot}"></span>
      <span style="font-weight:600;color:#333;min-width:80px">${p.jugador}</span>
      <span style="font-weight:700;color:${colorTitle};font-size:13px">${p.suma}</span>
      <span style="font-size:10.5px">${vsParStr}</span>
      <span style="color:#888;font-size:10.5px">[${p.split.join('-')}]</span>
      <span style="color:#aaa;font-size:10.5px">J${p.j}${p.f?' · '+p.f:''}</span>
    </div>`;
  });
  h+=`</div>`;
  return h;
}


// ── Cálculo común de stats por hoyo (compartido por Campo y Radiografía) ──
function _campoCalcStats(){
  const PAR=3;
  const holes=Array.from({length:18},(_,i)=>({
    idx:i,hoyo:i+1,total:0,sum:0,
    eagle:0,birdie:0,par:0,bogey:0,doble:0,triple:0
  }));
  Object.entries(HM).forEach(([key,scores])=>{
    const [jStr,jugador]=key.split('_');
    const rawEntry=RAW.find(r=>r.j===parseInt(jStr)&&r.jugador===jugador);
    if(!rawEntry)return;
    scores.forEach((v,i)=>{
      if(v===null||v===undefined||i>=18)return;
      const h=holes[i];
      h.total++;h.sum+=v;
      if(v<=1)h.eagle++;
      else if(v===2)h.birdie++;
      else if(v===3)h.par++;
      else if(v===4)h.bogey++;
      else if(v===5)h.doble++;
      else h.triple++;
    });
  });
  const totalRondas=holes.reduce((s,h)=>s+h.total,0);
  const campoAvg=holes.reduce((s,h)=>s+h.sum,0)/totalRondas;
  const campoBirPct=holes.reduce((s,h)=>s+h.eagle+h.birdie,0)/totalRondas*100;
  const campoBogPct=holes.reduce((s,h)=>s+h.bogey,0)/totalRondas*100;
  const campoDblPct=holes.reduce((s,h)=>s+h.doble+h.triple,0)/totalRondas*100;
  const rankAvg=[...holes].sort((a,b)=>(b.sum/b.total)-(a.sum/a.total)).map(h=>h.idx);
  const rankBirAsc=[...holes].sort((a,b)=>(a.birdie+a.eagle)-(b.birdie+b.eagle)).map(h=>h.idx);
  const rankBogDesc=[...holes].sort((a,b)=>b.bogey-a.bogey).map(h=>h.idx);
  const rankDblDesc=[...holes].sort((a,b)=>(b.doble+b.triple)-(a.doble+a.triple)).map(h=>h.idx);
  const tramos=[];
  for(let i=0;i<=15;i++){
    const a=holes[i],b=holes[i+1],c=holes[i+2];
    const tot=a.total+b.total+c.total;
    const bir=a.eagle+a.birdie+b.eagle+b.birdie+c.eagle+c.birdie;
    const dbl=a.doble+a.triple+b.doble+b.triple+c.doble+c.triple;
    const avg=(a.sum+b.sum+c.sum)/tot;
    tramos.push({label:`H${i+1}-H${i+2}-H${i+3}`,start:i,avg,diff:(dbl-bir)/tot*100,bir,dbl,tot});
  }
  const amenCorner=[...tramos].sort((a,b)=>b.diff-a.diff)[0];
  const tramoAmable=[...tramos].sort((a,b)=>a.avg-b.avg)[0];
  const peorHoyo=[...holes].sort((a,b)=>(b.sum/b.total)-(a.sum/a.total))[0];
  const mejorHoyo=[...holes].sort((a,b)=>(a.sum/a.total)-(b.sum/b.total))[0];
  return{PAR,holes,totalRondas,campoAvg,campoBirPct,campoBogPct,campoDblPct,
    rankAvg,rankBirAsc,rankBogDesc,rankDblDesc,
    tramos,amenCorner,tramoAmable,peorHoyo,mejorHoyo};
}

// ── Pestaña CAMPO: 4 secciones destacadas ──
// Bloque reutilizable: tabla "Media por jugador (partidos completados)"
// Devuelve el HTML para usarlo desde la pestaña Hoyos. Toda la lógica de cálculo
// vive aquí; renderStats ya no lo emite (se movió a Hoyos por orden funcional).
function _renderMediaPorJugadorBlock(){
  const sd={};
  PLAYERS.forEach(p=>{
    const g=RAW.filter(r=>r.jugador===p);
    if(!g.length)return;
    sd[p]={
      n:g.length,
      avgTotal:(g.reduce((s,r)=>s+r.total,0)/g.length).toFixed(1),
      avgBir:(g.reduce((s,r)=>s+r.bir,0)/g.length).toFixed(1),
      avgPar:(g.reduce((s,r)=>s+r.par,0)/g.length).toFixed(1),
      avgBog:(g.reduce((s,r)=>s+r.bog,0)/g.length).toFixed(1),
      avgDbl:(g.reduce((s,r)=>s+r.dbl,0)/g.length).toFixed(1),
      best:Math.min(...g.map(r=>r.total)),
      worst:Math.max(...g.map(r=>r.total)),
      totalBir:g.reduce((s,r)=>s+r.bir,0)
    };
  });
  const sorted=[...PLAYERS].filter(p=>sd[p]).sort((a,b)=>parseFloat(sd[a].avgTotal)-parseFloat(sd[b].avgTotal));
  let h=`<div style="font-weight:500;margin-bottom:8px;color:#555;font-size:12px">Media por jugador (partidos completados)</div><div style="overflow-x:auto"><table style="width:100%"><thead><tr><th style="text-align:left">Jugador</th><th>Part.</th><th>Media</th><th>Mejor</th><th>Peor</th><th>🐦med</th><th>🐦tot</th><th>✅med</th><th>❌med</th><th>❌❌med</th></tr></thead><tbody>`;
  sorted.forEach((p,i)=>{
    const d=sd[p];
    const mc=parseFloat(d.avgTotal)<4?'#15803d':parseFloat(d.avgTotal)<7?'#1a1a1a':'#b91c1c';
    h+=`<tr style="background:${i%2===0?'#fff':'#fafafa'}"><td style="background:${COLORS[p]||'#eee'};font-weight:500;color:#333">${p}</td><td style="text-align:center">${d.n}</td><td style="text-align:center;font-weight:500;color:${mc}">${parseFloat(d.avgTotal)>=0?'+'+d.avgTotal:d.avgTotal}</td><td style="text-align:center;color:#15803d">${d.best>=0?'+'+d.best:d.best}</td><td style="text-align:center;color:#b91c1c">+${d.worst}</td><td style="text-align:center;color:#854d0e">${d.avgBir}</td><td style="text-align:center;font-weight:500;color:#854d0e">${d.totalBir}</td><td style="text-align:center">${d.avgPar}</td><td style="text-align:center;color:#c2410c">${d.avgBog}</td><td style="text-align:center;color:#991b1b">${d.avgDbl}</td></tr>`;
  });
  h+=`</tbody></table></div>`;
  return h;
}

// Bloque reutilizable: tabla "Media por hoyo (todas las jornadas, ROC 3)"
// Cálculo + título + descripción + placeholder div para la tabla interactiva.
// Side effect: guarda los datos en window.__statsMediaHoyoData para que
// la función global window.__renderStatsMediaHoyo pueda montar la tabla
// (con click en cabecera de hoyo para reordenar) tras el innerHTML.
// Movido desde Stats a Hoyos por coherencia funcional.
function _renderMediaPorHoyoBlock(){
  // Recolectar jornadas válidas por jugador
  const HM_KEYS = Object.keys(HM).sort((a,b) => parseInt(a.split('_')[0]) - parseInt(b.split('_')[0]));
  const jornadasPorJugador = {};
  PLAYERS.forEach(p => jornadasPorJugador[p] = []);
  HM_KEYS.forEach(key => {
    const [jStr, jug] = key.split('_');
    if(!PLAYERS.includes(jug)) return;
    const r = RAW.find(x => x.j === parseInt(jStr) && x.jugador === jug);
    if(!r) return;
    jornadasPorJugador[jug].push({ j: parseInt(jStr), hoyos: HM[key] });
  });

  // Construir filas: jugador → array de 18 medias (o null)
  // FILTRO: solo jugadores con ≥10 jornadas
  const filasJugador = PLAYERS.map(jug => {
    const todasJornadas = jornadasPorJugador[jug];
    const n = todasJornadas.length;
    const mediasPorHoyo = [];
    for(let h = 0; h < 18; h++){
      const valores = todasJornadas
        .map(jr => jr.hoyos[h])
        .filter(v => v !== null && v !== undefined);
      if(valores.length === 0){
        mediasPorHoyo.push(null);
      } else {
        const media = valores.reduce((s,v)=>s+v, 0) / valores.length;
        mediasPorHoyo.push(media);
      }
    }
    const todasValores = mediasPorHoyo.filter(m => m !== null);
    const mediaTotal = todasValores.length > 0
      ? todasValores.reduce((s,v)=>s+v, 0) / todasValores.length
      : 99;
    return { jugador: jug, n, mediasPorHoyo, mediaTotal };
  }).filter(f => f.n >= 10);

  // Media por hoyo del equipo (solo con los que pasan el filtro)
  const mediaEquipoPorHoyo = [];
  for(let h = 0; h < 18; h++){
    const valores = filasJugador
      .map(f => f.mediasPorHoyo[h])
      .filter(v => v !== null);
    mediaEquipoPorHoyo.push(valores.length > 0
      ? valores.reduce((s,v)=>s+v, 0) / valores.length
      : null);
  }

  // Buscar metros de ROC 3 en CAMPOS
  const roc3 = (typeof CAMPOS !== 'undefined') ? CAMPOS.find(c => c.nombre === 'Roc 3 Pitch & Putt') : null;
  const metrosRoc3 = (roc3 && Array.isArray(roc3.metros) && roc3.metros.length === 18) ? roc3.metros : null;

  // Pasar datos al cliente para el filtrado interactivo
  window.__statsMediaHoyoData = {
    filas: filasJugador.map(f => ({
      jugador: f.jugador,
      n: f.n,
      mediasPorHoyo: f.mediasPorHoyo,
      mediaTotal: f.mediaTotal,
      color: COLORS[f.jugador] || '#eee'
    })),
    equipo: mediaEquipoPorHoyo,
    metros: metrosRoc3
  };

  let h = '';
  h += `<div style="margin-top:24px;margin-bottom:8px;font-weight:600;font-size:13px;color:#1a1a1a">Media por hoyo (todas las jornadas, ROC 3)</div>`;
  h += `<div style="font-size:11px;color:#888;margin-bottom:8px">Cada celda: media de golpes del jugador en ese hoyo en todas sus partidas. Verde = birdie, blanco = par, naranja = bogey, rojo = doble+. Solo aparecen jugadores con <b>≥10 jornadas</b>. <b>Click en un hoyo</b> para ordenar la tabla por ese hoyo.</div>`;
  h += `<div id="tab-stats-mediahoyo"></div>`;
  return h;
}

function _renderTramosBlock(){
  const S=_campoCalcStats();

  // Helper: calcular avg de un tramo desde S.holes
  const avgTramo=idxs=>{
    const sum=idxs.reduce((s,i)=>s+S.holes[i].sum,0);
    const tot=idxs.reduce((s,i)=>s+S.holes[i].total,0);
    return sum/tot;
  };

  // Helper: diferencia % dobles - % birdies para un tramo
  const diffDblBir=idxs=>{
    const tot=idxs.reduce((s,i)=>s+S.holes[i].total,0);
    const bir=idxs.reduce((s,i)=>s+S.holes[i].eagle+S.holes[i].birdie,0);
    const dbl=idxs.reduce((s,i)=>s+S.holes[i].doble+S.holes[i].triple,0);
    return (dbl-bir)/tot*100;
  };

  // Helper: render compacto de una sección destacada para un tramo
  const seccionTramo=opts=>_campoSeccionDestacada({
    titulo:opts.titulo,emoji:opts.emoji,
    colorBg:opts.colorBg,colorBorder:opts.colorBorder,colorTitle:opts.colorTitle,
    labelHoyo:opts.label,
    subtitulo:opts.subtitulo,
    clasificacion:_campoClasificacionMejorN(_campoSerieTramo(opts.idxs),10),
    parRef:opts.idxs.length*3,
    idxs:opts.idxs
  });

  let h='';

  // 1) Amen Corner — fijo H7-H8-H9 (los tres del cierre de ida)
  const amen=TRAMOS_FIJOS.amenCorner;
  h+=seccionTramo({
    titulo:'Amen Corner',emoji:'🙏',
    colorBg:'#fef3c7',colorBorder:'#fcd34d',colorTitle:'#92400e',
    label:amen.label,
    subtitulo:`avg tramo ${avgTramo(amen.idxs).toFixed(3)} · dobles vs birdies +${diffDblBir(amen.idxs).toFixed(1)}%`,
    idxs:amen.idxs
  });

  // 2) Camino de rosas — fijo H3-H4-H5 (el oasis del inicio)
  const rosas=TRAMOS_FIJOS.caminoRosas;
  h+=seccionTramo({
    titulo:'Camino de rosas',emoji:'🌹',
    colorBg:'#fce7f3',colorBorder:'#fbcfe8',colorTitle:'#9d174d',
    label:rosas.label,
    subtitulo:`avg tramo ${avgTramo(rosas.idxs).toFixed(3)} · los 3 hoyos más amables`,
    idxs:rosas.idxs
  });

  // 3) Arranque — primeros 3 hoyos
  const arranque=TRAMOS_FIJOS.arranque;
  h+=seccionTramo({
    titulo:'Arranque',emoji:'🚀',
    colorBg:'#dbeafe',colorBorder:'#bfdbfe',colorTitle:'#1e40af',
    label:arranque.label,
    subtitulo:`avg tramo ${avgTramo(arranque.idxs).toFixed(3)} · primeros 3 hoyos`,
    idxs:arranque.idxs
  });

  // 4) Sprint final — últimos 3 hoyos
  const sprint=TRAMOS_FIJOS.sprintFinal;
  h+=seccionTramo({
    titulo:'Sprint final',emoji:'🏁',
    colorBg:'#f3e8ff',colorBorder:'#e9d5ff',colorTitle:'#6b21a8',
    label:sprint.label,
    subtitulo:`avg tramo ${avgTramo(sprint.idxs).toFixed(3)} · últimos 3 hoyos`,
    idxs:sprint.idxs
  });

  // 5) Ida — los 9 primeros hoyos (front 9)
  const front=TRAMOS_FIJOS.front;
  h+=seccionTramo({
    titulo:'Ida',emoji:'🌅',
    colorBg:'#dcfce7',colorBorder:'#bbf7d0',colorTitle:'#15803d',
    label:front.label,
    subtitulo:`avg tramo ${avgTramo(front.idxs).toFixed(3)} · primera vuelta · par 27`,
    idxs:front.idxs
  });

  // 6) Vuelta — los 9 segundos hoyos (back 9)
  const back=TRAMOS_FIJOS.back;
  h+=seccionTramo({
    titulo:'Vuelta',emoji:'🌇',
    colorBg:'#cffafe',colorBorder:'#a5f3fc',colorTitle:'#0e7490',
    label:back.label,
    subtitulo:`avg tramo ${avgTramo(back.idxs).toFixed(3)} · segunda vuelta · par 27`,
    idxs:back.idxs
  });

  return h;
}

// ── Pestaña RADIOGRAFÍA: hoyo por hoyo con filtros ──

// Apodos con sabor basados en el carácter actual de cada hoyo
const HOYO_APODOS={
  1:{nombre:'El despertar brusco',desc:'Sin café, no entras. El más difícil de salida'},
  2:{nombre:'El segundo aviso',desc:'Si fallas el 1, el 2 te recuerda dónde estás'},
  3:{nombre:'El honesto',desc:'86% de pares — ni regalo ni castigo'},
  4:{nombre:'El indulto',desc:'Solo 3.9% de dobles — el más perdonador del campo'},
  5:{nombre:'La rampa',desc:'Aquí ya empieza a soltar birdies'},
  6:{nombre:'El equilibrista',desc:'Reparto justo entre par y bogey'},
  7:{nombre:'Antesala del calvario',desc:'El primer aviso del Amen Corner'},
  8:{nombre:'La trampa de los dobles',desc:'17.8% de dobles — el segundo del campo'},
  9:{nombre:'El más cabrón',desc:'Solo 6 birdies en 259 rondas. Aquí no se baja par'},
  10:{nombre:'El regalo',desc:'Magnolia Lane del ROC — 18.5% de birdies, el más bondadoso'},
  11:{nombre:'El verdugo silencioso',desc:'El hoyo del bogey: 35.9%. Sangra sin avisar'},
  12:{nombre:'El respiro',desc:'Hoyo de transición tranquilo'},
  13:{nombre:'El generoso',desc:'12% birdies, 6.2% dobles — un caramelo'},
  14:{nombre:'La trampa mortal',desc:'20.8% de dobles — el verdugo solitario'},
  15:{nombre:'El oasis',desc:'14.7% de birdies — el último aliento antes del cierre'},
  16:{nombre:'El sereno',desc:'Hoyo equilibrado, sin sustos'},
  17:{nombre:'El cansancio',desc:'Pocos birdies, muchos bogeys — la fatiga aprieta'},
  18:{nombre:'El cierre traidor',desc:'Solo 5% de birdies — no perdona si llegas justo'}
};

function renderRadiografia(el){
  const S=_campoCalcStats();
  const PAR=S.PAR;

  // Comentarios dinámicos por categoría
  function comentario(tipo,h){
    const total=h.total;
    if(tipo==='eagle'){
      if(h.eagle===0)return{txt:'Jamás se ha hecho',bold:true};
      const pct=h.eagle/total*100;
      if(pct<1)return{txt:'Excepcional',bold:false};
      return{txt:'Raro',bold:false};
    }
    if(tipo==='birdie'){
      if(h.birdie===0&&h.eagle===0)return{txt:'Inexistente',bold:true};
      const pct=(h.birdie+h.eagle)/total*100;
      const rank=S.rankBirAsc.indexOf(h.idx)+1;
      if(rank<=3)return{txt:`Bajísimo (${rank}º del campo)`,bold:true};
      if(rank>=16)return{txt:`Frecuente (${19-rank}º más birdies)`,bold:true};
      if(pct<S.campoBirPct-2)return{txt:'Escaso',bold:false};
      if(pct>S.campoBirPct+2)return{txt:'Habitual',bold:false};
      return{txt:'Normal',bold:false};
    }
    if(tipo==='par'){
      const counts=[h.eagle+h.birdie,h.par,h.bogey,h.doble+h.triple];
      const max=Math.max(...counts);
      if(h.par===max)return{txt:'El resultado más común',bold:true};
      const pct=h.par/total*100;
      if(pct>=50)return{txt:'Mayoritario',bold:false};
      if(pct>=35)return{txt:'Frecuente',bold:false};
      return{txt:'Habitual',bold:false};
    }
    if(tipo==='bogey'){
      const counts=[h.eagle+h.birdie,h.par,h.bogey,h.doble+h.triple];
      const max=Math.max(...counts);
      const pct=h.bogey/total*100;
      const rank=S.rankBogDesc.indexOf(h.idx)+1;
      if(h.bogey===max&&rank<=5)return{txt:`AQUÍ LA CLAVE (${rank}º del campo)`,bold:true};
      if(rank<=3)return{txt:`Punto débil (${rank}º del campo)`,bold:true};
      if(pct>S.campoBogPct+5)return{txt:'Frecuente',bold:false};
      if(pct<S.campoBogPct-5)return{txt:'Bajo',bold:false};
      return{txt:'Normal',bold:false};
    }
    if(tipo==='doble'){
      if(h.doble===0)return{txt:'Jamás',bold:true};
      const pct=h.doble/total*100;
      const rank=S.rankDblDesc.indexOf(h.idx)+1;
      if(rank<=3)return{txt:`Trampa (${rank}º del campo)`,bold:true};
      if(rank>=16)return{txt:'Raro',bold:false};
      if(pct>S.campoDblPct+3)return{txt:'Alto',bold:false};
      if(pct<S.campoDblPct-3)return{txt:'Bajo',bold:false};
      return{txt:'Normal',bold:false};
    }
    if(tipo==='triple'){
      if(h.triple===0)return{txt:'Jamás',bold:true};
      const pct=h.triple/total*100;
      if(pct<1)return{txt:'Excepcional',bold:false};
      if(pct>3)return{txt:'Demasiado frecuente',bold:true};
      return{txt:'Raro',bold:false};
    }
    return{txt:'',bold:false};
  }

  function pctStr(n,d){return d>0?(n/d*100).toFixed(1)+'%':'—';}
  function vsParBadge(avg){
    const v=avg-PAR;
    const col=v>=0.5?'#991b1b':v>=0.3?'#c2410c':v>=0.15?'#854d0e':'#15803d';
    return `<span style="color:${col};font-weight:600">${v>=0?'+':''}${v.toFixed(2)}</span>`;
  }
  function rowBg(tipo){
    if(tipo==='eagle'||tipo==='birdie')return'#fef9c3';
    if(tipo==='par')return'#f0fdf4';
    if(tipo==='bogey')return'#fff7ed';
    if(tipo==='doble'||tipo==='triple')return'rgba(220,38,38,0.06)';
    return '#fff';
  }

  let h='';

  // CABECERA
  h+=`<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#fafafa;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;margin-bottom:14px">
    <div style="font-weight:600;font-size:12px;color:#333">⛳ Todo lo que quiso saber sobre las estadísticas hoyo por hoyo y jamás se atrevió a preguntar</div>
    <div style="font-size:10px;color:#888">clasificación por mejor ventana de 10 vueltas · jugadores con n&lt;10 atenuados al final</div>
  </div>`;

  // BLOQUE — Media por hoyo (matriz jugador × hoyo, movido desde Stats)
  h+=`<div style="margin-bottom:18px">${_renderMediaPorHoyoBlock()}</div>`;

  // CARDS FULL-WIDTH
  h+=`<div style="display:flex;flex-direction:column;gap:14px">`;

  S.holes.forEach(hole=>{
    const avg=hole.sum/hole.total;
    const dificultadRank=S.rankAvg.indexOf(hole.idx)+1;
    const isHard=dificultadRank<=6;
    const isEasy=dificultadRank>=13;
    const headerBg=isHard?'#fef2f2':isEasy?'#f0fdf4':'#fafafa';
    const headerBorder=isHard?'#fecaca':isEasy?'#bbf7d0':'#e5e7eb';
    const rankCol=isHard?'#991b1b':isEasy?'#15803d':'#666';

    h+=`<details class="collapsible-section" style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden">
      <summary style="background:${headerBg};border-bottom:1px solid ${headerBorder};padding:10px 38px 10px 14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <div>
          <span style="font-size:15px;font-weight:700;color:#1a1a1a">Hoyo ${hole.hoyo}</span>
          <span style="font-size:13px;font-weight:600;color:${rankCol};margin-left:10px;font-style:italic">"${HOYO_APODOS[hole.hoyo].nombre}"</span>
          <div style="font-size:10.5px;color:#666;margin-top:3px">Par 3 · ${hole.total} vueltas · <span style="color:#888;font-style:italic">${HOYO_APODOS[hole.hoyo].desc}</span></div>
        </div>
        <div style="font-size:11px;color:${rankCol};font-weight:600;text-transform:uppercase;letter-spacing:0.4px">
          ${dificultadRank}º · avg ${avg.toFixed(2)} ${vsParBadge(avg)}
        </div>
      </summary>
      <div style="display:grid;grid-template-columns:minmax(280px,340px) 1fr;gap:0">
        <div style="border-right:1px solid #f0f0f0">
          <div style="padding:8px 14px;font-size:10px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:0.4px;background:#fafafa;border-bottom:1px solid #f0f0f0">Distribución</div>
          <table style="width:100%;border-collapse:collapse;font-size:11px">
            <thead>
              <tr style="background:#fff">
                <th style="text-align:left;padding:5px 12px;font-weight:600;color:#888;border-bottom:1px solid #f5f5f5">Resultado</th>
                <th style="text-align:right;padding:5px 6px;font-weight:600;color:#888;border-bottom:1px solid #f5f5f5;width:42px">Veces</th>
                <th style="text-align:right;padding:5px 6px;font-weight:600;color:#888;border-bottom:1px solid #f5f5f5;width:50px">%</th>
                <th style="text-align:left;padding:5px 12px;font-weight:600;color:#888;border-bottom:1px solid #f5f5f5">Comentario</th>
              </tr>
            </thead>
            <tbody>`;

    const rows=[
      {label:'Hole in one',count:hole.eagle,tipo:'eagle'},
      {label:'Birdie (2)',count:hole.birdie,tipo:'birdie'},
      {label:'Par (3)',count:hole.par,tipo:'par'},
      {label:'Bogey (4)',count:hole.bogey,tipo:'bogey'},
      {label:'Doble (5)',count:hole.doble,tipo:'doble'},
      {label:'Triple+ (6+)',count:hole.triple,tipo:'triple'}
    ];
    rows.forEach(r=>{
      const com=comentario(r.tipo,hole);
      const txtCol=com.bold?(r.tipo==='bogey'||r.tipo==='doble'||r.tipo==='triple'?'#991b1b':r.tipo==='par'?'#15803d':'#854d0e'):'#666';
      h+=`<tr style="background:${rowBg(r.tipo)}">
        <td style="padding:5px 12px;font-weight:${com.bold?700:500};color:#333;border-bottom:1px solid #fafafa">${r.label}</td>
        <td style="text-align:right;padding:5px 6px;color:#333;border-bottom:1px solid #fafafa;font-weight:${com.bold?600:400}">${r.count}</td>
        <td style="text-align:right;padding:5px 6px;color:#333;border-bottom:1px solid #fafafa;font-weight:${com.bold?600:400}">${pctStr(r.count,hole.total)}</td>
        <td style="padding:5px 12px;color:${txtCol};font-weight:${com.bold?600:400};border-bottom:1px solid #fafafa;font-size:10.5px">${com.txt}</td>
      </tr>`;
    });
    h+=`</tbody></table>
        </div>
        <div>
          <div style="padding:8px 14px;font-size:10px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:0.4px;background:#fafafa;border-bottom:1px solid #f0f0f0">Por jugador</div>
          <div id="campo-jug-${hole.idx}">${_campoRenderJugadores(hole.idx)}</div>
        </div>
      </div>
    </details>`;
  });

  h+=`</div>`;

  // ── BLOQUE TRAMOS (movido desde la antigua pestaña 🏁 Tramos) ──
  h+=`<div style="margin-top:28px;margin-bottom:24px">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#fafafa;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;margin-bottom:14px">
      <div style="font-weight:600;font-size:12px;color:#333">🏁 Tramos del campo</div>
      <div style="font-size:10px;color:#888">4 secciones destacadas con clasificación por mejor avg10 + récord de partido individual</div>
    </div>`;
  h+=_renderTramosBlock();
  h+=`</div>`;

  // ── Estadísticas por hoyo (al final, debajo del H18) ──
  // Calcular birdies y dobles por hoyo (1-18) desde HM
  const hoyoStats=Array.from({length:18},(_,i)=>({hoyo:i+1,birdies:0,dobles:0,total:0}));
  Object.entries(HM).forEach(([key,scores])=>{
    const [jStr,jugador]=key.split('_');
    const rawEntry=RAW.find(r=>r.j===parseInt(jStr)&&r.jugador===jugador);
    if(!rawEntry)return;
    scores.forEach((v,i)=>{
      if(v===null||i>=18)return;
      hoyoStats[i].total++;
      if(v<=2)hoyoStats[i].birdies++;
      if(v>=5)hoyoStats[i].dobles++;
    });
  });

  const byBirdiesAsc=[...hoyoStats].sort((a,b)=>a.birdies-b.birdies||b.dobles-a.dobles);
  const byBirdiesDesc=[...hoyoStats].sort((a,b)=>b.birdies-a.birdies||a.dobles-b.dobles);
  const byDoblesAsc=[...hoyoStats].sort((a,b)=>a.dobles-b.dobles||b.birdies-a.birdies);
  const byDoblesDesc=[...hoyoStats].sort((a,b)=>b.dobles-a.dobles||a.birdies-b.birdies);

  function pctR(n,d){return d>0?(n/d*100).toFixed(1)+'%':'—';}
  function hoyoBar(val,max,color){
    const w=max>0?Math.round(val/max*100):0;
    return `<div style="flex:1;height:8px;background:#f3f4f6;border-radius:4px;overflow:hidden"><div style="width:${w}%;height:100%;background:${color};border-radius:4px"></div></div>`;
  }
  function renderHoyoLista(data,valKey,color){
    const maxVal=Math.max(...data.map(d=>d[valKey]));
    let s=`<div style="display:flex;flex-direction:column;gap:3px">`;
    data.forEach((hh,i)=>{
      const val=hh[valKey];
      const p=pctR(val,hh.total);
      s+=`<div style="display:flex;align-items:center;gap:8px;padding:5px 8px;background:${i===0?color+'18':'#fff'};border-radius:7px;border:1px solid ${i===0?color+'44':'#f0f0f0'}">
        <div style="width:48px;font-size:11px;font-weight:${i===0?700:500};color:${i===0?color:'#555'}">H${hh.hoyo}</div>
        ${hoyoBar(val,maxVal,color)}
        <div style="width:28px;text-align:right;font-size:12px;font-weight:700;color:${i===0?color:'#555'}">${val}</div>
        <div style="width:38px;text-align:right;font-size:10px;color:#aaa">${p}</div>
      </div>`;
    });
    s+=`</div>`;
    return s;
  }

  h+=`<div style="margin-top:24px">`;
  h+=`<div style="font-weight:600;font-size:13px;color:#1a1a1a;margin-bottom:10px">📊 Estadísticas por hoyo</div>`;
  h+=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">`;

  h+=`<div>
    <div style="font-size:11px;font-weight:600;color:#b91c1c;margin-bottom:8px;display:flex;align-items:center;gap:5px">
      <span style="font-size:14px">🐦</span> Hoyos con menos birdies
    </div>
    ${renderHoyoLista(byBirdiesAsc,'birdies','#b91c1c')}
  </div>`;

  h+=`<div>
    <div style="font-size:11px;font-weight:600;color:#15803d;margin-bottom:8px;display:flex;align-items:center;gap:5px">
      <span style="font-size:14px">🐦</span> Hoyos con más birdies
    </div>
    ${renderHoyoLista(byBirdiesDesc,'birdies','#15803d')}
  </div>`;

  h+=`<div>
    <div style="font-size:11px;font-weight:600;color:#0e7490;margin-bottom:8px;display:flex;align-items:center;gap:5px">
      <span style="font-size:14px">💚</span> Hoyos con menos dobles
    </div>
    ${renderHoyoLista(byDoblesAsc,'dobles','#0e7490')}
  </div>`;

  h+=`<div>
    <div style="font-size:11px;font-weight:600;color:#991b1b;margin-bottom:8px;display:flex;align-items:center;gap:5px">
      <span style="font-size:14px">💀</span> Hoyos con más dobles
    </div>
    ${renderHoyoLista(byDoblesDesc,'dobles','#991b1b')}
  </div>`;

  // Más equilibrados: mayor % de pares (ni birdie ni doble)
  const byEquilibrado=[...hoyoStats].map(hh=>{
    const pares=hh.total-hh.birdies-hh.dobles;
    return{...hh,pares,pctPares:hh.total>0?pares/hh.total:0};
  }).sort((a,b)=>b.pctPares-a.pctPares||a.dobles-b.dobles);

  function renderEquilibradoLista(data){
    const maxPares=Math.max(...data.map(d=>d.pares));
    const color='#6b21a8';
    let s=`<div style="display:flex;flex-direction:column;gap:3px">`;
    data.forEach((hh,i)=>{
      s+=`<div style="display:flex;align-items:center;gap:8px;padding:5px 8px;background:${i===0?color+'18':'#fff'};border-radius:7px;border:1px solid ${i===0?color+'44':'#f0f0f0'}">
        <div style="width:48px;font-size:11px;font-weight:${i===0?700:500};color:${i===0?color:'#555'}">H${hh.hoyo}</div>
        <div style="flex:1;height:8px;background:#f3f4f6;border-radius:4px;overflow:hidden"><div style="width:${maxPares>0?Math.round(hh.pares/maxPares*100):0}%;height:100%;background:${color};border-radius:4px"></div></div>
        <div style="width:28px;text-align:right;font-size:12px;font-weight:700;color:${i===0?color:'#555'}">${hh.pares}</div>
        <div style="width:38px;text-align:right;font-size:10px;color:#aaa">${pctR(hh.pares,hh.total)}</div>
      </div>`;
    });
    s+=`</div>`;
    return s;
  }

  h+=`<div style="grid-column:1/-1;margin-top:8px">
    <div style="font-size:11px;font-weight:600;color:#6b21a8;margin-bottom:8px;display:flex;align-items:center;gap:5px">
      <span style="font-size:14px">🎯</span> Hoyos más equilibrados <span style="font-size:10px;font-weight:400;color:#aaa;margin-left:4px">mayor % de pares · sin birdie ni doble</span>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div>${renderEquilibradoLista(byEquilibrado.slice(0,9))}</div>
      <div>${renderEquilibradoLista(byEquilibrado.slice(9))}</div>
    </div>
  </div>`;

  h+=`</div></div>`;

  // NOTA al pie
  h+=`<div style="margin-top:18px;font-size:10px;color:#999;text-align:center;line-height:1.5">
    Cálculo dinámico desde HM y RAW · referencias relativas al campo (avg ${S.campoAvg.toFixed(3)}, birdies ${S.campoBirPct.toFixed(1)}%, bogeys ${S.campoBogPct.toFixed(1)}%, dobles+ ${S.campoDblPct.toFixed(1)}%)
  </div>`;

  el.innerHTML=h;
  // Renderizar la tabla interactiva de "Media por hoyo" (movida desde Stats)
  if(typeof window.__renderStatsMediaHoyo === 'function'){
    window.__renderStatsMediaHoyo(-1);
  }
}


function renderRecords(el){
  let h='';
  const byJ={};RAW.forEach(r=>{if(!byJ[r.j])byJ[r.j]={j:r.j,f:r.f,scores:[]};byJ[r.j].scores.push(r.total);});
  const jornadas=Object.values(byJ).sort((a,b)=>a.j-b.j);
  function scoreColor(v){if(v<0)return{bg:'#dcfce7',col:'#15803d'};if(v===0)return{bg:'#f3f4f6',col:'#555'};if(v<=5)return{bg:'#fff7ed',col:'#c2410c'};return{bg:'#fee2e2',col:'#991b1b'};}
  function shieldIcon(color){return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L4 6V12C4 16.4 7.4 20.5 12 22C16.6 20.5 20 16.4 20 12V6L12 2Z" fill="${color}" opacity="0.15" stroke="${color}" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 2L4 6V12C4 16.4 7.4 20.5 12 22C16.6 20.5 20 16.4 20 12V6L12 2Z" fill="none" stroke="${color}" stroke-width="1.5" stroke-linejoin="round"/></svg>`;}

  // 1. Han batido el campo — calculado desde RAW
  const campoMap={};
  RAW.filter(r=>r.total<0).forEach(r=>{
    if(!campoMap[r.jugador])campoMap[r.jugador]=[];
    campoMap[r.jugador].push(r.total);
  });
  const campoData=Object.entries(campoMap).map(([jugador,resultados])=>({jugador,resultados}))
    .sort((a,b)=>b.resultados.length-a.resultados.length||Math.min(...a.resultados)-Math.min(...b.resultados));
  h+=`<div style="margin-bottom:18px"><div style="font-weight:500;font-size:12px;margin-bottom:8px">${shieldIcon('#15803d')} Han batido el campo</div>`;
  campoData.forEach((p,i)=>{
    const sorted=[...p.resultados].sort((a,b)=>a-b);
    const chips=sorted.map(v=>{const c=scoreColor(v);return `<span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:24px;border-radius:5px;background:${c.bg};color:${c.col};font-size:11px;font-weight:500;border:1px solid ${c.col}33">${v}</span>`;}).join(' ');
    h+=`<div style="display:flex;align-items:center;gap:10px;padding:7px 10px;background:${i===0?'#f0fdf4':'#fff'};border-radius:7px;margin-bottom:4px;border:1px solid #eee">
      <div style="width:26px;height:26px;border-radius:5px;background:${COLORS[p.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.jugador.slice(0,3)}</div>
      <div style="font-weight:500;font-size:12px;min-width:80px">${p.jugador}</div>
      <div style="font-weight:700;font-size:13px;color:#0f766e;min-width:20px">${p.resultados.length}</div>
      <div style="display:flex;gap:4px;flex-wrap:wrap">${chips}</div>
    </div>`;
  });
  h+='</div>';

  // 2. Racha sin doble dígito
  // Racha sin doble dígito — calculada 100% desde RAW
  const rachaStats=(function(){
    return PLAYERS.map(jugador=>{
      const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
      if(!partidas.length)return null;
      let maxBest=0,maxDesde=null,maxHasta=null;
      let cur=0,curDesde=null;
      partidas.forEach(p=>{
        if(p.total<10){
          cur++;
          if(cur===1)curDesde='J'+p.j;
          if(cur>maxBest){maxBest=cur;maxDesde=curDesde;maxHasta='J'+p.j;}
        } else cur=0;
      });
      if(!maxBest)return null;
      return{jugador,best:maxBest,desde:maxDesde,hasta:maxHasta};
    }).filter(Boolean).sort((a,b)=>b.best-a.best);
  })();

  function calcRachaSinDblDigit(jugador){
    const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>b.j-a.j);
    let racha=0;
    for(const p of partidas){
      if(p.total<10)racha++;
      else break;
    }
    return racha;
  }

  const bestRacha=rachaStats[0]?.best||0;
  h+='<div style="margin-bottom:18px"><div style="display:flex;align-items:center;gap:6px;font-weight:500;font-size:12px;margin-bottom:8px">'+shieldIcon('#0f766e')+' Racha sin doble dígito</div>';
  rachaStats.forEach((p,i)=>{
    const actual=calcRachaSinDblDigit(p.jugador);
    const actualColor=actual>0?'#0f766e':'#ccc';
    h+='<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:'+(i===0?'#f0fdf4':'#fff')+';border-radius:7px;margin-bottom:4px;border:1px solid #eee">'
     +'<div style="width:26px;height:26px;border-radius:5px;background:'+(COLORS[p.jugador]||'#eee')+';display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">'+p.jugador.slice(0,3)+'</div>'
     +'<div style="flex:1;font-weight:500;font-size:12px">'+p.jugador+'</div>'
     +'<div style="font-size:10px;color:#aaa;margin-right:4px">'+p.desde+(p.hasta?'→'+p.hasta:'')+'</div>'
     +'<div style="display:flex;align-items:baseline;gap:4px">'
       +'<div style="font-weight:700;font-size:16px;color:#0f766e;min-width:28px;text-align:right">'+p.best+'</div>'
       +'<div style="font-weight:600;font-size:11px;color:'+actualColor+';min-width:16px;text-align:right">'+actual+'</div>'
     +'</div>'
     +'</div>';
  });
  h+='</div>';

  // 3. Más birdies en un partido — calculado desde HM
  const birMap=[];
  RAW.forEach(r=>{
    const scores=HM[r.j+'_'+r.jugador];
    if(!scores)return;
    const birs=scores.filter(v=>v!==null&&v<=2).length;
    if(birs>=6) birMap.push({jugador:r.jugador,fecha:'J'+r.j+' · '+r.f,birs,total:r.total});
  });
  birMap.sort((a,b)=>b.birs-a.birs||a.total-b.total);
  h+=`<div style="margin-bottom:18px"><div style="font-weight:500;font-size:12px;margin-bottom:8px">${shieldIcon('#854d0e')} Más birdies en un partido</div>`;
  birMap.forEach((r,i)=>{h+=`<div style="display:flex;align-items:center;gap:8px;padding:6px 9px;background:${i===0?'#fefce8':'#fff'};border-radius:7px;margin-bottom:2px;border:1px solid #eee"><div style="width:26px;height:26px;border-radius:5px;background:${COLORS[r.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${r.jugador.slice(0,3)}</div><div style="flex:1"><span style="font-weight:500;font-size:11px">${r.jugador}</span><span style="font-size:10px;color:#aaa;margin-left:6px">${r.fecha}</span><span style="font-size:10px;color:#aaa;margin-left:4px">total ${r.total>=0?'+'+r.total:r.total}</span></div><div style="font-weight:500;font-size:11px;color:#854d0e">${r.birs} birdies</div></div>`;});
  h+='</div>';

  // 3.5 Más pares en un partido — hall of fame: entradas hasta que todos los jugadores aparezcan al menos una vez
  (function(){
    const allPares=[];
    RAW.forEach(r=>{
      const scores=HM[r.j+'_'+r.jugador];
      if(!scores)return;
      const pares=scores.filter(v=>v===3).length;
      allPares.push({jugador:r.jugador,fecha:'J'+r.j+' · '+r.f,pares,total:r.total});
    });
    allPares.sort((a,b)=>b.pares-a.pares||a.total-b.total);
    // Mostrar solo entradas con los dos mejores valores distintos de pares
    const valoresDistintos=[...new Set(allPares.map(r=>r.pares))].sort((a,b)=>b-a);
    const top2Valores=valoresDistintos.slice(0,2);
    const paresMap=allPares.filter(r=>top2Valores.includes(r.pares));
    h+='<div style="margin-bottom:18px"><div style="display:flex;align-items:center;gap:6px;font-weight:500;font-size:12px;margin-bottom:8px">'+shieldIcon('#0891b2')+' Más pares en un partido</div>';
    paresMap.forEach((r,i)=>{
      const nuevo=i===0||!paresMap.slice(0,i).some(x=>x.jugador===r.jugador);
      h+='<div style="display:flex;align-items:center;gap:8px;padding:6px 9px;background:'+(i===0?'#ecfeff':nuevo?'#f0fdff':'#fff')+';border-radius:7px;margin-bottom:2px;border:1px solid #eee">'
       +'<div style="width:26px;height:26px;border-radius:5px;background:'+(COLORS[r.jugador]||'#eee')+';display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">'+r.jugador.slice(0,3)+'</div>'
       +'<div style="flex:1"><span style="font-weight:500;font-size:11px">'+r.jugador+'</span><span style="font-size:10px;color:#aaa;margin-left:6px">'+r.fecha+'</span><span style="font-size:10px;color:#aaa;margin-left:4px">total '+(r.total>=0?'+'+r.total:r.total)+'</span></div>'
       +'<div style="font-weight:500;font-size:11px;color:#0891b2">'+r.pares+' pares</div>'
       +'</div>';
    });
    h+='</div>';
  })();

  // 4. Birdies consecutivos — calculado desde HM
  const consMap=[];
  RAW.forEach(r=>{
    const scores=HM[r.j+'_'+r.jugador];
    if(!scores)return;
    let max=0,cur=0;
    scores.forEach(v=>{if(v!==null&&v<=2){cur++;max=Math.max(max,cur);}else cur=0;});
    if(max>=3) consMap.push({jugador:r.jugador,fecha:'J'+r.j,max});
  });
  consMap.sort((a,b)=>b.max-a.max);
  h+=`<div style="margin-bottom:18px"><div style="font-weight:500;font-size:12px;margin-bottom:8px">${shieldIcon('#c2410c')} Birdies consecutivos</div>`;
  consMap.forEach((r,i)=>{h+=`<div style="display:flex;align-items:center;gap:8px;padding:6px 9px;background:${i===0?'#fff7ed':'#fff'};border-radius:7px;margin-bottom:2px;border:1px solid #eee"><div style="width:26px;height:26px;border-radius:5px;background:${COLORS[r.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${r.jugador.slice(0,3)}</div><div style="flex:1"><span style="font-weight:500;font-size:11px">${r.jugador}</span><span style="font-size:10px;color:#aaa;margin-left:6px">${r.fecha}</span></div><div style="font-weight:500;font-size:11px;color:#c2410c">${r.max} seguidos</div></div>`;});
  h+='</div>';

  // 5.5 Racha sin doble bogey — racha actual calculada automáticamente del HM
  function calcRachaActual(jugador){
    const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>b.j-a.j);
    let racha=0;
    let desdeJ=null;
    for(const p of partidas){
      const key=p.j+'_'+jugador;
      const scores=HM[key];
      if(!scores)break;
      const tieneDbl=scores.some(v=>v!==null&&v>=5);
      if(tieneDbl)break;
      racha++;
      desdeJ='J'+p.j;
    }
    return{racha,desdeJ};
  }

  // Racha sin doble bogey — calculada DINÁMICAMENTE desde HM
  // Mejor histórica: rondas consecutivas completas sin ningún hoyo ≥5
  function calcRachaBestSinDbl(jugador){
    const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
    let maxRacha=0,curRacha=0,curDesde=null,bestDesde=null,bestHasta=null;
    for(const p of partidas){
      const scores=HM[p.j+'_'+jugador];
      if(!scores){curRacha=0;curDesde=null;continue;}
      const tieneDbl=scores.some(v=>v!==null&&v>=5);
      if(tieneDbl){curRacha=0;curDesde=null;continue;}
      if(curRacha===0)curDesde='J'+p.j;
      curRacha++;
      if(curRacha>maxRacha){maxRacha=curRacha;bestDesde=curDesde;bestHasta='J'+p.j;}
    }
    return{best:maxRacha,desde:bestDesde,hasta:bestHasta};
  }
  const sinDblBogeyData=PLAYERS.map(jugador=>{
    const r=calcRachaBestSinDbl(jugador);
    if(r.best<2)return null;
    return{jugador,best:r.best,desde:r.desde,hasta:r.hasta};
  }).filter(Boolean).sort((a,b)=>b.best-a.best||a.jugador.localeCompare(b.jugador));
  h+='<div style="margin-bottom:18px"><div style="display:flex;align-items:center;gap:6px;font-weight:500;font-size:12px;margin-bottom:8px">'+shieldIcon('#7c3aed')+' Racha sin doble bogey</div>';
  sinDblBogeyData.forEach((p,i)=>{
    const{racha,desdeJ}=calcRachaActual(p.jugador);
    const actualTxt=racha>0?racha:0;
    const actualColor=racha>0?'#7c3aed':'#ccc';
    const actualLabel='';
    h+='<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:'+(i===0?'#f5f3ff':'#fff')+';border-radius:7px;margin-bottom:4px;border:1px solid #eee">'
     +'<div style="width:26px;height:26px;border-radius:5px;background:'+(COLORS[p.jugador]||'#eee')+';display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">'+p.jugador.slice(0,3)+'</div>'
     +'<div style="flex:1;font-weight:500;font-size:12px">'+p.jugador+'</div>'
     +'<div style="font-size:10px;color:#aaa;margin-right:8px">'+p.desde+'→'+p.hasta+'</div>'
     +'<div style="display:flex;align-items:baseline;gap:4px">'
       +'<div style="font-weight:700;font-size:16px;color:#7c3aed">'+p.best+'</div>'
       +'<div style="text-align:right"><div style="font-weight:600;font-size:11px;color:'+actualColor+'">'+actualTxt+'</div>'+actualLabel+'</div>'
     +'</div>'
     +'</div>';
  });
  h+='</div>';

  // 5. Racha pares o mejor — calculada automáticamente desde HM
  function calcRachaPar(jugador){
    const PAR=3;
    const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>b.j-a.j);
    let rachaHoyos=0;
    for(const p of partidas){
      const key=p.j+'_'+jugador;
      const scores=HM[key];
      if(!scores)break;
      let parado=false;
      for(let h=scores.length-1;h>=0;h--){
        if(scores[h]===null)continue;
        if(scores[h]<=PAR)rachaHoyos++;
        else{parado=true;break;}
      }
      if(parado)break;
    }
    return rachaHoyos;
  }

  // Racha pares o mejor — hall of fame calculado 100% desde HM
  (function(){
    const PAR=3;
    // Para cada jugador calcular todas sus rachas y quedarse con la mejor
    const bestRachas=[];
    PLAYERS.forEach(jugador=>{
      const partidas=RAW.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
      if(!partidas.length)return;
      // Construir secuencia completa de hoyos en orden
      let secuencia=[]; // [{v, j}]
      partidas.forEach(p=>{
        const scores=HM[p.j+'_'+jugador];
        if(!scores)return;
        scores.forEach(v=>secuencia.push({v,j:p.j}));
      });
      // Buscar racha máxima
      let maxRacha=0,maxDesde=null,maxHasta=null;
      let cur=0,curDesde=null;
      for(let i=0;i<secuencia.length;i++){
        const{v,j}=secuencia[i];
        if(v===null)continue;
        if(v<=PAR){cur++;if(cur===1)curDesde=j;if(cur>maxRacha){maxRacha=cur;maxDesde=curDesde;maxHasta=j;}}
        else cur=0;
      }
      if(maxRacha>0){
        const label=maxDesde===maxHasta?'J'+maxDesde:'J'+maxDesde+'→J'+maxHasta;
        bestRachas.push({jugador,best:maxRacha,fecha:label});
      }
    });
    bestRachas.sort((a,b)=>b.best-a.best);

    // Hall of fame: entradas hasta que todos estén representados
    const jugadoresConRonda=new Set(RAW.map(r=>r.jugador));
    // En este ranking ya tenemos el mejor de cada jugador, así que simplemente mostramos todos
    h+=`<div style="margin-bottom:18px"><div style="font-weight:500;font-size:12px;margin-bottom:8px">${shieldIcon('#1e40af')} Racha pares o mejor consecutivos</div>`;
    bestRachas.forEach((r,i)=>{
      const actual=calcRachaPar(r.jugador);
      const actualColor=actual>0?'#1e40af':'#ccc';
      h+=`<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:${i===0?'#eff6ff':'#fff'};border-radius:7px;margin-bottom:4px;border:1px solid #eee">
        <div style="width:26px;height:26px;border-radius:5px;background:${COLORS[r.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${r.jugador.slice(0,3)}</div>
        <div style="flex:1;font-weight:500;font-size:12px">${r.jugador}</div>
        <div style="font-size:10px;color:#aaa;margin-right:8px">${r.fecha}</div>
        <div style="display:flex;align-items:baseline;gap:4px">
          <div style="font-weight:700;font-size:16px;color:#1e40af">${r.best}</div>
          <div style="font-weight:600;font-size:11px;color:${actualColor}">${actual}</div>
        </div>
      </div>`;
    });
  })();
  h+='</div>';

  // 6. Ausencias — calculado dinámicamente desde RAW
  // Cada jugador: cuántas jornadas no jugó desde su primera aparición
  const todasJornadasOrd=[...new Set(RAW.map(r=>r.j))].sort((a,b)=>a-b);
  const ausenciasData=PLAYERS.map(jugador=>{
    const jsJugados=[...new Set(RAW.filter(r=>r.jugador===jugador).map(r=>r.j))].sort((a,b)=>a-b);
    if(!jsJugados.length)return null;
    const primera=jsJugados[0];
    const desdePrimera=todasJornadasOrd.filter(j=>j>=primera);
    const ausencias=desdePrimera.filter(j=>!jsJugados.includes(j));
    return{jugador,primera,total:desdePrimera.length,jugadas:jsJugados.length,ausentes:ausencias.length};
  }).filter(Boolean).sort((a,b)=>b.ausentes-a.ausentes||a.jugador.localeCompare(b.jugador));

  h+=`<div style="margin-bottom:18px"><div style="display:flex;align-items:center;gap:6px;font-weight:500;font-size:12px;margin-bottom:8px">${shieldIcon('#0369a1')} Ausencias <span style="font-size:10px;color:#aaa;font-weight:400">(desde su 1ª jornada)</span></div>`;
  ausenciasData.forEach((p,i)=>{
    h+=`<div style="display:flex;align-items:center;gap:8px;padding:6px 9px;background:${i%2===0?'#fff':'#f0f9ff'};border-radius:7px;margin-bottom:2px;border:1px solid #eee">
      <div style="width:26px;height:26px;border-radius:5px;background:${COLORS[p.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.jugador.slice(0,3)}</div>
      <div style="flex:1"><span style="font-weight:500;font-size:11px">${p.jugador}</span><span style="font-size:10px;color:#aaa;margin-left:6px">desde J${p.primera}</span></div>
      <div style="font-size:10px;color:#aaa;margin-right:8px">${p.jugadas}/${p.total}</div>
      <div style="font-weight:700;font-size:13px;color:${p.ausentes===0?'#15803d':'#0369a1'};min-width:24px;text-align:right">${p.ausentes}</div>
    </div>`;
  });
  h+='</div>';

  // 🛡️ Abandonos — leídos directamente de la constante ABANDONOS_REGISTRADOS
  if(typeof ABANDONOS_REGISTRADOS !== 'undefined' && ABANDONOS_REGISTRADOS.length > 0){
    h+=`<div style="margin-bottom:18px">
      <div style="font-weight:500;font-size:12px;margin-bottom:4px;display:flex;align-items:center;gap:6px">
        ${shieldIcon('#991b1b')} Abandonos
        <span style="font-size:10px;color:#888;font-weight:400">(no afectan a ninguna estadística)</span>
      </div>`;
    ABANDONOS_REGISTRADOS.forEach(a => {
      h+=`<div style="display:flex;align-items:center;gap:10px;padding:7px 10px;background:#fff;border-radius:7px;margin-bottom:4px;border:1px solid #eee">
        <div style="width:26px;height:26px;border-radius:5px;background:${COLORS[a.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${a.jugador.slice(0,3)}</div>
        <div style="font-weight:500;font-size:12px;min-width:80px">${a.jugador}</div>
        <div style="font-size:11px;color:#555">abandonó la <b>J${a.j}</b> · ${a.f}</div>
      </div>`;
    });
    h+='</div>';
  }

  el.innerHTML=h;
}

// ── ANÁLISIS DE RECORDS ──────────────────────────────────────────────────────
function calcAnalisisRecords(){
  const ultimaJ=Math.max(...RAW.map(r=>r.j));
  const jugadoresUltimaJ=new Set(RAW.filter(r=>r.j===ultimaJ).map(r=>r.jugador));

  // RAW sin la última jornada
  const RAW_prev=RAW.filter(r=>r.j<ultimaJ);
  // HM sin la última jornada
  const HM_prev={};
  Object.keys(HM).forEach(k=>{const j=parseInt(k.split('_')[0]);if(j<ultimaJ)HM_prev[k]=HM[k];});

  const alertas=[];

  // ── Helper: calcular pares en una ronda ──
  function getPares(jugador,j,hmObj){
    const s=hmObj[j+'_'+jugador];
    return s?s.filter(v=>v===3).length:0;
  }

  // ── Helper: mejor pares en ronda histórico ──
  function bestParesHist(jugador,rawData,hmObj){
    let max=0;
    rawData.filter(r=>r.jugador===jugador).forEach(r=>{
      const p=getPares(jugador,r.j,hmObj);
      if(p>max)max=p;
    });
    return max;
  }

  // ── Helper: mejor racha pares o mejor ──
  function bestRachaPar(jugador,rawData,hmObj){
    const PAR=3;
    const partidas=rawData.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
    let maxR=0,cur=0;
    partidas.forEach(p=>{
      const scores=hmObj[p.j+'_'+jugador];
      if(!scores)return;
      scores.forEach(v=>{if(v===null)return;if(v<=PAR){cur++;if(cur>maxR)maxR=cur;}else cur=0;});
    });
    return maxR;
  }

  // ── Helper: mejor racha sin doble dígito ──
  function bestRachaSinDbl(jugador,rawData){
    const partidas=rawData.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
    let maxR=0,cur=0;
    partidas.forEach(p=>{if(p.total<10){cur++;if(cur>maxR)maxR=cur;}else cur=0;});
    return maxR;
  }

  // ── Helper: birdies (incluye eagles) en una ronda ──
  function getBirdies(jugador,j,hmObj){
    const s=hmObj[j+'_'+jugador];
    return s?s.filter(v=>v!==null&&v<=2).length:0;
  }

  // ── Helper: mejor birdies en ronda histórico ──
  function bestBirdiesHist(jugador,rawData,hmObj){
    let max=0;
    rawData.filter(r=>r.jugador===jugador).forEach(r=>{
      const b=getBirdies(jugador,r.j,hmObj);
      if(b>max)max=b;
    });
    return max;
  }

  // ── Helper: mejor racha de birdies consecutivos en una ronda (busca dentro de cada ronda) ──
  function bestRachaBirRonda(jugador,rawData,hmObj){
    let maxR=0;
    rawData.filter(r=>r.jugador===jugador).forEach(r=>{
      const scores=hmObj[r.j+'_'+jugador];
      if(!scores)return;
      let cur=0;
      scores.forEach(v=>{if(v===null)return;if(v<=2){cur++;if(cur>maxR)maxR=cur;}else cur=0;});
    });
    return maxR;
  }

  // ── Helper: mejor avg10 de un jugador en un tramo (Infinity si <10 jornadas válidas)
  function bestMejor10Tramo(jugador,rawData,hmObj,idxs){
    const partidas=rawData.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);
    const series=[];
    partidas.forEach(p=>{
      const sc=hmObj[p.j+'_'+jugador];
      if(!sc)return;
      if(idxs.some(i=>sc[i]===null||sc[i]===undefined))return;
      series.push(idxs.reduce((s,i)=>s+sc[i],0));
    });
    if(series.length<10)return Infinity;
    let mejor=Infinity;
    for(let i=0;i<=series.length-10;i++){
      const sum=series.slice(i,i+10).reduce((s,x)=>s+x,0);
      if(sum/10<mejor)mejor=sum/10;
    }
    return mejor;
  }

  // ── Definición de los 6 tramos destacados (fijos, igual que en pestaña Hoyos) ──
  const TRAMOS_RECORDS=[
    {label:`Arranque ${TRAMOS_FIJOS.arranque.label}`,idxs:TRAMOS_FIJOS.arranque.idxs},
    {label:`Amen Corner ${TRAMOS_FIJOS.amenCorner.label}`,idxs:TRAMOS_FIJOS.amenCorner.idxs},
    {label:`Camino de rosas ${TRAMOS_FIJOS.caminoRosas.label}`,idxs:TRAMOS_FIJOS.caminoRosas.idxs},
    {label:`Sprint final ${TRAMOS_FIJOS.sprintFinal.label}`,idxs:TRAMOS_FIJOS.sprintFinal.idxs},
    {label:`Ida ${TRAMOS_FIJOS.front.label}`,idxs:TRAMOS_FIJOS.front.idxs},
    {label:`Vuelta ${TRAMOS_FIJOS.back.label}`,idxs:TRAMOS_FIJOS.back.idxs}
  ];

  // ── Helper: ranking de un array [{jugador, val}] ──
  // asc=true → menor val es mejor (para tramos donde menor avg = mejor)
  function getRanking(arr,asc){
    const sorted=[...arr].sort((a,b)=>asc?a.val-b.val:b.val-a.val);
    const rank={};sorted.forEach((x,i)=>rank[x.jugador]=i);
    return rank;
  }

  jugadoresUltimaJ.forEach(jugador=>{
    const rawJ=RAW.find(r=>r.j===ultimaJ&&r.jugador===jugador);
    if(!rawJ)return;

    // 1. SCORE TOTAL
    const prevBest=RAW_prev.filter(r=>r.jugador===jugador).reduce((m,r)=>Math.min(m,r.total),Infinity);
    if(rawJ.total<prevBest&&prevBest!==Infinity){
      const mejorAbsoluto=RAW_prev.reduce((m,r)=>Math.min(m,r.total),Infinity);
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:RAW_prev.filter(r=>r.jugador===j).reduce((m,r)=>Math.min(m,r.total),Infinity)})).sort((a,b)=>a.v-b.v)[0];
      const prevRef=exHolder&&exHolder.v===prevBest?`${prevBest>=0?'+'+prevBest:prevBest} ${exHolder.j}`:`${prevBest>=0?'+'+prevBest:prevBest}`;
      if(rawJ.total<mejorAbsoluto)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto de score: <b>${rawJ.total>=0?'+'+rawJ.total:rawJ.total}</b> (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal de score: <b>${rawJ.total>=0?'+'+rawJ.total:rawJ.total}</b> (${prevRef})`});
    }

    // 2. PARES EN UNA RONDA
    const prevBestPares=bestParesHist(jugador,RAW_prev,HM_prev);
    const nuevoPares=getPares(jugador,ultimaJ,HM);
    if(nuevoPares>prevBestPares){
      const mejorAbsolutoPares=Math.max(...PLAYERS.map(j=>bestParesHist(j,RAW_prev,HM_prev)));
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestParesHist(j,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
      const prevRef=exHolder&&exHolder.v===prevBestPares?`${prevBestPares} ${exHolder.j}`:`${prevBestPares}`;
      if(nuevoPares>mejorAbsolutoPares)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto de pares en una ronda: <b>${nuevoPares}</b> (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal de pares en ronda: <b>${nuevoPares}</b> (${prevRef})`});
    }

    // 3. RACHA PARES O MEJOR
    const prevRachaPar=bestRachaPar(jugador,RAW_prev,HM_prev);
    const nuevaRachaPar=bestRachaPar(jugador,RAW,HM);
    if(nuevaRachaPar>prevRachaPar){
      const mejorAbsolutoRachaPar=Math.max(...PLAYERS.map(j=>bestRachaPar(j,RAW_prev,HM_prev)));
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestRachaPar(j,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
      const prevRef=exHolder&&exHolder.v===prevRachaPar?`${prevRachaPar} ${exHolder.j}`:`${prevRachaPar}`;
      if(nuevaRachaPar>mejorAbsolutoRachaPar)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto racha pares o mejor: <b>${nuevaRachaPar}</b> hoyos (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal racha pares o mejor: <b>${nuevaRachaPar}</b> hoyos (${prevRef})`});
    }

    // 4. RACHA SIN DOBLE DÍGITO
    const prevRachaDbl=bestRachaSinDbl(jugador,RAW_prev);
    const nuevaRachaDbl=bestRachaSinDbl(jugador,RAW);
    if(nuevaRachaDbl>prevRachaDbl){
      const mejorAbsolutoRachaDbl=Math.max(...PLAYERS.map(j=>bestRachaSinDbl(j,RAW_prev)));
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestRachaSinDbl(j,RAW_prev)})).sort((a,b)=>b.v-a.v)[0];
      const prevRef=exHolder&&exHolder.v===prevRachaDbl?`${prevRachaDbl} ${exHolder.j}`:`${prevRachaDbl}`;
      if(nuevaRachaDbl>mejorAbsolutoRachaDbl)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto racha sin doble dígito: <b>${nuevaRachaDbl}</b> jornadas (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal racha sin doble dígito: <b>${nuevaRachaDbl}</b> jornadas (${prevRef})`});
    }

    // 5. BIRDIES EN UNA RONDA
    const prevBestBir=bestBirdiesHist(jugador,RAW_prev,HM_prev);
    const nuevoBir=getBirdies(jugador,ultimaJ,HM);
    if(nuevoBir>prevBestBir){
      const mejorAbsolutoBir=Math.max(...PLAYERS.map(j=>bestBirdiesHist(j,RAW_prev,HM_prev)));
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestBirdiesHist(j,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
      const prevRef=exHolder&&exHolder.v===prevBestBir?`${prevBestBir} ${exHolder.j}`:`${prevBestBir}`;
      if(nuevoBir>mejorAbsolutoBir)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto de birdies en una ronda: <b>${nuevoBir}</b> (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal de birdies en ronda: <b>${nuevoBir}</b> (${prevRef})`});
    }

    // 6. RACHA DE BIRDIES CONSECUTIVOS EN UNA RONDA
    const prevRachaBir=bestRachaBirRonda(jugador,RAW_prev,HM_prev);
    const nuevaRachaBir=bestRachaBirRonda(jugador,RAW,HM);
    if(nuevaRachaBir>prevRachaBir){
      const mejorAbsolutoRachaBir=Math.max(...PLAYERS.map(j=>bestRachaBirRonda(j,RAW_prev,HM_prev)));
      const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestRachaBirRonda(j,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
      const prevRef=exHolder&&exHolder.v===prevRachaBir?`${prevRachaBir} ${exHolder.j}`:`${prevRachaBir}`;
      if(nuevaRachaBir>mejorAbsolutoRachaBir)
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto birdies consecutivos en ronda: <b>${nuevaRachaBir}</b> hoyos (${prevRef})`});
      else
        alertas.push({prioridad:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal birdies consecutivos en ronda: <b>${nuevaRachaBir}</b> hoyos (${prevRef})`});
    }

    // 5. MEJOR AVG10 EN CADA TRAMO — solo récord absoluto
    TRAMOS_RECORDS.forEach(t=>{
      const prev=bestMejor10Tramo(jugador,RAW_prev,HM_prev,t.idxs);
      const ahora=bestMejor10Tramo(jugador,RAW,HM,t.idxs);
      if(prev===Infinity)return;
      if(ahora<prev-0.001){
        const mejorAbs=Math.min(...PLAYERS.filter(j=>j!==jugador).map(j=>bestMejor10Tramo(j,RAW_prev,HM_prev,t.idxs)));
        const exHolder=PLAYERS.filter(j=>j!==jugador).map(j=>({j,v:bestMejor10Tramo(j,RAW_prev,HM_prev,t.idxs)})).filter(x=>x.v!==Infinity).sort((a,b)=>a.v-b.v)[0];
        const prevRef=exHolder&&Math.abs(exHolder.v-prev)<0.001?`${prev.toFixed(3)} ${exHolder.j}`:`${prev.toFixed(3)}`;
        if(ahora<mejorAbs)
          alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto <i>${t.label}</i>: avg10 <b>${ahora.toFixed(3)}</b> (${prevRef})`});
      }
    });

    // 6. RÉCORD DE PARTIDO EN TRAMO — solo récord absoluto del campo
    TRAMOS_RECORDS.forEach(t=>{
      const sc=HM[ultimaJ+'_'+jugador];
      if(!sc)return;
      if(t.idxs.some(i=>sc[i]===null||sc[i]===undefined))return;
      const sumaJ=t.idxs.reduce((s,i)=>s+sc[i],0);
      // Mejor histórico del campo (todos los jugadores incluido este, sin la última jornada)
      let mejorAbs=Infinity;
      PLAYERS.forEach(j=>{
        RAW_prev.filter(r=>r.jugador===j).forEach(r=>{
          const s=HM_prev[r.j+'_'+j];
          if(!s||t.idxs.some(i=>s[i]===null||s[i]===undefined))return;
          const sm=t.idxs.reduce((x,i)=>x+s[i],0);
          if(sm<mejorAbs)mejorAbs=sm;
        });
      });
      if(sumaJ<mejorAbs){
        const split=t.idxs.map(i=>sc[i]).join('-');
        alertas.push({prioridad:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto de partido en <i>${t.label}</i>: <b>${sumaJ}</b> [${split}] (antes ${mejorAbs})`});
      }
    });
  });

  // ── ADELANTAMIENTOS en cada ranking ──
  // (Solo para los apartados clásicos. Los tramos NO generan adelantamientos.)
  const apartados=[
    {
      nombre:'Más pares en una ronda',
      fn:(jug,raw,hm)=>bestParesHist(jug,raw,hm),
      usaHM:true,
      asc:false
    },
    {
      nombre:'Más birdies en una ronda',
      fn:(jug,raw,hm)=>bestBirdiesHist(jug,raw,hm),
      usaHM:true,
      asc:false
    },
    {
      nombre:'Racha pares o mejor',
      fn:(jug,raw,hm)=>bestRachaPar(jug,raw,hm),
      usaHM:true,
      asc:false
    },
    {
      nombre:'Birdies consecutivos en ronda',
      fn:(jug,raw,hm)=>bestRachaBirRonda(jug,raw,hm),
      usaHM:true,
      asc:false
    },
    {
      nombre:'Racha sin doble dígito',
      fn:(jug,raw)=>bestRachaSinDbl(jug,raw),
      usaHM:false,
      asc:false
    }
  ];

  apartados.forEach(({nombre,fn,usaHM,asc,formato})=>{
    const fmt=formato||(v=>v);
    const antes=PLAYERS.filter(j=>HCP_DATA[j]).map(j=>({jugador:j,val:usaHM?fn(j,RAW_prev,HM_prev):fn(j,RAW_prev)}));
    const despues=PLAYERS.filter(j=>HCP_DATA[j]).map(j=>({jugador:j,val:usaHM?fn(j,RAW,HM):fn(j,RAW)}));
    const rankAntes=getRanking(antes,asc);
    const rankDespues=getRanking(despues,asc);
    jugadoresUltimaJ.forEach(jug=>{
      if(!HCP_DATA[jug])return;
      const posAntes=rankAntes[jug];
      const posDespues=rankDespues[jug];
      if(posDespues<posAntes){
        const valJug=despues.find(x=>x.jugador===jug).val;
        // Para tramos: solo cuenta si el jugador tiene valor válido (no Infinity)
        if(asc&&valJug===Infinity)return;
        const adelantados=PLAYERS.filter(j=>HCP_DATA[j]&&j!==jug&&rankAntes[j]<=posAntes&&rankDespues[j]>posDespues);
        // Filtrar adelantados con valor válido
        const adelantadosValidos=adelantados.filter(j=>{
          const v=despues.find(x=>x.jugador===j).val;
          return !asc||v!==Infinity;
        });
        if(adelantadosValidos.length){
          const adelantadosStr=adelantadosValidos.map(j=>{
            const valAdel=despues.find(x=>x.jugador===j).val;
            return `<b>${j}</b> (${fmt(valAdel)})`;
          }).join(', ');
          alertas.push({prioridad:1,tipo:'⬆️ Adelantamiento',jugador:jug,msg:`En <i>${nombre}</i> con <b>${fmt(valJug)}</b> adelanta a: ${adelantadosStr}`});
        }
      }
    });
  });

  return{ultimaJ,alertas:alertas.sort((a,b)=>a.prioridad-b.prioridad)};
}

window._analisisRecords=function(){
  const{ultimaJ,alertas}=calcAnalisisRecords();
  const el=document.getElementById('analisis-records-panel');
  if(!el)return;
  if(!alertas.length){
    el.innerHTML='<div style="color:#6b7280;font-size:12px;padding:10px">Sin novedades en records esta jornada.</div>';
    return;
  }
  let h='';
  alertas.forEach(a=>{
    h+=`<div style="display:flex;gap:8px;align-items:flex-start;padding:8px 10px;background:#fff;border-radius:8px;margin-bottom:6px;border:1px solid #e5e7eb">
      <div style="width:28px;height:28px;border-radius:6px;background:${COLORS[a.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;flex-shrink:0">${a.jugador.slice(0,3)}</div>
      <div>
        <div style="font-size:10px;font-weight:600;color:#6b7280;margin-bottom:2px">${a.tipo}</div>
        <div style="font-size:12px;color:#111"><b>${a.jugador}</b> — ${a.msg}</div>
      </div>
    </div>`;
  });
  el.innerHTML=h;
};

function renderAnalisisRecords(el){
  const{ultimaJ}=calcAnalisisRecords();
  el.innerHTML=`
    <div style="background:#fafafa;border:1px solid #e5e7eb;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="font-weight:600;font-size:13px;color:#1e3a8a;margin-bottom:10px">🔍 Análisis de records — J${ultimaJ}</div>
      <div id="analisis-records-panel"><div style="color:#aaa;font-size:12px">Cargando…</div></div>
    </div>`;
  setTimeout(window._analisisRecords,50);
}

// ── HÁNDICAP GLOBAL ──
// Para cada jugador, recoge sus actuaciones de TODOS los contextos (Super ROC RAW + Entrenamientos +
// Interclubs como individual + futuros Torneos Oficiales y Millor Jugador de l'Any), las ordena por fecha desc.
//
// Cada delta se infla por un factor según el tipo de partida (delta * (1 + factor)):
//   · IC = 0.00 (referencia limpia, sin inflación)
//   · MJA = 0.02, Oficial = 0.06, Entrenamiento = 0.10, Super ROC = 0.20
// Cuanto más informal el contexto, más se infla el delta (premio al que se moja en torneos).
//
//   · Si n >= 10: hcp = media simple de los 10 últimos deltas inflados
//   · Si n <  10: hcp = null (sin HCP hasta completar la ventana de 10 partidas)
//   · Si n == 0: hcp = null
function calcHandicapGlobal(jugador){
  const acts = [];

  // Factor de inflación del delta por tipo de partida.
  // El delta efectivo de cada partida se calcula como: delta * (1 + factor)
  // IC es la referencia limpia (medal play oficial = mérito puro). El resto se infla
  // porque tienen menos exigencia: cuanto más informal, más castigo.
  //   ic      → 0.00  (referencia, sin inflación)
  //   mja     → 0.02  (Millor Jugador de l'Any) — pendiente de registro
  //   oficial → 0.06  (Torneos oficiales)        — pendiente de registro
  //   ent     → 0.10  (entrenamientos en otros campos)
  //   roc     → 0.20  (Super ROC, los martes)
  // Ejemplo: un +6 en SR cuenta como 6×1.20 = 7.20; el mismo +6 en IC cuenta como 6.00.
  const FACTORES_TIPO = { roc: 0.20, ent: 0.10, oficial: 0.06, mja: 0.02, ic: 0.00 };

  // Super ROC RAW — todos en ROC 3
  if(typeof RAW !== 'undefined' && Array.isArray(RAW)){
    RAW.filter(r => r.jugador === jugador ).forEach(r => {
      const f = _parseFechaGlobal(r.f);
      if(f) acts.push({ fecha:f, delta:r.total, src:'roc', campo:'ROC 3' });
    });
  }

  // Entrenamientos
  if(typeof ENTRENAMIENTOS_DATA !== 'undefined' && Array.isArray(ENTRENAMIENTOS_DATA)){
    ENTRENAMIENTOS_DATA.forEach(ent => {
      ent.jornadas.forEach(jr => {
        const arr = ent.hm[`${jr.j}_${jugador}`];
        if(!arr) return;
        const tot = arr.reduce((s,v) => s + Math.min(v, 5), 0);
        const f = _parseFechaGlobal(jr.fecha);
        if(f) acts.push({ fecha:f, delta:tot - 54, src:'ent', campo:ent.campo });
      });
    });
  }

  // Interclubs: solo cuando jugó como individual
  const variantes = (typeof APODO_A_NOMBRES_IC !== 'undefined') ? APODO_A_NOMBRES_IC[jugador] : null;
  if(variantes && typeof IC !== 'undefined'){
    const matchN = (n) => variantes.some(v => n && n.includes(v));
    Object.values(IC).forEach(yd => {
      if(!yd.pruebas) return;
      yd.pruebas.forEach(p => {
        if(!p.fecha || p.total === null) return;
        const f = _parseFechaGlobal(p.fecha);
        if(!f) return;
        const indis = [];
        if(p.ind1) indis.push({n:p.ind1[0], s:p.ind1[1]}, {n:p.ind1[2], s:p.ind1[3]});
        if(p.ind2) indis.push({n:p.ind2[0], s:p.ind2[1]}, {n:p.ind2[2], s:p.ind2[3]});
        const yo = indis.find(x => matchN(x.n));
        if(yo) acts.push({ fecha:f, delta:yo.s, src:'ic', campo:p.camp });
      });
    });
  }

  if(acts.length === 0){
    return { hcp:null, n:0, trend:0, totalActs:0, weeksOff:0, factorAct:1.0, sigma:null };
  }

  acts.sort((a,b) => b.fecha - a.fecha);

  // Calcular hcp inflando cada delta por su factor de tipo y haciendo media simple.
  // Solo se calcula si hay 10 o más actuaciones; con menos se devuelve null.
  let used, hcp;
  if(acts.length >= 10){
    used = acts.slice(0, 10);
    let sumDeltaEf = 0;
    used.forEach(a => {
      const factor = FACTORES_TIPO[a.src] !== undefined ? FACTORES_TIPO[a.src] : 0;
      const deltaEfectivo = a.delta * (1 + factor);
      sumDeltaEf += deltaEfectivo;
    });
    hcp = sumDeltaEf / used.length;
  } else {
    used = acts.slice(0, acts.length);
    hcp = null;
  }

  // Hcp original (antes de penalización por inactividad). Lo guardamos para topes.
  const hcpOriginal = hcp;

  // σ (desviación estándar) sobre los deltas CRUDOS (sin ponderar) de las used.
  // Solo se considera fiable a partir de 10 partidas; si menos, devolvemos null.
  let sigma = null;
  if(used.length >= 10){
    const mediaSimple = used.reduce((s,a) => s + a.delta, 0) / used.length;
    const varianza = used.reduce((s,a) => s + Math.pow(a.delta - mediaSimple, 2), 0) / used.length;
    sigma = Math.sqrt(varianza);
  }

  // Tendencia: media ponderada (más recientes pesan más por posición) vs media simple del periodo.
  // Independiente de los pesos de tipo (mide solo la curva temporal).
  let trend = 0;
  if(used.length >= 4){
    const n = used.length;
    let twD = 0, twW = 0;
    used.forEach((a, i) => {
      const peso = n - i;
      twD += a.delta * peso;
      twW += peso;
    });
    const ponderada = twD / twW;
    const simple = used.reduce((s,a) => s + a.delta, 0) / n;
    const diff = ponderada - simple;
    if(diff < -1.0) trend = -2;
    else if(diff < -0.3) trend = -1;
    else if(diff > 1.0) trend = 2;
    else if(diff > 0.3) trend = 1;
    else trend = 0;
  }

  // Penalización por inactividad
  // 0-12 semanas → factor 1.0 (intacto)
  // semana 13+ → factor = 0.98^(semanas-12), hcp se DIVIDE por el factor (sube)
  // Topes (el primero que se cumpla detiene la subida):
  //   a) 40 semanas sin jugar (28 semanas con decay aplicado)
  //   b) hcp llega al doble del original
  //   c) hcp llega a +18, pero solo si el original era ≤ 18
  let weeksOff = 0, factorAct = 1.0;
  const masReciente = acts[0].fecha;
  const hoy = new Date();
  const diasSin = Math.max(0, Math.floor((hoy - masReciente) / (1000*60*60*24)));
  weeksOff = Math.floor(diasSin / 7);
  if(weeksOff > 12){
    const semsAplicadas = Math.min(weeksOff - 12, 28); // cap de tope (a): 40 semanas total
    factorAct = Math.pow(0.98, semsAplicadas);
  }
  if(factorAct < 1.0 && hcp !== null){
    let hcpPenalizado = hcp / factorAct;
    // Tope (b): no más del doble del original
    if(hcpPenalizado > hcpOriginal * 2) hcpPenalizado = hcpOriginal * 2;
    // Tope (c): no más de +18, pero solo si el original era ≤ 18
    if(hcpOriginal <= 18 && hcpPenalizado > 18) hcpPenalizado = 18;
    hcp = hcpPenalizado;
  }

  // Premio por variedad de campos en la ventana usada (últimas 10).
  // 1 campo = factor 1.0 (sin premio); cada campo distinto adicional suma 0.05.
  // El hcp se DIVIDE por el factor (le baja → mejora simbólicamente).
  const camposSet = new Set();
  used.forEach(a => { if(a.campo) camposSet.add(a.campo); });
  const camposDistintos = camposSet.size;
  const factorVar = 1.0 + 0.05 * Math.max(0, camposDistintos - 1);
  if(factorVar > 1.0 && hcp !== null){
    hcp = hcp / factorVar;
  }

  return {
    hcp,
    n: used.length,
    trend,
    totalActs: acts.length,
    weeksOff,
    factorAct,
    sigma,
    camposDistintos,
    factorVar,
  };
}

// Helper local para parsear "DD/MM/YYYY"
function _parseFechaGlobal(str){
  if(!str) return null;
  const parts = str.split('/');
  if(parts.length !== 3) return null;
  return new Date(+parts[2], +parts[1]-1, +parts[0]);
}

function renderHandicapGlobal(el){
  const ACTIVOS = ["Capi","Sucio","Bofa","Finestres","Luiqui","Alvaro","Cabra","David","Manolo","Kike","Pique","Albert"];
  const datos = ACTIVOS.map(j => ({ jugador:j, ...calcHandicapGlobal(j) }));

  // Ordenar de mejor (hcp menor) a peor (hcp mayor); los sin hcp al final
  const conHcp = datos.filter(d => d.hcp !== null).sort((a,b) => a.hcp - b.hcp);
  const sinHcp = datos.filter(d => d.hcp === null);
  const ordenados = conHcp.concat(sinHcp);

  const fmtHcp = (h) => {
    if(h === null || h === undefined) return '—';
    const r = Math.round(h * 10) / 10;
    if(r === 0) return 'PAR';
    return (r > 0 ? '+' : '') + (Number.isInteger(r) ? r : r.toFixed(1));
  };

  // 5 niveles de tendencia con flechas SVG estilo "sticker": cuerpo grueso, contorno negro fino, color sólido.
  //   -2 = mejora fuerte (verde brillante, arriba) │ -1 = mejora (verde, diagonal arriba)
  //    0 = estable (amarillo, recta)
  //   +1 = empeora (naranja, diagonal abajo) │ +2 = empeora fuerte (rojo, abajo)
  const trendIcon = (t) => {
    const SIZE = 28;
    const stroke = '#1a1a1a', sw = 1.5;
    const wrap = (svgInner, title) =>
      `<span style="display:inline-flex;align-items:center;margin-left:6px;line-height:1" title="${title}">` +
      `<svg width="${SIZE}" height="${SIZE}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">${svgInner}</svg>` +
      `</span>`;

    // Flecha base "vertical hacia arriba" (cabeza arriba, cuerpo abajo)
    // Se rota con transform según el caso para mantener idéntica forma en los 5 niveles.
    const flechaPath = 'M16 3 L26 14 L21 14 L21 28 L11 28 L11 14 L6 14 Z';

    if(t === -2){
      // Verde brillante, vertical ARRIBA
      return wrap(
        `<path d="${flechaPath}" fill="#22c55e" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/>`,
        'Mejorando fuerte'
      );
    }
    if(t === -1){
      // Verde claro, diagonal ARRIBA-DERECHA (rotación -45° desde "arriba")
      return wrap(
        `<g transform="rotate(45 16 16)"><path d="${flechaPath}" fill="#22d3ee" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/></g>`,
        'Mejorando suave'
      );
    }
    if(t === 0){
      // Amarillo, horizontal DERECHA (rotación 90°)
      return wrap(
        `<g transform="rotate(90 16 16)"><path d="${flechaPath}" fill="#facc15" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/></g>`,
        'Estable'
      );
    }
    if(t === 1){
      // Naranja, diagonal ABAJO-DERECHA (rotación 135°)
      return wrap(
        `<g transform="rotate(135 16 16)"><path d="${flechaPath}" fill="#f97316" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/></g>`,
        'Empeorando suave'
      );
    }
    // t === 2: rojo, vertical ABAJO (rotación 180°)
    return wrap(
      `<g transform="rotate(180 16 16)"><path d="${flechaPath}" fill="#ef4444" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/></g>`,
      'Empeorando fuerte'
    );
  };

  let h = '<div style="padding:14px 12px 6px"><div style="font-size:13px;color:#374151;margin-bottom:10px;font-weight:600">🏆 Hándicap global</div></div>';

  h += '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 12px 16px;max-width:520px">';
  ordenados.forEach((d) => {
    const tieneHcp = d.hcp !== null;
    // Fondo: color del jugador si tiene hcp completo; gris si sin hcp (n<10)
    const bg =
      !tieneHcp ? '#f3f4f6' :
                  (COLORS[d.jugador] || '#f3f4f6');
    const valColor =
      !tieneHcp ? '#9ca3af' :
      d.hcp <= 0 ? '#15803d' :
      d.hcp <= 5 ? '#1e3a8a' :
      d.hcp <= 10 ? '#92400e' :
      '#991b1b';
    const opacity = !tieneHcp ? '0.55' : '1';
    const border = '1px solid rgba(0,0,0,0.06)';
    let subText;
    if(d.n === 0) {
      subText = `sin actuaciones`;
    } else if(!tieneHcp) {
      subText = `${d.n}/10 partidas`;
    } else {
      subText = `${d.totalActs} part.`;
    }
    // Icono de consistencia (σ) en esquina superior izquierda. 4 niveles de "refugio" según volatilidad:
    //   σ < 3.0  → 🏰 castillo        (sólido, te aguanta cualquier tormenta)
    //   3.0-4.0  → 🏠 casa            (algo expuesto)
    //   4.0-5.0  → 🎪 carpa           (frágil)
    //   σ ≥ 5.0  → 📦 caja            (errático, durmiendo en la acera)
    let sigmaBadge = '';
    if(d.sigma !== null && d.sigma !== undefined){
      let icon, label;
      if(d.sigma < 3.0)      { icon = '🏰'; label = `Castillo — sólido (σ ${d.sigma.toFixed(2)})`; }
      else if(d.sigma < 4.0) { icon = '🏠'; label = `Casa — algo expuesto (σ ${d.sigma.toFixed(2)})`; }
      else if(d.sigma < 5.0) { icon = '🎪'; label = `Carpa — frágil (σ ${d.sigma.toFixed(2)})`; }
      else                   { icon = '📦'; label = `Caja — errático, en la acera (σ ${d.sigma.toFixed(2)})`; }
      sigmaBadge = `<span style="font-size:16px;line-height:1;margin-left:4px" title="${label}">${icon}</span>`;
    }
    h += `
      <div style="position:relative;background:${bg};border-radius:14px;padding:12px 8px 14px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:108px;opacity:${opacity};border:${border}">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#1a1a1a;margin-bottom:6px">${d.jugador}</div>
        <div style="display:flex;align-items:center;justify-content:center">
          <span style="font-family:'Fraunces',serif;font-size:40px;font-weight:700;color:${valColor};line-height:1;letter-spacing:-0.5px">${fmtHcp(d.hcp)}</span>
          ${tieneHcp ? trendIcon(d.trend) : ''}
          ${sigmaBadge}
        </div>
        <div style="font-size:9px;color:#6b7280;margin-top:6px;letter-spacing:0.2px">${subText}</div>
      </div>`;
  });
  h += '</div>';

  // ─────── LEYENDA: Consistencia σ + Tendencia ───────
  h += '<div style="margin:0 0 14px;max-width:520px;box-sizing:border-box;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 12px">';

  // Bloque 1 — iconos σ (consistencia)
  h += '<div style="background:#fafaf5;border:1px solid #e5e7eb;border-radius:8px;padding:8px 10px">';
  h += '<div style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">🧱 Consistencia (σ)</div>';
  h += '<div style="font-size:11px;color:#555;line-height:1.6">';
  h += '<div>🏰 <b>Castillo</b> · σ &lt; 3 · sólido, te aguanta cualquier tormenta</div>';
  h += '<div>🏠 <b>Casa</b> · σ 3–4 · algo expuesto</div>';
  h += '<div>🎪 <b>Carpa</b> · σ 4–5 · frágil, se mueve con el viento</div>';
  h += '<div>📦 <b>Caja</b> · σ ≥ 5 · muy irregular, cualquier ráfaga la tumba</div>';
  h += '</div>';
  h += '<div style="font-size:10px;color:#888;margin-top:6px;line-height:1.4">σ = desviación típica de los deltas vs par 54. Sólo se calcula con n≥10 partidas. Aparece en la esquina superior izquierda de la card.</div>';
  h += '</div>';

  // Bloque 2 — flechas de tendencia
  h += '<div style="background:#fafaf5;border:1px solid #e5e7eb;border-radius:8px;padding:8px 10px">';
  h += '<div style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">↗ Tendencia</div>';
  h += '<div style="font-size:11px;color:#555;line-height:1.6">';
  h += '<div><span style="display:inline-block;width:10px;height:10px;background:#22c55e;border:1px solid #1a1a1a;border-radius:2px;vertical-align:middle;margin-right:4px"></span><b>↑ Mejorando fuerte</b> · ganas más de 1 golpe</div>';
  h += '<div><span style="display:inline-block;width:10px;height:10px;background:#22d3ee;border:1px solid #1a1a1a;border-radius:2px;vertical-align:middle;margin-right:4px"></span><b>↗ Mejorando suave</b> · ganas algo</div>';
  h += '<div><span style="display:inline-block;width:10px;height:10px;background:#facc15;border:1px solid #1a1a1a;border-radius:2px;vertical-align:middle;margin-right:4px"></span><b>→ Estable</b> · te mantienes</div>';
  h += '<div><span style="display:inline-block;width:10px;height:10px;background:#f97316;border:1px solid #1a1a1a;border-radius:2px;vertical-align:middle;margin-right:4px"></span><b>↘ Empeorando suave</b> · cedes algo</div>';
  h += '<div><span style="display:inline-block;width:10px;height:10px;background:#ef4444;border:1px solid #1a1a1a;border-radius:2px;vertical-align:middle;margin-right:4px"></span><b>↓ Empeorando fuerte</b> · cedes más de 1 golpe</div>';
  h += '</div>';
  h += '<div style="font-size:10px;color:#888;margin-top:6px;line-height:1.4">Compara la media ponderada (más peso a partidas recientes) contra la media simple. Aparece a la derecha del HCP.</div>';
  h += '</div>';

  h += '</div>';
  // ─────── FIN LEYENDA ───────

  // ─────── BLOQUE EXPLICATIVO DEL CÁLCULO ───────
  h += '<div style="margin:18px 0 16px;max-width:520px;background:#fafaf5;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px;font-size:12px;color:#374151;line-height:1.5;box-sizing:border-box">';
  h += '<div style="font-size:13px;font-weight:700;color:#1a1a1a;margin-bottom:10px;letter-spacing:0.3px">🧮 Cálculo del hándicap global</div>';

  // Intro
  h += '<div style="margin-bottom:14px;color:#555">El HCP se calcula sobre las <b>últimas 10 actuaciones</b> del jugador, combinando todos los contextos: Super ROC, Entrenamientos, Interclubs, Torneos Oficiales y Millor Jugador de l\'Any. <b>No se asigna HCP hasta completar 10 partidas</b> en la ventana.</div>';

  // ─── Sección 1: Factor por contexto ───
  h += '<div style="margin-top:14px;padding-top:12px;border-top:1px dashed #d1d5db">';
  h += '<div style="font-weight:600;color:#1a1a1a;margin-bottom:6px">📐 Factor por contexto</div>';
  h += '<div style="color:#6b7280;font-size:11px;margin-bottom:8px">Cada delta vs par 54 se infla según el contexto: <code style="background:#f3f4f6;padding:1px 5px;border-radius:3px">delta × (1 + factor)</code>. IC es la referencia limpia (sin inflación) y los demás se inflan porque tienen menos exigencia.</div>';
  h += '<table style="width:100%;border-collapse:collapse;font-size:11.5px;margin-bottom:6px">';
  h += '<thead><tr style="background:#f3f4f6;color:#374151"><th style="text-align:left;padding:6px 8px;border:1px solid #e5e7eb">Contexto</th><th style="text-align:center;padding:6px 8px;border:1px solid #e5e7eb">Factor</th><th style="text-align:center;padding:6px 8px;border:1px solid #e5e7eb">Multiplicador</th><th style="text-align:right;padding:6px 8px;border:1px solid #e5e7eb">+6 cuenta como…</th></tr></thead>';
  h += '<tbody>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">🌍 Interclubs</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.00</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">×1.00</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>6.00</b></td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">🥇 Millor Jugador de l\'Any</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.02</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">×1.02</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>6.12</b></td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">🏆 Torneos Oficiales</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.06</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">×1.06</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>6.36</b></td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">🏋️ Entrenamientos</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.10</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">×1.10</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>6.60</b></td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">🎯 Super ROC</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.20</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">×1.20</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>7.20</b></td></tr>';
  h += '</tbody></table>';
  h += '<div style="font-size:10.5px;color:#888;font-style:italic">Nota: el factor se aplica también a deltas negativos. Un −2 en SR se convierte en −2.4 → jugar bien en contextos exigentes premia más.</div>';
  h += '</div>';

  // ─── Sección 2: Oxidación por inactividad ───
  h += '<div style="margin-top:14px;padding-top:12px;border-top:1px dashed #d1d5db">';
  h += '<div style="font-weight:600;color:#1a1a1a;margin-bottom:6px">🛢️ Oxidación por inactividad</div>';
  h += '<div style="color:#6b7280;font-size:11px;margin-bottom:8px">Si pasa tiempo desde tu última partida, el HCP se infla. Las primeras 12 semanas son gratis (período de gracia). A partir de ahí: <code style="background:#f3f4f6;padding:1px 5px;border-radius:3px">factor = 0.98^(semanas − 12)</code> y el HCP se divide por ese factor.</div>';
  h += '<table style="width:100%;border-collapse:collapse;font-size:11.5px;margin-bottom:6px">';
  h += '<thead><tr style="background:#f3f4f6;color:#374151"><th style="text-align:left;padding:6px 8px;border:1px solid #e5e7eb">Semanas off</th><th style="text-align:center;padding:6px 8px;border:1px solid #e5e7eb">Factor</th><th style="text-align:right;padding:6px 8px;border:1px solid #e5e7eb">HCP base 6.0 →</th></tr></thead>';
  h += '<tbody>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">0–12 <span style="color:#16a34a;font-size:10px">(gracia)</span></td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.00</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">6.00</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">13–15</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.98 → 0.94</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">6.12 → 6.38</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">16–19</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.92 → 0.87</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">6.51 → 6.91</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">20–23</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.85 → 0.80</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">7.05 → 7.49</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">24–27</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.78 → 0.74</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">7.65 → 8.12</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">28–31</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.72 → 0.68</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">8.29 → 8.81</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">32–35</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.67 → 0.63</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">8.99 → 9.55</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">36–39</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">0.62 → 0.58</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">9.74 → 10.35</td></tr>';
  h += '<tr style="background:#fef3c7"><td style="padding:5px 8px;border:1px solid #e5e7eb"><b>40+</b> <span style="color:#a16207;font-size:10px">(cap)</span></td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>0.57</b></td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace"><b>10.55</b></td></tr>';
  h += '</tbody></table>';
  h += '<div style="font-size:10.5px;color:#888;font-style:italic">Topes (el primero que se cumpla detiene la oxidación): 40 semanas · doble del HCP original · +18 si el original era ≤18.</div>';
  h += '</div>';

  // ─── Sección 3: Adaptabilidad de campo ───
  h += '<div style="margin-top:14px;padding-top:12px;border-top:1px dashed #d1d5db">';
  h += '<div style="font-weight:600;color:#1a1a1a;margin-bottom:6px">⛳ Adaptabilidad de campo</div>';
  h += '<div style="color:#6b7280;font-size:11px;margin-bottom:8px">Premio por rotación: si en tus últimas 10 actuaciones has pisado varios campos distintos, el HCP se reduce. Cada campo extra suma 0.05 al factor: <code style="background:#f3f4f6;padding:1px 5px;border-radius:3px">factor = 1 + 0.05 × (campos − 1)</code> y el HCP se divide.</div>';
  h += '<table style="width:100%;border-collapse:collapse;font-size:11.5px;margin-bottom:6px">';
  h += '<thead><tr style="background:#f3f4f6;color:#374151"><th style="text-align:left;padding:6px 8px;border:1px solid #e5e7eb">Campos distintos</th><th style="text-align:center;padding:6px 8px;border:1px solid #e5e7eb">Factor</th><th style="text-align:right;padding:6px 8px;border:1px solid #e5e7eb">Reducción</th></tr></thead>';
  h += '<tbody>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">1 campo</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.00</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">0%</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">2 campos</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.05</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">−4.8%</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">3 campos</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.10</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">−9.1%</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">4 campos</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.15</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">−13.0%</td></tr>';
  h += '<tr><td style="padding:5px 8px;border:1px solid #e5e7eb">5 campos</td><td style="text-align:center;padding:5px 8px;border:1px solid #e5e7eb">1.20</td><td style="text-align:right;padding:5px 8px;border:1px solid #e5e7eb;font-family:monospace">−16.7%</td></tr>';
  h += '</tbody></table>';
  h += '<div style="font-size:10.5px;color:#888;font-style:italic">Filosofía: el jugador que rota campos demuestra adaptabilidad y se le recompensa simbólicamente.</div>';
  h += '</div>';

  h += '</div>';
  // ─────── FIN BLOQUE EXPLICATIVO ───────

  el.innerHTML = h;
}

function renderHandicap(el){
  const sorted=[...PLAYERS].filter(p=>HCP_DATA[p]).sort((a,b)=>HCP_DATA[a].current-HCP_DATA[b].current);

  let h=`<div style="font-weight:500;color:#555;margin-bottom:8px;font-size:12px">Clasificación actual</div>`;
  const droppingResult={};
  sorted.forEach(q=>{
    const games=RAW.filter(r=>r.jugador===q).sort((a,b)=>a.j-b.j);
    const dropIdx=games.length-10;
    droppingResult[q]=dropIdx>=0?games[dropIdx]:null;
  });

  sorted.forEach((p,i)=>{
    const d=HCP_DATA[p];
    const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':'';
    const hcpColor=d.current<=5?'#15803d':d.current<=8?'#0e7490':d.current<=11?'#c2410c':'#991b1b';
    const hist=d.history.filter(x=>x.hcp!==null);
    const trend=hist.length>=2?hist[hist.length-1].hcp-hist[hist.length-2].hcp:0;
    const trendTxt=trend<-0.3?`▼ ${Math.abs(trend).toFixed(2)}`:trend>0.3?`▲ ${trend.toFixed(2)}`:'—';
    const trendColor=trend<-0.3?'#15803d':trend>0.3?'#b91c1c':'#aaa';
    const drop=droppingResult[p];
    const dropTxt=drop?(drop.total>=0?'+'+drop.total:''+drop.total):null;
    const dropLabel=dropTxt?' ('+dropTxt+')':'';
    h+=`<div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:${i<3?'#f0fdfa':'#fff'};border-radius:9px;margin-bottom:5px;border:1px solid #e5e7eb">
      <div style="width:22px;font-size:13px;text-align:center">${medal||i+1}</div>
      <div style="width:28px;height:28px;border-radius:5px;background:${COLORS[p]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.slice(0,3)}</div>
      <div style="flex:1"><div style="font-weight:500;font-size:11px">${p}</div><div style="font-size:10px;color:#aaa">${d.n} partidos · mejor ${d.best>=0?'+'+d.best:d.best} (${d.best_f})</div></div>
      <div style="font-size:18px;font-weight:500;color:${hcpColor};min-width:42px;text-align:right">${d.current>=0?'+'+d.current:d.current}</div>
      <div style="font-size:11px;font-weight:500;color:${trendColor};text-align:right">${trendTxt}<span style="font-size:10px;color:#aaa;font-weight:400">${dropLabel}</span></div>
    </div>`;
  });
  // Semanas como número 1 — calculado desde HCP_DATA history
  const todasJornadas=[...new Set(RAW.map(r=>r.j))].sort((a,b)=>a-b);
  // J_INICIO: primera jornada en que al menos 3 jugadores han completado 10 partidos
  let J_INICIO=todasJornadas[0];
  for(const j of todasJornadas){
    const con10=PLAYERS.filter(p=>RAW.filter(r=>r.jugador===p&&r.j<=j).length>=10).length;
    if(con10>=3){J_INICIO=j;break;}
  }
  const jornadasValidas=todasJornadas.filter(j=>j>=J_INICIO);

  // Usamos SOLO el hcp exacto del history en esa jornada (no interpolamos)
  // Si un jugador no tiene punto en esa jornada, usamos el último anterior
  // PERO solo si tiene al menos 10 partidos jugados hasta esa jornada
  function hcpEnJornada(jugador,j){
    const hist=(HCP_DATA[jugador]?.history||[]).filter(h=>h.hcp!==null).sort((a,b)=>a.j-b.j);
    // Necesita haber jugado al menos 10 partidos hasta esa jornada
    const partidosHasta=RAW.filter(r=>r.jugador===jugador&&r.j<=j).length;
    if(partidosHasta<10)return null;
    let ultimo=null;
    for(const h of hist){if(h.j<=j)ultimo=h.hcp;else break;}
    return ultimo;
  }

  const numUnoMap={};
  jornadasValidas.forEach(j=>{
    let minHcp=Infinity;
    PLAYERS.forEach(p=>{
      const h=hcpEnJornada(p,j);
      if(h!==null&&Math.round(h*100)<Math.round(minHcp*100))minHcp=h;
    });
    if(minHcp===Infinity)return;
    const minRound=Math.round(minHcp*100);
    PLAYERS.forEach(p=>{
      const h=hcpEnJornada(p,j);
      if(h!==null&&Math.round(h*100)===minRound){
        if(!numUnoMap[p])numUnoMap[p]={actual:[]};
        numUnoMap[p].actual.push(j);
      }
    });
  });

  const numUnoCalc=Object.entries(numUnoMap).map(([jugador,d])=>{
    const js=d.actual.sort((a,b)=>a-b);
    // Racha máxima histórica
    let maxConsec=1,cur=1;
    for(let i=1;i<js.length;i++){
      const idxA=todasJornadas.indexOf(js[i-1]);
      const idxB=todasJornadas.indexOf(js[i]);
      if(idxB===idxA+1){cur++;maxConsec=Math.max(maxConsec,cur);}
      else cur=1;
    }
    // Racha actual (desde el final hacia atrás)
    let actualConsec=1;
    for(let i=js.length-1;i>0;i--){
      const idxA=todasJornadas.indexOf(js[i-1]);
      const idxB=todasJornadas.indexOf(js[i]);
      if(idxB===idxA+1)actualConsec++;
      else break;
    }
    // Si la última jornada como nº1 no es la última jornada disputada, racha actual=0
    const ultimaJornada=todasJornadas[todasJornadas.length-1];
    if(js[js.length-1]!==ultimaJornada)actualConsec=0;
    const desde='J'+js[0];
    const hasta='J'+js[js.length-1];
    return{jugador,semanas:js.length,maxConsec,actualConsec,desde,hasta};
  }).sort((a,b)=>b.semanas-a.semanas);

  h+=`<div style="font-weight:500;color:#555;margin:16px 0 8px;font-size:12px">Semanas como nº 1 <span style="font-size:10px;color:#aaa;font-weight:400">(desde J${J_INICIO} · cuando 3 jugadores alcanzaron 10 partidos)</span></div>`;
  numUnoCalc.forEach((p,i)=>{
    h+=`<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:${i===0?'#f0fdf4':'#fff'};border-radius:9px;margin-bottom:4px;border:1px solid #e5e7eb">
      <div style="width:28px;height:28px;border-radius:5px;background:${COLORS[p.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.jugador.slice(0,3)}</div>
      <div style="flex:1;font-weight:500;font-size:11px">${p.jugador}</div>
      <div style="font-size:10px;color:#aaa;margin-right:4px">${p.desde}→${p.hasta}</div>
      <div style="font-weight:700;font-size:16px;color:#0f766e;min-width:28px;text-align:right">${p.semanas}</div>
      <div style="text-align:right"><div style="font-size:11px;color:#1e40af;font-weight:500">${p.maxConsec} consec. récord</div><div style="font-size:10px;color:#aaa">${p.actualConsec} ahora</div></div>
    </div>`;
  });
  // ── Panel análisis records al final ──
  const ultimaJ=Math.max(...RAW.map(r=>r.j));
  const fechaUltimaJ=(RAW.find(r=>r.j===ultimaJ)||{}).f||'';
  h+=`<div style="margin-top:18px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:12px 14px">
    <div style="font-weight:600;font-size:12px;color:#1e3a8a;margin-bottom:8px">🔍 Novedades en records — J${ultimaJ} · ${fechaUltimaJ}</div>
    <div id="analisis-records-panel" style="font-size:12px;color:#aaa">Calculando…</div>
  </div>`;

  el.innerHTML='<div style="max-width:50%;min-width:320px">'+h+'</div>';
  setTimeout(window._analisisRecords,50);
}

function renderBitacora(el){
  // Helpers (reutilizamos los mismos de calcAnalisisRecords)
  function getPares(jugador,j,hmObj){const s=hmObj[j+'_'+jugador];return s?s.filter(v=>v===3).length:0;}
  function bestParesHist(jugador,rawData,hmObj){let max=0;rawData.filter(r=>r.jugador===jugador).forEach(r=>{const p=getPares(jugador,r.j,hmObj);if(p>max)max=p;});return max;}
  function bestRachaPar(jugador,rawData,hmObj){const PAR=3;const partidas=rawData.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);let maxR=0,cur=0;partidas.forEach(p=>{const scores=hmObj[p.j+'_'+jugador];if(!scores)return;scores.forEach(v=>{if(v===null)return;if(v<=PAR){cur++;if(cur>maxR)maxR=cur;}else cur=0;});});return maxR;}
  function bestRachaSinDbl(jugador,rawData){const partidas=rawData.filter(r=>r.jugador===jugador).sort((a,b)=>a.j-b.j);let maxR=0,cur=0;partidas.forEach(p=>{if(p.total<10){cur++;if(cur>maxR)maxR=cur;}else cur=0;});return maxR;}
  function getRanking(arr){const sorted=[...arr].sort((a,b)=>b.val-a.val);const rank={};sorted.forEach((x,i)=>rank[x.jugador]=i);return rank;}

  // Calcular análisis para cada jornada
  const todasJornadas=[...new Set(RAW.map(r=>r.j))].sort((a,b)=>a-b);

  function analisisJornada(j){
    const rawJ_all=RAW.filter(r=>r.j===j);
    const fecha=rawJ_all[0]?.f||'';
    const jugadoresJ=new Set(rawJ_all.map(r=>r.jugador));
    const RAW_prev=RAW.filter(r=>r.j<j);
    const HM_prev={};Object.keys(HM).forEach(k=>{if(parseInt(k.split('_')[0])<j)HM_prev[k]=HM[k];});
    const RAW_hasta=RAW.filter(r=>r.j<=j);
    const HM_hasta={};Object.keys(HM).forEach(k=>{if(parseInt(k.split('_')[0])<=j)HM_hasta[k]=HM[k];});

    const alertas=[];

    jugadoresJ.forEach(jugador=>{
      const rawJug=RAW.find(r=>r.j===j&&r.jugador===jugador);
      if(!rawJug)return;

      // Score
      const prevBest=RAW_prev.filter(r=>r.jugador===jugador).reduce((m,r)=>Math.min(m,r.total),Infinity);
      if(rawJug.total<prevBest&&prevBest!==Infinity){
        const mejorAbs=RAW_prev.reduce((m,r)=>Math.min(m,r.total),Infinity);
        const exH=PLAYERS.filter(x=>x!==jugador).map(x=>({x,v:RAW_prev.filter(r=>r.jugador===x).reduce((m,r)=>Math.min(m,r.total),Infinity)})).sort((a,b)=>a.v-b.v)[0];
        const ref=exH&&exH.v===prevBest?`${prevBest>=0?'+'+prevBest:prevBest} ${exH.x}`:`${prevBest>=0?'+'+prevBest:prevBest}`;
        if(rawJug.total<mejorAbs) alertas.push({p:0,tipo:'✅ Récord absoluto',jugador,msg:`Nuevo récord absoluto de score: <b>${rawJug.total>=0?'+'+rawJug.total:rawJug.total}</b> (${ref})`});
        else alertas.push({p:2,tipo:'📊 Marca personal',jugador,msg:`Bate su marca personal de score: <b>${rawJug.total>=0?'+'+rawJug.total:rawJug.total}</b> (${ref})`});
      }

      // Pares
      const prevP=bestParesHist(jugador,RAW_prev,HM_prev);
      const nuevoP=getPares(jugador,j,HM_hasta);
      if(nuevoP>prevP){
        const absP=Math.max(0,...PLAYERS.map(x=>bestParesHist(x,RAW_prev,HM_prev)));
        const exH=PLAYERS.filter(x=>x!==jugador).map(x=>({x,v:bestParesHist(x,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
        const ref=exH&&exH.v===prevP?`${prevP} ${exH.x}`:`${prevP}`;
        if(nuevoP>absP) alertas.push({p:0,tipo:'✅ Récord absoluto',jugador,msg:`Récord absoluto pares en ronda: <b>${nuevoP}</b> (${ref})`});
        else alertas.push({p:2,tipo:'📊 Marca personal',jugador,msg:`Marca personal pares en ronda: <b>${nuevoP}</b> (${ref})`});
      }

      // Racha pares o mejor
      const prevRP=bestRachaPar(jugador,RAW_prev,HM_prev);
      const nuevoRP=bestRachaPar(jugador,RAW_hasta,HM_hasta);
      if(nuevoRP>prevRP){
        const absRP=Math.max(0,...PLAYERS.map(x=>bestRachaPar(x,RAW_prev,HM_prev)));
        const exH=PLAYERS.filter(x=>x!==jugador).map(x=>({x,v:bestRachaPar(x,RAW_prev,HM_prev)})).sort((a,b)=>b.v-a.v)[0];
        const ref=exH&&exH.v===prevRP?`${prevRP} ${exH.x}`:`${prevRP}`;
        if(nuevoRP>absRP) alertas.push({p:0,tipo:'✅ Récord absoluto',jugador,msg:`Récord absoluto racha pares o mejor: <b>${nuevoRP}</b> hoyos (${ref})`});
        else alertas.push({p:2,tipo:'📊 Marca personal',jugador,msg:`Marca personal racha pares o mejor: <b>${nuevoRP}</b> hoyos (${ref})`});
      }

      // Racha sin doble dígito
      const prevRD=bestRachaSinDbl(jugador,RAW_prev);
      const nuevoRD=bestRachaSinDbl(jugador,RAW_hasta);
      if(nuevoRD>prevRD){
        const absRD=Math.max(0,...PLAYERS.map(x=>bestRachaSinDbl(x,RAW_prev)));
        const exH=PLAYERS.filter(x=>x!==jugador).map(x=>({x,v:bestRachaSinDbl(x,RAW_prev)})).sort((a,b)=>b.v-a.v)[0];
        const ref=exH&&exH.v===prevRD?`${prevRD} ${exH.x}`:`${prevRD}`;
        if(nuevoRD>absRD) alertas.push({p:0,tipo:'✅ Récord absoluto',jugador,msg:`Récord absoluto racha sin doble dígito: <b>${nuevoRD}</b> jornadas (${ref})`});
        else alertas.push({p:2,tipo:'📊 Marca personal',jugador,msg:`Marca personal racha sin doble dígito: <b>${nuevoRD}</b> jornadas (${ref})`});
      }
    });

    // Adelantamientos
    const apartados=[
      {nombre:'Pares en ronda',fn:(jug,raw,hm)=>bestParesHist(jug,raw,hm),usaHM:true},
      {nombre:'Racha pares o mejor',fn:(jug,raw,hm)=>bestRachaPar(jug,raw,hm),usaHM:true},
      {nombre:'Racha sin doble dígito',fn:(jug,raw)=>bestRachaSinDbl(jug,raw),usaHM:false},
    ];
    apartados.forEach(({nombre,fn,usaHM})=>{
      const antes=PLAYERS.filter(x=>HCP_DATA[x]).map(x=>({jugador:x,val:usaHM?fn(x,RAW_prev,HM_prev):fn(x,RAW_prev)}));
      const despues=PLAYERS.filter(x=>HCP_DATA[x]).map(x=>({jugador:x,val:usaHM?fn(x,RAW_hasta,HM_hasta):fn(x,RAW_hasta)}));
      const rA=getRanking(antes),rD=getRanking(despues);
      jugadoresJ.forEach(jug=>{
        if(!HCP_DATA[jug])return;
        if(rD[jug]<rA[jug]){
          const valJug=despues.find(x=>x.jugador===jug).val;
          const adelantados=PLAYERS.filter(x=>HCP_DATA[x]&&x!==jug&&rA[x]<=rA[jug]&&rD[x]>rD[jug]);
          if(adelantados.length){
            const str=adelantados.map(x=>`<b>${x}</b> (${despues.find(d=>d.jugador===x).val})`).join(', ');
            alertas.push({p:1,tipo:'⬆️ Adelantamiento',jugador:jug,msg:`En <i>${nombre}</i> con <b>${valJug}</b> adelanta a: ${str}`});
          }
        }
      });
    });

    alertas.sort((a,b)=>a.p-b.p);

    // Clasificación HCP en esta jornada
    const hcpEnJ={};
    PLAYERS.forEach(jug=>{
      const d=HCP_DATA[jug];
      if(!d)return;
      const hist=[...d.history].filter(x=>x.j<=j);
      if(hist.length) hcpEnJ[jug]=hist[hist.length-1].hcp;
    });
    const clasificacion=Object.entries(hcpEnJ).sort((a,b)=>a[1]-b[1]);

    // Jugadores que jugaron / no jugaron
    const jugaron=[...rawJ_all.map(r=>r.jugador)];
    const noJugaron=PLAYERS.filter(p=>HCP_DATA[p]&&!jugaron.includes(p));

    return{j,fecha,alertas,clasificacion,jugaron,noJugaron};
  }

  function renderClasificacionCompleta(j){
    const isLatest=(j===Math.max(...RAW.map(r=>r.j)));

    // Calcular HCP en el momento de la jornada j para cada jugador
    function hcpAtJ(jugador,jj){
      const d=HCP_DATA[jugador];
      if(!d)return null;
      const hist=[...d.history].filter(x=>x.hcp!==null&&x.j<=jj);
      if(!hist.length)return null;
      return hist[hist.length-1].hcp;
    }

    // Jugadores con HCP conocido en esta jornada
    const playersWithHcp=PLAYERS.filter(p=>HCP_DATA[p]&&hcpAtJ(p,j)!==null);
    const sorted=[...playersWithHcp].sort((a,b)=>hcpAtJ(a,j)-hcpAtJ(b,j));

    // Partidos jugados hasta j inclusive
    const droppingResult={};
    sorted.forEach(q=>{
      const games=RAW.filter(r=>r.jugador===q&&r.j<=j).sort((a,b)=>a.j-b.j);
      const dropIdx=games.length-10;
      droppingResult[q]=dropIdx>=0?games[dropIdx]:null;
    });

    const labelClas=isLatest?'Clasificación actual':`Clasificación tras J${j}`;
    let h=`<div style="font-weight:500;color:#555;margin-bottom:8px;font-size:12px">${labelClas}</div>`;
    sorted.forEach((p,i)=>{
      const d=HCP_DATA[p];
      const hcpVal=hcpAtJ(p,j);
      const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':'';
      const hcpColor=hcpVal<=5?'#15803d':hcpVal<=8?'#0e7490':hcpVal<=11?'#c2410c':'#991b1b';
      // Tendencia: hcp anterior a j
      const histBefore=d.history.filter(x=>x.hcp!==null&&x.j<j);
      const prevHcp=histBefore.length?histBefore[histBefore.length-1].hcp:null;
      const trend=prevHcp!==null?hcpVal-prevHcp:0;
      const trendTxt=trend<-0.3?`▼ ${Math.abs(trend).toFixed(2)}`:trend>0.3?`▲ ${trend.toFixed(2)}`:'—';
      const trendColor=trend<-0.3?'#15803d':trend>0.3?'#b91c1c':'#aaa';
      // Partidos jugados hasta j
      const nAtJ=RAW.filter(r=>r.jugador===p&&r.j<=j).length;
      // Mejor resultado hasta j
      const bestAtJ=RAW.filter(r=>r.jugador===p&&r.j<=j).reduce((m,r)=>Math.min(m,r.total),Infinity);
      const bestStr=bestAtJ===Infinity?'—':(bestAtJ>=0?'+'+bestAtJ:''+bestAtJ);
      const drop=droppingResult[p];
      const dropTxt=drop?(drop.total>=0?'+'+drop.total:''+drop.total):null;
      const dropLabel=dropTxt?' ('+dropTxt+')':'';
      h+=`<div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:${i<3?'#f0fdfa':'#fff'};border-radius:9px;margin-bottom:5px;border:1px solid #e5e7eb">
        <div style="width:22px;font-size:13px;text-align:center">${medal||i+1}</div>
        <div style="width:28px;height:28px;border-radius:5px;background:${COLORS[p]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.slice(0,3)}</div>
        <div style="flex:1"><div style="font-weight:500;font-size:11px">${p}</div><div style="font-size:10px;color:#aaa">${nAtJ} partidos · mejor ${bestStr}</div></div>
        <div style="font-size:18px;font-weight:500;color:${hcpColor};min-width:42px;text-align:right">${hcpVal>=0?'+'+hcpVal:hcpVal}</div>
        <div style="font-size:11px;font-weight:500;color:${trendColor};text-align:right">${trendTxt}<span style="font-size:10px;color:#aaa;font-weight:400">${dropLabel}</span></div>
      </div>`;
    });

    // Semanas nº1 — calculado hasta la jornada j
    const todasJAll=[...new Set(RAW.map(r=>r.j))].sort((a,b)=>a-b);
    const todasJHasta=todasJAll.filter(x=>x<=j);
    const J_INICIO=(function(){
      for(const jj of todasJAll){
        const con10=PLAYERS.filter(p=>RAW.filter(r=>r.jugador===p&&r.j<=jj).length>=10).length;
        if(con10>=3)return jj;
      }
      return todasJAll[0];
    })();
    const jornadasValidas=todasJHasta.filter(x=>x>=J_INICIO);
    function hcpEnJLocal(jugador,jj){
      const hist=(HCP_DATA[jugador]?.history||[]).filter(h=>h.hcp!==null).sort((a,b)=>a.j-b.j);
      const partidos=RAW.filter(r=>r.jugador===jugador&&r.j<=jj).length;
      if(partidos<10)return null;
      let ultimo=null;
      for(const h of hist){if(h.j<=jj)ultimo=h.hcp;else break;}
      return ultimo;
    }
    const numUnoMap={};
    jornadasValidas.forEach(jj=>{
      let minHcp=Infinity;
      PLAYERS.forEach(p=>{const hh=hcpEnJLocal(p,jj);if(hh!==null&&Math.round(hh*100)<Math.round(minHcp*100))minHcp=hh;});
      if(minHcp===Infinity)return;
      const minR=Math.round(minHcp*100);
      PLAYERS.forEach(p=>{const hh=hcpEnJLocal(p,jj);if(hh!==null&&Math.round(hh*100)===minR){if(!numUnoMap[p])numUnoMap[p]={actual:[]};numUnoMap[p].actual.push(jj);}});
    });
    const ultimaJornada=todasJHasta[todasJHasta.length-1];
    const numUnoCalc=Object.entries(numUnoMap).map(([jugador,d])=>{
      const js=d.actual.sort((a,b)=>a-b);
      let maxConsec=1,cur=1;
      for(let i=1;i<js.length;i++){const iA=todasJAll.indexOf(js[i-1]),iB=todasJAll.indexOf(js[i]);if(iB===iA+1){cur++;maxConsec=Math.max(maxConsec,cur);}else cur=1;}
      let actualConsec=1;
      for(let i=js.length-1;i>0;i--){const iA=todasJAll.indexOf(js[i-1]),iB=todasJAll.indexOf(js[i]);if(iB===iA+1)actualConsec++;else break;}
      if(js[js.length-1]!==ultimaJornada)actualConsec=0;
      return{jugador,semanas:js.length,maxConsec,actualConsec,desde:'J'+js[0],hasta:'J'+js[js.length-1]};
    }).sort((a,b)=>b.semanas-a.semanas);

    h+=`<div style="font-weight:500;color:#555;margin:16px 0 8px;font-size:12px">Semanas como nº 1 <span style="font-size:10px;color:#aaa;font-weight:400">(desde J${J_INICIO})</span></div>`;
    numUnoCalc.forEach((p,i)=>{
      h+=`<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:${i===0?'#f0fdf4':'#fff'};border-radius:9px;margin-bottom:4px;border:1px solid #e5e7eb">
        <div style="width:28px;height:28px;border-radius:5px;background:${COLORS[p.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#333;flex-shrink:0">${p.jugador.slice(0,3)}</div>
        <div style="flex:1;font-weight:500;font-size:11px">${p.jugador}</div>
        <div style="font-size:10px;color:#aaa;margin-right:4px">${p.desde}→${p.hasta}</div>
        <div style="font-weight:700;font-size:16px;color:#0f766e;min-width:28px;text-align:right">${p.semanas}</div>
        <div style="text-align:right"><div style="font-size:11px;color:#1e40af;font-weight:500">${p.maxConsec} consec. récord</div><div style="font-size:10px;color:#aaa">${p.actualConsec} ahora</div></div>
      </div>`;
    });
    return h;
  }

  // Render
  let h='<div style="max-width:560px">';
  h+=`<div style="font-weight:600;font-size:13px;color:#1a1a1a;margin-bottom:16px">📓 Cuaderno de bitácora — Super ROC</div>`;

  const ultimaJornada=Math.max(...todasJornadas);
  const jornadasInv=[...todasJornadas].reverse();

  jornadasInv.forEach(j=>{
    const{fecha,alertas,clasificacion,jugaron,noJugaron}=analisisJornada(j);

    const tieneNovedades=alertas.length>0;
    const borderColor=tieneNovedades?'#bfdbfe':'#e5e7eb';
    const bgHeader=tieneNovedades?'#1e3a8a':'#6b7280';

    h+=`<div style="border:1px solid ${borderColor};border-radius:12px;margin-bottom:16px;overflow:hidden">`;

    // Cabecera jornada
    const tieneCronica=!!CRONICAS[j];
    h+=`<div style="background:${bgHeader};padding:10px 14px;display:flex;align-items:center;gap:10px">
      <span style="font-size:13px;font-weight:700;color:#fff">J${j}</span>
      <span style="font-size:12px;color:#cbd5e1">${fecha}</span>
      ${tieneCronica?`<span onclick="openCronica(${j})" style="cursor:pointer;font-size:16px;line-height:1;padding:2px 4px;border-radius:4px;background:rgba(255,255,255,0.15);transition:background 0.15s" onmouseover="this.style.background='rgba(255,255,255,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'" title="Ver crónica">📰</span>`:''}
      <div style="margin-left:auto;display:flex;gap:4px;flex-wrap:wrap">
        ${jugaron.map(jug=>`<span style="font-size:10px;font-weight:600;padding:2px 7px;border-radius:10px;background:${COLORS[jug]||'#eee'};color:#333">${jug}</span>`).join('')}
      </div>
    </div>`;

    // Clasificación — completa para todas las jornadas
    h+=`<div style="padding:10px 14px;border-bottom:1px solid #e5e7eb">${renderClasificacionCompleta(j)}</div>`;

    // Novedades
    if(alertas.length){
      h+=`<div style="padding:10px 14px">`;
      alertas.forEach(a=>{
        const bgAlerta=a.p===0?'#eff6ff':a.p===1?'#f0fdf4':'#fefce8';
        const borderAlerta=a.p===0?'#bfdbfe':a.p===1?'#bbf7d0':'#fde68a';
        h+=`<div style="display:flex;gap:8px;align-items:flex-start;padding:7px 10px;background:${bgAlerta};border:1px solid ${borderAlerta};border-radius:8px;margin-bottom:5px">
          <div style="width:26px;height:26px;border-radius:5px;background:${COLORS[a.jugador]||'#eee'};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;flex-shrink:0">${a.jugador.slice(0,3)}</div>
          <div>
            <div style="font-size:10px;font-weight:600;color:#6b7280;margin-bottom:1px">${a.tipo}</div>
            <div style="font-size:11px;color:#111"><b>${a.jugador}</b> — ${a.msg}</div>
          </div>
        </div>`;
      });
      h+=`</div>`;
    } else {
      h+=`<div style="padding:8px 14px;font-size:11px;color:#9ca3af;font-style:italic">Sin novedades en records esta jornada.</div>`;
    }

    // No jugaron
    if(noJugaron.length){
      h+=`<div style="padding:6px 14px 8px;font-size:10px;color:#aaa">❌ No jugaron: ${noJugaron.join(', ')}</div>`;
    }

    h+=`</div>`;
  });

  h+='</div>';
  el.innerHTML=h;
}

function renderComandos(el){
  el.innerHTML=`
  <div style="max-width:480px">
    <div style="font-weight:600;font-size:13px;color:#1a1a1a;margin-bottom:14px">⚙️ Comandos Claude — Super ROC</div>

    <!-- TAREAS PENDIENTES (recordatorios para Capi) -->
    <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
        <span style="font-size:18px">📌</span>
        <span style="font-weight:600;font-size:13px;color:#92400e">TAREAS PENDIENTES</span>
        <span style="font-size:11px;color:#a16207;font-weight:400">(recordatorios para Capi)</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <div style="display:flex;align-items:flex-start;gap:8px;background:#fff;border-radius:8px;padding:10px 12px;border:1px solid #fde68a">
          <span style="font-size:14px;line-height:1.4">☐</span>
          <div style="font-size:12px;color:#374151;line-height:1.5">
            <b>Copa Roc&Roll en el HCP global</b> — añadir como contexto en el cálculo del hándicap global, contando con el mismo factor que Interclubs (factor 0, referencia limpia).
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:8px;background:#fff;border-radius:8px;padding:10px 12px;border:1px solid #fde68a">
          <span style="font-size:14px;line-height:1.4">☐</span>
          <div style="font-size:12px;color:#374151;line-height:1.5">
            <b>Partidos del sábado · Mulligans</b> — meter los partidos jugados con los Mulligans este sábado.
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:8px;background:#fff;border-radius:8px;padding:10px 12px;border:1px solid #fde68a">
          <span style="font-size:14px;line-height:1.4">☐</span>
          <div style="font-size:12px;color:#374151;line-height:1.5">
            <b>Cabecera de Hoyos</b> — en el título "Todo lo que quiso saber sobre las estadísticas hoyo por hoyo…", quitar la coletilla de "clasificación por mejor ventana de 10 vueltas · jugadores con n&lt;10 atenuados al final".
          </div>
        </div>
      </div>
    </div>

    <!-- VERIFICA FOTO -->
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">📸</span>
        <span style="font-weight:600;font-size:13px;color:#15803d">VERIFICA FOTO</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        Sube la foto de la jornada (tarjeta física o pantalla del marcador).<br>
        Claude lee los scores <b>hoyo a hoyo</b> y genera una <b>tarjeta visual</b> con colores por jugador para confirmar antes de procesar.
      </div>
      <div style="margin-top:8px;font-size:11px;color:#6b7280;background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #d1fae5">
        ⚠️ <b>X en pantalla = 5 golpes</b> (máximo permitido por hoyo)
      </div>
    </div>

    <!-- CHECKLIST -->
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
        <span style="font-size:18px">✅</span>
        <span style="font-weight:600;font-size:13px;color:#1d4ed8">CHECKLIST</span>
        <span style="font-size:11px;color:#6b7280;font-weight:400">(tras OK del usuario)</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px">
        ${[
          ['1','RAW','Datos brutos de la jornada (total, front, back, birdies, pares, bogeys, dobles)'],
          ['2','HM','Scores hoyo a hoyo en el objeto HM'],
          ['3','HCP_DATA','Hándicap actualizado: n + current + best'],
          ['4','Semanas nº1','Ranking de semanas liderando el campeonato'],
          ['5','Tendencias','Evolución del hándicap en history[]'],
          ['6','Records','Actualizar si hay nuevas marcas personales o grupales'],
          ['7','Estadísticas','Tabla general de la jornada (medias, mejor, peor)'],
          ['8','Crónica','Clasificación general ordenada + quién jugó/no jugó → redactar crónica estilo Super ROC mencionando a todos'],
        ].map(([n,t,d])=>`
        <div style="display:flex;align-items:flex-start;gap:8px;background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #dbeafe">
          <div style="width:20px;height:20px;border-radius:50%;background:#1d4ed8;color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px">${n}</div>
          <div><div style="font-weight:600;font-size:12px;color:#1e3a8a">${t}</div><div style="font-size:11px;color:#6b7280">${d}</div></div>
        </div>`).join('')}
      </div>
    </div>

    <!-- CRÓNICA -->
    <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">📝</span>
        <span style="font-weight:600;font-size:13px;color:#c2410c">CRÓNICA</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        Antes de escribir, verificar siempre:<br>
        <div style="margin-top:6px;display:flex;flex-direction:column;gap:4px">
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fed7aa;font-size:11px">1. Ordenar <b>HCP_DATA</b> por <b>current</b> → clasificación correcta</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fed7aa;font-size:11px">2. Mirar <b>RAW</b> de la jornada → quién jugó y quién no</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fed7aa;font-size:11px">3. Mencionar a <b>todos</b> los jugadores (jugaron o no)</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fed7aa;font-size:11px">4. Estilo: humor, pasión, fútbol, apodos, sin cortarse</div>
        </div>
      </div>
    </div>

    <!-- TRAMOS Y HOYOS -->
    <div style="background:#fdf4ff;border:1px solid #e9d5ff;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">🏁</span>
        <span style="font-weight:600;font-size:13px;color:#6b21a8">PESTAÑAS TRAMOS Y HOYOS</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        <div style="margin-bottom:6px"><b>🏁 Tramos</b> — 4 secciones con clasificación mejor avg10 + récord de partido individual:</div>
        <div style="display:flex;flex-direction:column;gap:3px;margin-bottom:8px">
          <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #e9d5ff;font-size:11px">🚀 Arranque <b>H1-H2-H3</b></div>
          <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #e9d5ff;font-size:11px">🙏 Amen Corner <b>H7-H8-H9</b></div>
          <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #e9d5ff;font-size:11px">🌹 Camino de rosas <b>H3-H4-H5</b></div>
          <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #e9d5ff;font-size:11px">🏁 Sprint final <b>H16-H17-H18</b></div>
        </div>
        <div style="margin-bottom:6px"><b>⛳ Hoyos</b> — radiografía de los 18 hoyos con clasificación por jugador (mejor ventana de 10) y resumen estadístico al final.</div>
        <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #e9d5ff;font-size:11px;color:#6b21a8">
          ⚙️ Constantes en código: <b>TRAMOS_FIJOS</b> (definición de tramos) y <b>HOYO_APODOS</b> (apodos de cada hoyo, H9 = "El más cabrón")
        </div>
      </div>
    </div>

    <!-- NOVEDADES EN RECORDS -->
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">🔍</span>
        <span style="font-weight:600;font-size:13px;color:#1d4ed8">NOVEDADES EN RECORDS — qué se detecta</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        <div style="margin-bottom:6px"><b>6 apartados clásicos</b> (récord absoluto + marca personal + adelantamiento):</div>
        <div style="display:flex;flex-direction:column;gap:3px;margin-bottom:8px">
          <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #dbeafe;font-size:11px">1. Score · 2. Pares en ronda · 3. <b>Birdies en ronda</b> · 4. Racha pares · 5. <b>Birdies consecutivos</b> · 6. Racha sin doble dígito</div>
        </div>
        <div style="margin-bottom:6px"><b>4 tramos del campo</b> (solo récord absoluto):</div>
        <div style="background:#fff;border-radius:6px;padding:5px 10px;border:1px solid #dbeafe;font-size:11px;margin-bottom:6px">Mejor avg10 del tramo · Récord de partido individual en el tramo</div>
        <div style="background:#fef3c7;border-radius:6px;padding:6px 10px;border:1px solid #fde68a;font-size:11px;color:#92400e">
          ⚠️ Tramos NO generan marcas personales ni adelantamientos — solo récord absoluto del campo
        </div>
      </div>
    </div>

    <!-- REGLA GENERAL CÁLCULO AUTOMÁTICO -->
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">⚡</span>
        <span style="font-weight:600;font-size:13px;color:#15803d">REGLA GENERAL — Cálculo automático</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        <b>Todo lo que se pueda calcular desde los datos, lo calcula el código. Nunca Claude a mano.</b>
        <div style="margin-top:6px;display:flex;flex-direction:column;gap:4px">
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #bbf7d0;font-size:11px">✅ Rachas actuales → calculadas desde <b>HM</b> en JavaScript</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #bbf7d0;font-size:11px">✅ Records → calculados desde <b>RAW + HM</b></div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #bbf7d0;font-size:11px">✅ Clasificación → calculada desde <b>HCP_DATA</b></div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #bbf7d0;font-size:11px">❌ Claude solo introduce datos nuevos: <b>RAW + HM</b> de cada jornada</div>
        </div>
      </div>
    </div>

    <!-- REGLA ABANDONOS -->
    <div style="background:#fef2f2;border:2px solid #fca5a5;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">🛡️</span>
        <span style="font-weight:600;font-size:13px;color:#991b1b">SOBRE LOS ABANDONOS</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        Los abandonos <b>no existen en el modelo de datos</b>. Si un jugador abandona, su entry simplemente <b>no se anota</b> (ni en RAW ni en HM): es como si no hubiera jugado esa jornada.
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px"><b style="color:#991b1b">❌ No hay campo <code>abandono</code> en RAW/HM:</b> ninguna entry, ningún filtro, ningún cálculo lo contempla</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px"><b style="color:#15803d">✅ Notación histórica visual:</b> el array <code style="background:#fef2f2;padding:1px 4px;border-radius:3px">ABANDONOS_REGISTRADOS</code> sólo se pinta en Records, sección "🛡️ Abandonos", como recuerdo manual. No afecta a nada.</div>
        </div>
        <div style="margin-top:8px;background:#fffbeb;border-radius:6px;padding:6px 10px;border:1px solid #fde68a;font-size:11px;color:#92400e">
          ⚙️ Para dejar constancia visual de un abandono: añadir manualmente una línea <code style="background:#fff;padding:1px 4px;border-radius:3px">{ jugador, j, f }</code> al array <code style="background:#fff;padding:1px 4px;border-radius:3px">ABANDONOS_REGISTRADOS</code>.
        </div>
      </div>
    </div>

    <!-- AUDITORÍA -->
    <div style="background:#fef2f2;border:2px solid #fca5a5;border-radius:12px;padding:14px 16px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:18px">🔬</span>
        <span style="font-weight:600;font-size:13px;color:#991b1b">AUDITORÍA — paso obligatorio antes de entregar</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        <b>Tras cada jornada nueva, antes de entregar HTML+Excel, Claude ejecuta auditoria.js en bash.</b>
        El script extrae <b>RAW</b> y <b>HCP_HISTORY</b> del HTML y recalcula desde cero todos los HCPs publicados, comparando contra los valores grabados en el archivo. Si hay discrepancias, se reportan jugador a jugador con la jornada y el delta.
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px">1. Extraer RAW (regex whitespace-tolerant) y HCP_HISTORY de cada jugador</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px">2. Para cada entrada {j:N, hcp:X.X}, recalcular desde RAW: media de las últimas 10 partidas hasta J=N</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px">3. Comparar publicado vs calculado con tolerancia 0.05 (redondeo a 1 decimal)</div>
          <div style="background:#fff;border-radius:6px;padding:6px 10px;border:1px solid #fecaca;font-size:11px">4. Si hay diferencias graves (Δ&gt;0.5) → mostrar bloque del bash al usuario y pedir validación antes de cerrar</div>
        </div>
        <div style="margin-top:8px;background:#fffbeb;border-radius:6px;padding:6px 10px;border:1px solid #fde68a;font-size:11px;color:#92400e">
          ⚠️ <b>La auditoría se ejecuta en bash visible</b>, no de palabra. Si el bloque de tool_use no aparece en chat, el paso no está hecho.
        </div>
      </div>
    </div>

    <!-- FLUJO -->
    <div style="background:#fefce8;border:1px solid #fde68a;border-radius:12px;padding:12px 16px;margin-bottom:12px">
      <div style="font-weight:600;font-size:12px;color:#92400e;margin-bottom:6px">📋 Flujo de trabajo</div>
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <span style="background:#fff;border:1px solid #fde68a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:500">📸 VERIFICA FOTO</span>
        <span style="color:#92400e;font-size:16px">→</span>
        <span style="background:#fff;border:1px solid #fde68a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:500">✅ OK usuario</span>
        <span style="color:#92400e;font-size:16px">→</span>
        <span style="background:#fff;border:1px solid #fde68a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:500">⚙️ CHECKLIST</span>
        <span style="color:#92400e;font-size:16px">→</span>
        <span style="background:#fef2f2;border:1px solid #fca5a5;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:600;color:#991b1b">🔬 AUDITORÍA</span>
        <span style="color:#92400e;font-size:16px">→</span>
        <span style="background:#fff;border:1px solid #fde68a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:500">📝 CRÓNICA</span>
      </div>
    </div>

    <!-- REGLAS HCP -->
    <div style="background:#fdf4ff;border:1px solid #e9d5ff;border-radius:12px;padding:12px 16px">
      <div style="font-weight:600;font-size:12px;color:#7c3aed;margin-bottom:8px">🏅 Reglas de Hándicap</div>
      <div style="font-size:12px;color:#374151;line-height:1.7">
        • Ventana de <b>últimos 10 partidos</b><br>
        • Si hay menos de 10: <b>media aritmética</b> de todos<br>
        • <b>X en tarjeta = 5 golpes</b> (máximo por hoyo)<br>
        • El hándicap se expresa en golpes sobre par total de 18 hoyos
      </div>
    </div>

    <!-- CONVOCATORIA SUGERIDA -->
    <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:14px 16px;margin-top:12px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
        <span style="font-size:18px">🎯</span>
        <span style="font-weight:600;font-size:13px;color:#c2410c">CONVOCATORIA SUGERIDA — entrenamientos</span>
      </div>
      <div style="font-size:12px;color:#374151;line-height:1.6">
        El sistema sugiere automáticamente quién va a Indis, Parejas y Banquillo en cada bloque de entrenamiento, usando 5 señales ponderadas según el nº de jornadas en el campo.
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">⚠ Filtros hard</div>
      <div style="font-size:12px;color:#374151;line-height:1.6;margin-top:2px">
        <b>1) 0 entrenamientos en el campo → banquillo automático.</b> La asistencia es prerequisito.<br>
        <b>2) 🤝 Compromiso &lt; 50% de la media del equipo (últimos 3 meses) → banquillo automático.</b> No se puede ser titular sin venir.
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">🤝 Compromiso (lastre por baja asistencia)</div>
      <div style="font-size:12px;color:#374151;line-height:1.6;margin-top:2px">
        Se calcula la <b>media de partidas</b> del equipo en los últimos 3 meses (Super ROC + entrenamientos).
        Los jugadores por debajo de la media arrastran un <b>lastre proporcional al déficit</b>:
        <div style="margin-top:6px;font-size:11px;background:#fff;border-radius:6px;padding:8px 10px;border:1px solid #fed7aa;font-family:monospace">
          lastre = (déficit / media) × 0.5<br>
          score_final = score × (1 − lastre)
        </div>
        <div style="margin-top:6px;font-size:11px">
          • Cuanto más colgado en la cola → más lastre.<br>
          • &lt; 50% media → banquillo automático directamente (filtro hard).
        </div>
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">📊 Las 5 señales</div>
      <div style="font-size:12px;color:#374151;line-height:1.7;margin-top:2px">
        🎯 <b>Avg en el campo</b> · media delta vs par 54, regresada al Hcp Global cuando muestra es pequeña (k=3)<br>
        🛡️ <b>Floor</b> · peor delta del jugador en el campo (consistencia)<br>
        🐦 <b>Birdies/ronda</b> · media de birdies (incl. HiO) por jornada (explosividad)<br>
        ⏱️ <b>Asistencia</b> · curva con retornos decrecientes: 1 visita=50%, 2=75%, 3=88%, 4+→100%<br>
        🆔 <b>Hándicap global</b> · media de las últimas 10 actuaciones del jugador (Super ROC + entrenos + IC indi por fecha). Solo si tiene ≥10 partidas
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">⚖️ Pesos (n = nº entrenos en el campo)</div>
      <div style="margin-top:4px;font-size:11px;color:#374151;background:#fff;border-radius:6px;padding:8px 10px;border:1px solid #fed7aa">
        <div style="font-weight:600;color:#c2410c;margin-bottom:3px">scoreINDI (premia consistencia)</div>
        <table style="width:100%;font-size:11px;border-collapse:collapse">
          <tr style="color:#9a3412"><td>n</td><td>🎯avg</td><td>⏱️asist</td><td>🛡️floor</td><td>🆔hcp</td></tr>
          <tr><td>1</td><td>40</td><td>30</td><td>15</td><td>15</td></tr>
          <tr><td>2</td><td>45</td><td>28</td><td>14</td><td>13</td></tr>
          <tr><td>3</td><td>50</td><td>25</td><td>13</td><td>12</td></tr>
          <tr><td>≥4</td><td>56</td><td>22</td><td>12</td><td>10</td></tr>
        </table>
        <div style="font-weight:600;color:#c2410c;margin:8px 0 3px">scorePAREJA (premia explosividad — fourball)</div>
        <table style="width:100%;font-size:11px;border-collapse:collapse">
          <tr style="color:#9a3412"><td>n</td><td>🎯avg</td><td>⏱️asist</td><td>🐦bir</td><td>🛡️floor</td><td>🆔hcp</td></tr>
          <tr><td>1</td><td>30</td><td>30</td><td>12</td><td>10</td><td>18</td></tr>
          <tr><td>2</td><td>35</td><td>28</td><td>16</td><td>6</td><td>15</td></tr>
          <tr><td>3</td><td>40</td><td>25</td><td>20</td><td>4</td><td>11</td></tr>
          <tr><td>≥4</td><td>46</td><td>22</td><td>22</td><td>2</td><td>8</td></tr>
        </table>
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">🔢 Algoritmo jerárquico</div>
      <div style="font-size:12px;color:#374151;line-height:1.7;margin-top:2px">
        <b>1.</b> Calcular <b>scoreIndi</b> para todos los asistentes<br>
        <b>2.</b> Top 4 → <b>Indis</b> (3 titulares + 1 comodín atenuado)<br>
        <b>3.</b> Quitar esos 4 del pool · calcular <b>scorePareja</b> en los restantes<br>
        <b>4.</b> Hasta los 4 siguientes → <b>Parejas</b>. Si el nº es impar, también aparecen (no se penaliza a quien viene). El capitán decide composición.<br>
        <b>5.</b> Resto (sin datos + 9º en adelante con datos) → <b>Banquillo</b>
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">🧪 Normalización a escala 0-100</div>
      <div style="font-size:12px;color:#374151;line-height:1.6;margin-top:2px">
        Deltas vs par: <b>−3 → 100 puntos · +15 → 0 puntos</b> (interpolación lineal).<br>
        Birdies/ronda: <b>0 → 0 · 5 → 100</b>.<br>
        Asistencia: ratio × 100. Histórico IC: ya en escala 0-100.<br>
        <b>Si una señal es null, su peso se redistribuye al resto</b> — no penaliza al que no tenga datos.
      </div>

      <div style="margin-top:10px;font-weight:600;font-size:12px;color:#9a3412">⚡ Implicación clave</div>
      <div style="font-size:12px;color:#374151;line-height:1.6;margin-top:2px">
        Hacer muchos birdies <b>NO</b> te manda a parejas. El algoritmo es jerárquico: primero se quedan los top 4 más consistentes en Indis. Solo entre los sobrantes los birdies suben en valor (porque en fourball los picos ganan hoyos).
      </div>
    </div>

  </div>`;
}

// ── Modal de crónica ──
function openCronica(j){
  const cronica=CRONICAS[j];
  if(!cronica)return;
  const fecha=(RAW.find(r=>r.j===j)||{}).f||'';
  const overlay=document.getElementById('cronica-overlay');
  const titulo=document.getElementById('cronica-titulo');
  const cuerpo=document.getElementById('cronica-cuerpo');
  titulo.textContent=`📰 Crónica · J${j} · ${fecha}`;
  // Parseo markdown ligero: **bold**, líneas vacías como párrafos, - como bullets
  let html=cronica
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>')
    .replace(/\*([^*]+)\*/g,'<i>$1</i>');
  // Bullets simples: líneas que empiezan por -
  const lineas=html.split('\n');
  const out=[];
  let inList=false;
  lineas.forEach(l=>{
    const t=l.trim();
    if(/^-\s+/.test(t)){
      if(!inList){out.push('<ul style="margin:8px 0 8px 18px;padding:0">');inList=true;}
      out.push(`<li style="margin-bottom:4px">${t.replace(/^-\s+/,'')}</li>`);
    } else {
      if(inList){out.push('</ul>');inList=false;}
      if(t==='')out.push('<div style="height:8px"></div>');
      else out.push(`<div style="margin-bottom:6px">${t}</div>`);
    }
  });
  if(inList)out.push('</ul>');
  cuerpo.innerHTML=out.join('');
  overlay.style.display='flex';
}
function closeCronica(){
  document.getElementById('cronica-overlay').style.display='none';
}
document.addEventListener('keydown',e=>{
  if(e.key==='Escape')closeCronica();
});

/* ============================================================
   ENTRENAMIENTO — módulo aislado en IIFE
   Acordeón: cada entreno (campo + jornada Interclubs) es un bloque
   colapsable. Más reciente arriba expandido, anteriores plegados.
   Encapsulado para evitar colisión con HM, JORNADAS globales
   ============================================================ */

// Mapeo apodo → fragmentos de nombre que pueden aparecer en el histórico IC.
// Declarado a scope GLOBAL para que calcHandicapGlobal (fuera del IIFE) pueda usarlo.
const APODO_A_NOMBRES_IC = {
  Capi:      ['Ferran Lobón'],
  Sucio:     ['Ferran Esteller'],
  Bofa:      ['Quim Bofarull'],
  Finestres: ['Quim Pallares', 'Quim Pallarès'],
  Luiqui:    ['Lluis Carrera'],
  Alvaro:    ['Alvaro Jiménez', 'Alvaro Jimenez'],
  Cabra:     ['Jordi García Cabra', 'Jordi Garcia Cabra'],
  David:     ['David Peñalver'],
  Manolo:    ['Manuel Gómez', 'Manuel Gomez'],
  Kike:      ['Enrique Caro'],
  Pique:     ['Oscar Pique'],
  Albert:    ['Albert Bedos'],
};

// Lista de entrenamientos. Para añadir uno nuevo: APPEND al final del array.
// Declarado a scope GLOBAL para que calcHandicapGlobal pueda mezclar las jornadas
// de entrenamiento con las de RAW e IC al calcular el hándicap.
const ENTRENAMIENTOS_DATA = [];

// ═══════════════════════════════════════════════════════════════════════
// RANKING — pendiente de alimentar por Capi
// ═══════════════════════════════════════════════════════════════════════
// Estructura prevista: igual que ENTRENAMIENTOS pero con datos de ranking.
// Cuando Capi proporcione el primer ranking, se rellenará el array y
// renderRanking lo mostrará con el mismo formato visual que Entrenamiento.
const RANKING_DATA = [];

function renderRanking(el){
