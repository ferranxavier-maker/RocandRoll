    el.innerHTML = `
      <div style="max-width:600px;margin:60px auto;text-align:center;color:#666">
        <div style="font-size:48px;margin-bottom:16px;opacity:0.5">📊</div>
        <h3 style="font-size:18px;font-weight:600;color:#1a1a1a;margin-bottom:8px">Aún no hay ranking</h3>
        <p style="font-size:13px;line-height:1.5">Cuando Capi alimente el primer ranking, aparecerá aquí con la misma estructura que la pestaña de Entrenamientos.</p>
      </div>`;
    return;
  }
  // TODO: cuando RANKING_DATA tenga datos, replicar la maquinaria de
  // renderEntrenamiento (cuadraditos por jugador + jornadas con tarjetas).
  el.innerHTML = `<div style="padding:20px">Ranking cargado — implementación pendiente con datos reales.</div>`;
}

// ═══════════════════════════════════════════════════════════════════════
// TORNEOS OFICIALES — pendiente de alimentar por Capi
// ═══════════════════════════════════════════════════════════════════════
// Estructura prevista: igual que ENTRENAMIENTOS pero con resultados de
// torneos oficiales. Factor 0.06 en el cálculo del HCP global.
const TORNEOS_DATA = [];

function renderTorneos(el){
  if(TORNEOS_DATA.length === 0){
    el.innerHTML = `
      <div style="max-width:600px;margin:60px auto;text-align:center;color:#666">
        <div style="font-size:48px;margin-bottom:16px;opacity:0.5">🏆</div>
        <h3 style="font-size:18px;font-weight:600;color:#1a1a1a;margin-bottom:8px">Aún no hay torneos oficiales</h3>
        <p style="font-size:13px;line-height:1.5">Cuando Capi alimente el primer torneo oficial, aparecerá aquí con la misma estructura que la pestaña de Entrenamientos.</p>
      </div>`;
    return;
  }
  // TODO: cuando TORNEOS_DATA tenga datos, replicar la maquinaria de
  // renderEntrenamiento (cuadraditos por jugador + jornadas con tarjetas).
  el.innerHTML = `<div style="padding:20px">Torneos cargados — implementación pendiente con datos reales.</div>`;
}

(function(){
  const ENT_JUGADORES = ["Capi","Sucio","Bofa","Finestres","Luiqui","Alvaro","Cabra","David","Manolo","Kike","Pique","Albert"];
  const ENT_PAR_HOYO  = 3;
  const ENT_PAR_CAMPO = 54;
  const ENT_MAX_HOYO  = 5;

  // Pesos del score compuesto. Dos perfiles distintos según el slot:
  //
  //   INDI (los 4 individuales del Interclubs - stroke play medal):
  //     Premia consistencia. Floor importa porque un día malo te hunde.
  //
  //   PAREJA (las 2 parejas del Interclubs - fourball/mejor bola):
  //     Premia explosividad. Birdies/ronda > Floor porque los picos ganan
  //     hoyos cuando solo cuenta la mejor bola entre los dos.
  //
  // Suma 100 en cada columna. Más entrenos → más peso al avg-campo,
  // menos al histórico IC. Asistencia se mantiene alta (decisión cultural).
  const WEIGHTS_INDI_BY_N = {
    1:    {avg:40, asist:30, floor:15, hcp:15},
    2:    {avg:45, asist:28, floor:14, hcp:13},
    3:    {avg:50, asist:25, floor:13, hcp:12},
    'inf':{avg:56, asist:22, floor:12, hcp:10},
  };
  const WEIGHTS_PAREJA_BY_N = {
    1:    {avg:30, asist:30, bir:12, floor:10, hcp:18},
    2:    {avg:35, asist:28, bir:16, floor:6,  hcp:15},
    3:    {avg:40, asist:25, bir:20, floor:4,  hcp:11},
    'inf':{avg:46, asist:22, bir:22, floor:2,  hcp:8},
  };
  function getWeights(n, modo){
    const tabla = modo === 'pareja' ? WEIGHTS_PAREJA_BY_N : WEIGHTS_INDI_BY_N;
    if(n <= 0) return null;
    if(n === 1) return tabla[1];
    if(n === 2) return tabla[2];
    if(n === 3) return tabla[3];
    return tabla['inf'];
  }

  // Lista de entrenamientos. Se empuja al global ENTRENAMIENTOS_DATA para que
  // calcHandicapGlobal (fuera del IIFE) pueda acceder a estas jornadas también.
  ENTRENAMIENTOS_DATA.push(
    {
      id: 'canal_olimpic_j5_2026',
      campo: 'Canal Olímpic',
      jornadaInterclubs: 5,
      fecha: '28/04/2026',
      jornadas: [
        {j:1, fecha:"28/04/2026"},
        {j:2, fecha:"29/04/2026"},
        {j:3, fecha:"30/04/2026"},
      ],
      hm: {
        // J1 · 28/04/2026
        "1_Capi":   [2,4,3,3,4,3,3,4,4,3,4,2,4,4,3,3,2,3],
        "1_Bofa":   [3,5,5,3,3,4,4,4,3,5,2,4,3,4,3,4,3,2],
        "1_Luiqui": [2,4,3,3,4,2,2,3,4,4,3,4,5,3,3,2,2,4],
        "1_Alvaro": [2,5,4,3,3,4,3,3,5,3,3,3,3,2,2,3,3,2],
        "1_Albert": [3,3,5,3,3,4,2,3,3,5,3,4,3,2,3,2,3,4],
        // J2 · 29/04/2026
        "2_Capi":   [3,4,3,4,4,2,3,4,4,3,3,4,3,4,3,3,3,3],
        "2_Albert": [3,3,3,3,2,4,3,3,3,3,3,3,2,3,3,3,2,3],
        "2_Alvaro": [3,3,4,3,1,4,3,2,3,3,3,3,2,3,3,2,4,3],
        "2_Luiqui": [3,3,5,3,3,3,3,3,3,4,3,3,3,4,3,3,3,2],
        // J3 · 30/04/2026
        "3_Sucio":  [3,2,2,3,3,3,3,3,3,5,2,3,3,3,3,3,2,4],
        "3_Capi":   [3,4,3,2,3,3,3,3,2,3,3,3,3,3,3,3,2,3],
        "3_Pique":  [3,2,4,5,4,3,3,3,4,3,4,4,3,3,4,3,2,3],
        "3_Bofa":   [3,5,3,3,3,3,3,3,5,3,5,4,3,3,4,3,3,4],
      },
    },
  );
  // Alias local: la mayoría del código del IIFE usa ENTRENAMIENTOS, mantenemos compatibilidad.
  const ENTRENAMIENTOS = ENTRENAMIENTOS_DATA;

  function totalJornada(entreno, j, jugador){
    const arr = entreno.hm[`${j}_${jugador}`];
    if(!arr) return null;
    return arr.reduce((s,v) => s + Math.min(v, ENT_MAX_HOYO), 0);
  }

  function countScores(entreno, j, jugador){
    const arr = entreno.hm[`${j}_${jugador}`];
    if(!arr) return null;
    let bir=0, par=0, bog=0, dbl=0;
    arr.forEach(v => {
      if(v <= 2) bir++;
      else if(v === 3) par++;
      else if(v === 4) bog++;
      else dbl++;
    });
    return {bir, par, bog, dbl};
  }

  function statsJugador(entreno, jugador){
    const totales = entreno.jornadas
      .map(jr => totalJornada(entreno, jr.j, jugador))
      .filter(t => t !== null);
    if(totales.length === 0) return { avg:null, n:0, delta:null };
    const avg = totales.reduce((s,v) => s+v, 0) / totales.length;
    return { avg, n: totales.length, delta: avg - ENT_PAR_CAMPO };
  }

  // ── Señales del score compuesto ──────────────────────────────────────

  // 🎯 Avg en este campo REGRESADA al HCP Global cuando hay poca muestra.
  //    Fórmula: avg_efectivo = (n × avg_campo + k × hcp_global) / (n + k)
  //    con k=3 (constante de regresión).
  //
  //    Idea: el HCP global cuenta como "k partidos imaginarios" jugados a
  //    nivel medio. Con poca muestra (n bajo), tira el HCP global. Con muchos
  //    partidos en el campo, el avg-campo domina y el HCP global se diluye.
  //
  //    Si el jugador no tiene HCP global calculable, devolvemos el avg-campo
  //    crudo (sin regresión), porque no hay "prior" con el que mezclar.
  const REGRESION_K = 3;
  function calcAvgCampoDelta(entreno, jugador){
    const s = statsJugador(entreno, jugador);
    if(s.delta === null || s.n === 0) return null;
    // Intentar mezclar con HCP global
    if(typeof calcHandicapGlobal === 'function'){
      const hg = calcHandicapGlobal(jugador);
      if(hg && hg.hcp !== null && hg.hcp !== undefined){
        return (s.n * s.delta + REGRESION_K * hg.hcp) / (s.n + REGRESION_K);
      }
    }
    // Sin prior: avg crudo
    return s.delta;
  }
  // 🎯 Avg-campo CRUDO (sin regresión) — para mostrar en breakdown/tooltip
  function calcAvgCampoDeltaCrudo(entreno, jugador){
    const s = statsJugador(entreno, jugador);
    return s.delta;
  }

  // 🛡️ Floor = peor delta del jugador en este campo (max delta).
  function calcFloorCampoDelta(entreno, jugador){
    const totales = entreno.jornadas
      .map(jr => totalJornada(entreno, jr.j, jugador))
      .filter(t => t !== null);
    if(totales.length === 0) return null;
    return Math.max(...totales) - ENT_PAR_CAMPO;
  }

  // ⏱️ Asistencia opción A: ratio asistencias / jornadas-del-campo.
  //    Bonus +20% si asistió a TODAS las jornadas (premia consistencia).
  // ⏱️ Asistencia con CURVA DE RETORNOS DECRECIENTES sobre el nº de visitas.
  //    Fórmula: 1 − 0.5^visitas  (capeado a 1.0)
  //
  //    visitas → asistencia (0-1)
  //       0    → 0.00   (no vino nunca)
  //       1    → 0.50   (vino 1 vez, ya tiene la mitad)
  //       2    → 0.75
  //       3    → 0.875
  //       4    → 0.9375
  //       5+   → ~1.00
  //
  //    Ventaja sobre el ratio asistidas/total:
  //    NO penaliza al jugador por jornadas a las que no fue convocado.
  //    Premia haber venido (ya con 1 vez tiene mucho), pero recompensa
  //    venir más con retornos decrecientes (cada visita extra suma menos).
  function calcAsistenciaCampo(entreno, jugador){
    const visitas = entreno.jornadas
      .filter(jr => entreno.hm[`${jr.j}_${jugador}`] !== undefined).length;
    if(visitas === 0) return 0;
    return 1 - Math.pow(0.5, visitas);
  }

  // 📊 Forma últimos 5: media de delta de las 5 actuaciones más recientes
  //    mezclando RAW Super ROC + jornadas de TODOS los entrenamientos.
  //    Las pruebas IC no entran porque no tienen fecha exacta en el HTML.
  function _parseFecha(str){
    // "DD/MM/YYYY" → Date
    if(!str) return null;
    const parts = str.split('/');
    if(parts.length !== 3) return null;
    return new Date(+parts[2], +parts[1]-1, +parts[0]);
  }
  function calcFormaUltimos5(jugador){
    const actuaciones = [];
    // Super ROC (RAW global)
    if(typeof RAW !== 'undefined' && Array.isArray(RAW)){
      RAW.filter(r => r.jugador === jugador ).forEach(r => {
        const fecha = _parseFecha(r.f);
        if(fecha) actuaciones.push({ fecha, delta: r.total, src:'roc' });
      });
    }
    // Todos los entrenamientos (todos los bloques de ENTRENAMIENTOS)
    ENTRENAMIENTOS.forEach(ent => {
      ent.jornadas.forEach(jr => {
        const total = totalJornada(ent, jr.j, jugador);
        if(total !== null){
          const fecha = _parseFecha(jr.fecha);
          if(fecha) actuaciones.push({ fecha, delta: total - ENT_PAR_CAMPO, src:'ent' });
        }
      });
    });
    // Interclubs: solo cuando el jugador jugó como individual (su delta personal).
    // Las parejas no se cuentan: el delta de la pareja no es el delta personal del jugador.
    const variantes = APODO_A_NOMBRES_IC[jugador];
    if(variantes && typeof IC !== 'undefined'){
      const matchNombre = (n) => variantes.some(v => n && n.includes(v));
      Object.values(IC).forEach(yearData => {
        if(!yearData.pruebas) return;
        yearData.pruebas.forEach(prueba => {
          if(!prueba.fecha || prueba.total === null) return;
          const fecha = _parseFecha(prueba.fecha);
          if(!fecha) return;
          // Buscar si jugó individual y con qué score
          const indis = [];
          if(prueba.ind1) indis.push({n:prueba.ind1[0], s:prueba.ind1[1]}, {n:prueba.ind1[2], s:prueba.ind1[3]});
          if(prueba.ind2) indis.push({n:prueba.ind2[0], s:prueba.ind2[1]}, {n:prueba.ind2[2], s:prueba.ind2[3]});
          const yo = indis.find(x => matchNombre(x.n));
          if(yo) actuaciones.push({ fecha, delta: yo.s, src:'ic' });
        });
      });
    }
    if(actuaciones.length === 0) return null;
    actuaciones.sort((a,b) => b.fecha - a.fecha);
    const ult5 = actuaciones.slice(0, 5);
    return ult5.reduce((s,a) => s + a.delta, 0) / ult5.length;
  }

  // 🏆 Histórico Interclubs: % de podios (1º+2º+3º) sobre participaciones individuales.
  //    Recorre IC global y matchea por nombre IC del jugador.
  function calcHistoricoIC(jugador){
    const variantes = APODO_A_NOMBRES_IC[jugador];
    if(!variantes || typeof IC === 'undefined') return null;
    const matchNombre = (nombre) => variantes.some(v => nombre && nombre.includes(v));
    let participaciones = 0, podios = 0;
    Object.values(IC).forEach(yearData => {
      if(!yearData.pruebas) return;
      yearData.pruebas.forEach(prueba => {
        if(!prueba.total) return;
        // Recoger los 4 individuales con sus scores
        const all = [];
        if(prueba.ind1) all.push({n:prueba.ind1[0], s:prueba.ind1[1]}, {n:prueba.ind1[2], s:prueba.ind1[3]});
        if(prueba.ind2) all.push({n:prueba.ind2[0], s:prueba.ind2[1]}, {n:prueba.ind2[2], s:prueba.ind2[3]});
        // ¿Aparece el jugador como individual?
        const yo = all.find(x => matchNombre(x.n));
        if(!yo) return;
        participaciones++;
        // Pos 1, 2 o 3 (con empates): cuántos tienen score estrictamente mejor (menor)
        const pos = all.filter(x => x.s < yo.s).length + 1;
        if(pos <= 3) podios++;
      });
    });
    if(participaciones === 0) return null;
    return (podios / participaciones) * 100;
  }

  // 🐦 Birdies por ronda: media de birdies (incluye HiO) por jornada en este campo.
  //    Señal clave para parejas (fourball): los picos ganan hoyos.
  function calcBirdiesPorRonda(entreno, jugador){
    const rondas = entreno.jornadas
      .map(jr => entreno.hm[`${jr.j}_${jugador}`])
      .filter(arr => arr !== undefined);
    if(rondas.length === 0) return null;
    const totalBirdies = rondas.reduce((sum, arr) => {
      return sum + arr.filter(v => v <= 2).length;
    }, 0);
    return totalBirdies / rondas.length;
  }

  // ── Normalización a escala 0-100 (mayor = mejor) ─────────────────────
  // Para deltas vs par: -3 → 100 puntos, +15 → 0 puntos (interpolación lineal).
  // Para asistencia (0-1): * 100. Para % podios: ya está en 0-100.
  function _normDelta(delta){
    if(delta === null || delta === undefined) return null;
    const MIN = -3, MAX = 15; // calibración: -3 = excelente, +15 = catastrófico
    const score = 100 - ((delta - MIN) / (MAX - MIN)) * 100;
    return Math.max(0, Math.min(100, score));
  }

  // Para birdies/ronda: 0 birdies = 0 puntos, 5+ birdies = 100 puntos.
  // En P3 par 54, 5 birdies por ronda es excelente.
  function _normBirdies(bpr){
    if(bpr === null || bpr === undefined) return null;
    return Math.max(0, Math.min(100, (bpr / 5) * 100));
  }

  // Score compuesto del jugador para este entreno, con dos perfiles posibles:
  //   modo='indi'   → premia consistencia (incluye Floor)
  //   modo='pareja' → premia explosividad (incluye Birdies/ronda)
  // Devuelve { score:0-100, breakdown:{...}, eligible:bool, n:int, modo }.
  function calcScoreCompuesto(entreno, jugador, modo){
    modo = modo || 'indi';
    const n = entreno.jornadas.filter(jr => entreno.hm[`${jr.j}_${jugador}`] !== undefined).length;
    if(n === 0){
      return { score:null, eligible:false, n:0, modo, breakdown:null };
    }
    const w = getWeights(n, modo);
    const avgD   = calcAvgCampoDelta(entreno, jugador);
    const floorD = calcFloorCampoDelta(entreno, jugador);
    const asist  = calcAsistenciaCampo(entreno, jugador);
    const birdPR = calcBirdiesPorRonda(entreno, jugador);
    // Hándicap global: ya devuelve {hcp, n, trend}. Usamos hcp (delta vs par 54).
    const hg     = (typeof calcHandicapGlobal === 'function') ? calcHandicapGlobal(jugador) : { hcp:null };
    const hcpD   = hg.hcp; // delta vs par 54 (igual escala que avg)

    // Normalizar cada señal a 0-100
    const sAvg   = _normDelta(avgD);
    const sFloor = _normDelta(floorD);
    const sAsist = asist * 100;
    const sBir   = _normBirdies(birdPR);
    const sHcp   = _normDelta(hcpD);

    // Lista de partes con su score normalizado y peso. Solo las que apliquen al modo.
    const partes = [
      {key:'avg',   s:sAvg,   w:w.avg},
      {key:'asist', s:sAsist, w:w.asist},
      {key:'hcp',   s:sHcp,   w:w.hcp},
    ];
    if(modo === 'indi'){
      partes.push({key:'floor', s:sFloor, w:w.floor});
    } else {
      partes.push({key:'bir',   s:sBir,   w:w.bir});
      if(w.floor) partes.push({key:'floor', s:sFloor, w:w.floor});
    }

    // Si una señal es null, redistribuir su peso proporcionalmente al resto.
    const validas = partes.filter(p => p.s !== null && p.s !== undefined);
    const totalW = validas.reduce((sum,p) => sum + p.w, 0);
    if(totalW === 0) return { score:null, eligible:false, n, modo, breakdown:null };
    let score = 0;
    validas.forEach(p => {
      score += p.s * (p.w / totalW); // pesos renormalizados a 100
    });

    return {
      score: Math.round(score * 10) / 10,
      eligible: true,
      n,
      modo,
      breakdown: {
        avgDelta:      avgD,                                  // Avg efectivo (regresado)
        avgDeltaCrudo: calcAvgCampoDeltaCrudo(entreno, jugador), // Avg real en este campo (sin regresión)
        visitas:       n,                                     // Veces que ha jugado este campo
        floorDelta:  floorD,
        asistRatio:  asist,
        hcpGlobal:   hcpD,
        hcpTrend:    hg.trend,
        hcpN:        hg.n,
        birdiesRonda: birdPR,
        weights:     w,
        weightsUsed: validas.reduce((o,p) => (o[p.key] = Math.round(p.w/totalW*1000)/10, o), {}),
      },
    };
  }

  // Genera la convocatoria completa con scores DIFERENCIADOS:
  //   1. scoreIndi → top 4 = Indis (3 + 1 comodín)
  //   2. Quitando esos 4, scorePareja → top 4 = Parejas (P1+P2 con paridad)
  //   3. Resto → Banquillo
  // Calcula un "scoreBanquillo" para los jugadores SIN datos del campo concreto.
  // Combina 4 señales del jugador a nivel global:
  //   40% Hcp global · 30% Actividad últimas 6 semanas · 15% σ (consistencia) · 15% Tendencia
  // Devuelve null si no se puede calcular nada (jugador sin actuaciones).
  function calcScoreBanquillo(jugador){
    if(typeof calcHandicapGlobal !== 'function') return { score:null };
    const hg = calcHandicapGlobal(jugador);
    if(hg.hcp === null) return { score:null, hg };

    // Normalizar hcp (mismo criterio que avg/floor: -3→100, +15→0)
    const sHcp = Math.max(0, Math.min(100, 100 - ((hg.hcp - (-3)) / 18) * 100));

    // Actividad: contar partidos del jugador en últimas 6 semanas (42 días) DESDE HOY
    const hoy = new Date();
    const hace6sem = new Date(hoy.getTime() - 42 * 24 * 60 * 60 * 1000);
    let partidosRecientes = 0;
    if(typeof RAW !== 'undefined'){
      RAW.filter(r => r.jugador === jugador ).forEach(r => {
        const [d,mo,y] = r.f.split('/');
        if(new Date(+y, +mo-1, +d) >= hace6sem) partidosRecientes++;
      });
    }
    if(typeof ENTRENAMIENTOS_DATA !== 'undefined'){
      ENTRENAMIENTOS_DATA.forEach(ent => ent.jornadas.forEach(jr => {
        if(!ent.hm[`${jr.j}_${jugador}`]) return;
        const [d,mo,y] = jr.fecha.split('/');
        if(new Date(+y, +mo-1, +d) >= hace6sem) partidosRecientes++;
      }));
    }
    const variantes = (typeof APODO_A_NOMBRES_IC !== 'undefined') ? APODO_A_NOMBRES_IC[jugador] : null;
    if(variantes && typeof IC !== 'undefined'){
      Object.values(IC).forEach(yd => {
        if(!yd.pruebas) return;
        yd.pruebas.forEach(p => {
          if(!p.fecha || p.total === null) return;
          const [d,mo,y] = p.fecha.split('/');
          if(new Date(+y, +mo-1, +d) < hace6sem) return;
          const indis = [];
          if(p.ind1) indis.push({n:p.ind1[0]}, {n:p.ind1[2]});
          if(p.ind2) indis.push({n:p.ind2[0]}, {n:p.ind2[2]});
          if(indis.some(x => variantes.some(v => x.n && x.n.includes(v)))) partidosRecientes++;
        });
      });
    }

    // σ → puntos: σ baja = más puntos. <2→100, >7→0
    let sSigma = 50;
    if(hg.sigma !== null && hg.sigma !== undefined){
      sSigma = Math.max(0, Math.min(100, 100 - ((hg.sigma - 2) / 5) * 100));
    }

    // Tendencia (-2..+2) → puntos: -2 → 100, 0 → 50, +2 → 0
    const sTrend = 50 - (hg.trend * 25);

    return {
      score: null, // se rellena fuera con la normalización por ranking
      sHcp,
      sSigma,
      sTrend,
      partidosRecientes,
      hg,
    };
  }

  // ─── Compromiso (asistencia real últimos 3 meses) ──────────────────────
  // Política definida con Capi: el equipo entero (12 jugadores) tiene una media
  // de partidas en los últimos 3 meses. Si alguien está por debajo:
  //
  //   - Si tiene MENOS DEL 50% de la media → BANQUILLO AUTOMÁTICO (no titular).
  //   - Si está entre 50% y 100% → su score se penaliza proporcionalmente al
  //     déficit, con factor 0.5. Fórmula: lastre = (déficit / media) × 0.5
  //     Score final = score × (1 − lastre).
  //   - Si está por encima de la media → sin penalización.
  //
  // "Partida" = cualquier entry de RAW (Super ROC) o cualquier
  // jornada de cualquier ENTRENAMIENTOS_DATA, dentro de los últimos 90 días.
  // Las partidas IC no entran porque no tienen fecha exacta en el HTML.
  const COMPROMISO_VENTANA_DIAS = 90;     // últimos 3 meses
  const COMPROMISO_UMBRAL_HARD  = 0.50;   // < 50% media → banquillo automático
  const COMPROMISO_FACTOR_LASTRE = 0.5;   // factor del lastre proporcional

  function calcCompromisoEquipo(){
    const hoy = new Date();
    const desde = new Date(hoy.getTime() - COMPROMISO_VENTANA_DIAS * 24 * 60 * 60 * 1000);
    const partidasPorJugador = {};
    ENT_JUGADORES.forEach(j => partidasPorJugador[j] = 0);

    // Super ROC
    if(typeof RAW !== 'undefined' && Array.isArray(RAW)){
      RAW.forEach(r => {
        if(!ENT_JUGADORES.includes(r.jugador)) return;
        const f = _parseFecha(r.f);
        if(f && f >= desde && f <= hoy) partidasPorJugador[r.jugador]++;
      });
    }
    // Entrenamientos (todos los bloques)
    if(typeof ENTRENAMIENTOS_DATA !== 'undefined' && Array.isArray(ENTRENAMIENTOS_DATA)){
      ENTRENAMIENTOS_DATA.forEach(ent => {
        ent.jornadas.forEach(jr => {
          const f = _parseFecha(jr.fecha);
          if(!f || f < desde || f > hoy) return;
          ENT_JUGADORES.forEach(jug => {
            if(ent.hm[`${jr.j}_${jug}`] !== undefined) partidasPorJugador[jug]++;
          });
        });
      });
    }
    const totales = Object.values(partidasPorJugador);
    const media = totales.reduce((s,v) => s+v, 0) / totales.length;
    return { partidasPorJugador, media };
  }

  // Devuelve { partidas, media, deficit, factor, banquilloAuto, descripcion }
  // factor: multiplicador 0-1 a aplicar al score del jugador.
  // banquilloAuto: true si está por debajo del umbral hard (banquillo forzado).
  function calcCompromiso(jugador, datosEquipo){
    const partidas = datosEquipo.partidasPorJugador[jugador] || 0;
    const media = datosEquipo.media;
    if(media === 0) return { partidas, media, deficit:0, factor:1.0, banquilloAuto:false, descripcion:'Sin datos del equipo' };

    if(partidas >= media){
      return { partidas, media, deficit:0, factor:1.0, banquilloAuto:false, descripcion:`✅ ${partidas}/${media.toFixed(1)} (≥ media)` };
    }

    const ratio = partidas / media;
    if(ratio < COMPROMISO_UMBRAL_HARD){
      return {
        partidas, media,
        deficit: media - partidas,
        factor: 0,
        banquilloAuto: true,
        descripcion: `🚫 ${partidas}/${media.toFixed(1)} (< 50% media — banquillo auto)`,
      };
    }
    // Lastre proporcional al déficit
    const deficit = media - partidas;
    const lastre = (deficit / media) * COMPROMISO_FACTOR_LASTRE;
    const factor = 1 - lastre;
    return {
      partidas, media, deficit, factor,
      banquilloAuto: false,
      descripcion: `⚠️ ${partidas}/${media.toFixed(1)} (lastre ${(lastre*100).toFixed(0)}%)`,
    };
  }

  function calcConvocatoria(entreno){
    // Datos de compromiso del equipo (últimos 3 meses)
    const datosEquipo = calcCompromisoEquipo();

    // Calcular AMBOS scores para cada jugador (útil para mostrar en banquillo y tooltip)
    const todos = ENT_JUGADORES.map(j => {
      const indi = calcScoreCompuesto(entreno, j, 'indi');
      const pareja = calcScoreCompuesto(entreno, j, 'pareja');
      const compromiso = calcCompromiso(j, datosEquipo);
      // Aplicar factor compromiso a ambos scores (si los hay)
      const scoreIndiAjustado = indi.score !== null ? Math.round(indi.score * compromiso.factor * 10) / 10 : null;
      const scoreParejaAjustado = pareja.score !== null ? Math.round(pareja.score * compromiso.factor * 10) / 10 : null;
      return {
        jugador: j,
        eligible: indi.eligible,
        n: indi.n,
        scoreIndi: scoreIndiAjustado,
        scorePareja: scoreParejaAjustado,
        scoreIndiCrudo: indi.score,
        scoreParejaCrudo: pareja.score,
        breakdown: indi.breakdown,
        compromiso,
      };
    });
    const conDatos = todos.filter(p => p.eligible);
    const sinDatos = todos.filter(p => !p.eligible);

    // ── Calcular scoreBanquillo para los sin datos del campo ──
    // Actividad se normaliza por RANKING (relativo entre los del banquillo)
    const sinDatosInfo = sinDatos.map(p => ({...p, info: calcScoreBanquillo(p.jugador)}));
    const conInfo = sinDatosInfo.filter(p => p.info && p.info.score !== undefined && p.info.hg && p.info.hg.hcp !== null);

    if(conInfo.length > 0){
      // Normalizar actividad: mejor (más partidos) = 100, peor = 0; intermedios proporcionales.
      const maxAct = Math.max(...conInfo.map(p => p.info.partidosRecientes));
      conInfo.forEach(p => {
        const sAct = maxAct === 0 ? 50 : (p.info.partidosRecientes / maxAct) * 100;
        // Score combinado: 40 hcp + 30 actividad + 15 σ + 15 tendencia
        p.info.sAct = sAct;
        p.scoreBanquillo = Math.round(
          (p.info.sHcp * 40 + sAct * 30 + p.info.sSigma * 15 + p.info.sTrend * 15) / 100 * 10
        ) / 10;
      });
    }
    sinDatosInfo.forEach(p => {
      if(p.scoreBanquillo === undefined) p.scoreBanquillo = null;
    });
    // Ordenar sin datos: primero los que tienen scoreBanquillo (desc), luego los que no
    const sinDatosOrdenados = sinDatosInfo.sort((a,b) => {
      if(a.scoreBanquillo === null && b.scoreBanquillo === null) return 0;
      if(a.scoreBanquillo === null) return 1;
      if(b.scoreBanquillo === null) return -1;
      return b.scoreBanquillo - a.scoreBanquillo;
    });

    // 1) Indis: top 4 de los con datos del campo (scoreIndi desc)
    //    FILTRO HARD: los que tienen banquilloAuto (compromiso < 50% media) NO pueden ser indis.
    const ordIndi = [...conDatos].filter(p => !p.compromiso.banquilloAuto).sort((a,b) => b.scoreIndi - a.scoreIndi);
    const indis = ordIndi.slice(0, 4).map(p => ({...p, slotScore: p.scoreIndi, slot:'indi', sinDatosCampo:false}));
    const indisSet = new Set(indis.map(p => p.jugador));

    // 2) Parejas: hasta 4. Primero los con datos del campo (scorePareja desc), luego rellenar
    //    con los del banquillo ordenados por scoreBanquillo hasta llegar a 4.
    //    FILTRO HARD también para parejas.
    const poolConDatos = conDatos.filter(p => !indisSet.has(p.jugador) && !p.compromiso.banquilloAuto);
    const ordPareja = poolConDatos.sort((a,b) => b.scorePareja - a.scorePareja);
    const parejas = ordPareja.slice(0, 4).map(p => ({...p, slotScore: p.scorePareja, slot:'pareja', sinDatosCampo:false}));
    // Rellenar con sin-datos hasta 4 si faltan
    const faltan = 4 - parejas.length;
    if(faltan > 0){
      const rellenos = sinDatosOrdenados.slice(0, faltan).map(p => ({
        ...p,
        slotScore: p.scoreBanquillo,
        slot: 'pareja',
        sinDatosCampo: true,
      }));
      parejas.push(...rellenos);
    }
    const parejasUsadas = new Set(parejas.filter(p => p.sinDatosCampo).map(p => p.jugador));

    // 3) Banquillo: el resto.
    const yaUsados = new Set([...indis, ...parejas].map(p => p.jugador));
    const banquilloConDatos = conDatos
      .filter(p => !yaUsados.has(p.jugador))
      .sort((a,b) => Math.max(b.scoreIndi, b.scorePareja) - Math.max(a.scoreIndi, a.scorePareja))
      .map(p => ({...p, slotScore: Math.max(p.scoreIndi, p.scorePareja), slot:'banquillo', sinDatosCampo:false}));
    const banquilloSinDatos = sinDatosOrdenados
      .filter(p => !parejasUsadas.has(p.jugador))
      .map(p => ({...p, slotScore: p.scoreBanquillo, slot:'banquillo', sinDatosCampo:true}));
    const banquillo = banquilloConDatos.concat(banquilloSinDatos);

    return { indis, parejas, banquillo };
  }

  function fmtDelta(d){
    if(d === null || d === undefined) return '—';
    const r = Math.round(d * 10) / 10;
    if(r === 0) return 'E';
    const str = (r % 1 === 0) ? `${Math.abs(r)}` : `${Math.abs(r).toFixed(1)}`;
    return r > 0 ? `+${str}` : `−${str}`;
  }

  function fmtDeltaInt(d){
    if(d === null) return '—';
    if(d === 0) return 'E';
    return d > 0 ? `+${d}` : `−${Math.abs(d)}`;
  }

  function renderScoreCell(v){
    if(v === null || v === undefined) return '<span class="par-num">—</span>';
    const display = v > ENT_MAX_HOYO ? 'X' : v;
    if(v <= 1) return `<span class="chip chip-hio">${display}</span>`;
    if(v === 2) return `<span class="chip chip-birdie">${display}</span>`;
    if(v === 3) return `<span class="par-num">3</span>`;
    if(v === 4) return `<span class="chip chip-bogey">${display}</span>`;
    return `<span class="chip chip-doble">${display}</span>`;
  }

  function renderPlayers(blockEl, entreno){
    const indisEl     = blockEl.querySelector('[data-role="indis"]');
    const parejasEl   = blockEl.querySelector('[data-role="parejas"]');
    const banquilloEl = blockEl.querySelector('[data-role="banquillo"]');

    const fmtSign = (x, dec=1) => {
      if(x === null || x === undefined) return '—';
      const r = Math.round(x * Math.pow(10,dec)) / Math.pow(10,dec);
      if(r === 0) return 'PAR';
      return (r > 0 ? '+' : '') + (Number.isInteger(r) ? r : r.toFixed(dec));
    };

    const buildCard = (p, badge, attenuated) => {
      // Sin datos del campo pero CON scoreBanquillo (entró por hcp/actividad)
      if(p.sinDatosCampo){
        const sbInfo = p.info || {};
        const hcpStr = (sbInfo.hg && sbInfo.hg.hcp !== null) ? fmtSign(sbInfo.hg.hcp) : '—';
        const partidos = sbInfo.partidosRecientes !== undefined ? sbInfo.partidosRecientes : 0;
        const sigmaStr = (sbInfo.hg && sbInfo.hg.sigma !== null && sbInfo.hg.sigma !== undefined)
          ? `σ ${sbInfo.hg.sigma.toFixed(1)}` : 'σ —';
        const popData = JSON.stringify({
          tipo: 'sindatos',
          jugador: p.jugador,
          scoreBanquillo: p.scoreBanquillo,
          hcpStr, partidos, sigmaStr
        }).replace(/"/g,'&quot;');
        const badgeHtml = badge ? `<span class="ent-badge">${badge}</span>` : '';
        return `
          <div class="pcard pcard-sindatos" data-pop="${popData}" onclick="window.__entTogglePop(this, event)">
            ${badgeHtml}
            <div class="name">${p.jugador}</div>
            <div class="delta delta-sindatos">${hcpStr}</div>
            <div class="ent-mini">⭐${p.scoreBanquillo} · ⏱️${partidos}p · ${sigmaStr}</div>
          </div>`;
      }
      if(!p.eligible){
        return `
          <div class="pcard empty">
            <div class="name">${p.jugador}</div>
            <div class="delta delta-empty">—</div>
          </div>`;
      }
      const b = p.breakdown;
      // Clase de color del delta-avg → según el AVG REAL del campo (lo que el jugador hizo).
      // El avg efectivo (regresado al hcp global) se muestra solo en el popover.
      let deltaCls = 'delta-zero';
      if(b.avgDeltaCrudo < 0) deltaCls = 'delta-neg';
      else if(b.avgDeltaCrudo > 0) deltaCls = 'delta-pos';

      // Línea pequeña con score (el del slot que ocupa) + asist + birdies/ronda
      const scoreSlot = p.slotScore !== undefined && p.slotScore !== null ? p.slotScore : p.scoreIndi;
      const hasBird = b.birdiesRonda !== null && b.birdiesRonda !== undefined;
      const miniLine = [
        `⭐${scoreSlot}`,
        `⏱️${(b.asistRatio*100).toFixed(0)}%`,
        hasBird ? `🐦${b.birdiesRonda.toFixed(1)}` : null,
      ].filter(Boolean).join(' ');

      const hcpStr = (b.hcpGlobal === null || b.hcpGlobal === undefined)
        ? `${b.hcpN || 0}/10 partidas`
        : fmtSign(b.hcpGlobal);
      const compromisoData = p.compromiso ? {
        partidas: p.compromiso.partidas,
        media: p.compromiso.media.toFixed(1),
        descripcion: p.compromiso.descripcion,
        scoreCrudoIndi: p.scoreIndiCrudo,
        scoreCrudoPareja: p.scoreParejaCrudo,
      } : null;
      const popData = JSON.stringify({
        tipo: 'normal',
        jugador: p.jugador,
        slot: p.slot,
        n: p.n,
        scoreIndi: p.scoreIndi,
        scorePareja: p.scorePareja,
        avgDelta: fmtSign(b.avgDelta),
        avgDeltaCrudo: fmtSign(b.avgDeltaCrudo),
        visitas: b.visitas,
        floorDelta: fmtSign(b.floorDelta),
        birdiesRonda: hasBird ? b.birdiesRonda.toFixed(1) : '—',
        asistRatio: (b.asistRatio*100).toFixed(0) + '%',
        hcpGlobal: hcpStr,
        compromiso: compromisoData,
      }).replace(/"/g,'&quot;');
      const badgeHtml = badge ? `<span class="ent-badge">${badge}</span>` : '';
      const cls = attenuated ? 'pcard pcard-attenuated' : 'pcard';
      return `
        <div class="${cls}" data-pop="${popData}" onclick="window.__entTogglePop(this, event)">
          ${badgeHtml}
          <div class="name">${p.jugador}</div>
          <div class="delta ${deltaCls}">${fmtSign(b.avgDeltaCrudo)}</div>
          <div class="ent-mini">${miniLine}</div>
        </div>`;
    };

    // Calcular convocatoria sugerida con score compuesto
    const conv = calcConvocatoria(entreno);

    // INDIS: los 4 jugadores son titulares por igual. No hay atenuación visual.
    // (En el formato Interclubs, el peor de los 4 es "descartable" pero a priori juegan los 4.)
    const indisHtml = conv.indis.map((p,i) => {
      return buildCard(p, null, false);
    }).join('');

    // PAREJAS: sin badge P1/P2. La P2 (3º y 4º de la lista) atenuada porque es la pareja
    // descartable en el formato Interclubs (peor pareja no puntúa).
    const parejasHtml = conv.parejas.map((p,i) => {
      const numPareja = Math.floor(i/2) + 1;
      const attenuated = numPareja === 2;
      return buildCard(p, null, attenuated);
    }).join('');

    // BANQUILLO: sin badge; los sin datos atenuados
    const banquilloHtml = conv.banquillo.map(p => buildCard(p, null, !p.eligible)).join('');

    const empty = '<div style="color:var(--ent-ink-dim);font-size:12px;padding:12px;">Sin jugadores</div>';
    indisEl.innerHTML     = indisHtml     || empty;
    parejasEl.innerHTML   = parejasHtml   || empty;
    banquilloEl.innerHTML = banquilloHtml || empty;
  }

  function renderJornadas(blockEl, entreno){
    const cont = blockEl.querySelector('[data-role="jornadas"]');

    if(entreno.jornadas.length === 0){
      cont.innerHTML = `
        <div class="empty-state">
          <div class="ico">⛳</div>
          <h3>Aún no hay partidos</h3>
          <p>Cuando juguéis la primera jornada aparecerá aquí.</p>
        </div>`;
      return;
    }

    const ordenadas = [...entreno.jornadas].sort((a,b) => b.j - a.j);
    const headersHoyos = Array.from({length:18}, (_,i) => `<th>${i+1}</th>`).join('');

    cont.innerHTML = ordenadas.map(jr => {
      const filasData = ENT_JUGADORES
        .map(jug => ({
          jug,
          arr: entreno.hm[`${jr.j}_${jug}`],
          tot: totalJornada(entreno, jr.j, jug),
          cnt: countScores(entreno, jr.j, jug)
        }))
        .filter(x => x.tot !== null)
        .sort((a,b) => a.tot - b.tot);

      const filas = filasData.map(({jug, arr, tot, cnt}) => {
        const delta = tot - ENT_PAR_CAMPO;
        const celdas = Array.from({length:18}, (_,i) => `<td>${renderScoreCell(arr[i])}</td>`).join('');
        const stat = (n, cls) => `<td class="col-stat ${cls} ${n === 0 ? 'zero' : ''}">${n}</td>`;

        return `
          <tr>
            <td class="col-jug">${jug}</td>
            ${celdas}
            <td class="col-tot">${fmtDeltaInt(delta)}</td>
            ${stat(cnt.bir, 'bir')}
            ${stat(cnt.par, 'par')}
            ${stat(cnt.bog, 'bog')}
            ${stat(cnt.dbl, 'dbl')}
          </tr>`;
      }).join('');

      return `
        <div class="jornada">
          <div class="jornada-header">
            <div class="jornada-title">Jornada <em>${jr.j}</em></div>
            <div class="jornada-fecha">${jr.fecha || ''}</div>
          </div>
          <div class="table-wrap">
            <table class="scorecard">
              <thead>
                <tr>
                  <th class="col-jug">Jugador</th>
                  ${headersHoyos}
                  <th class="col-tot">Tot</th>
                  <th class="col-stat col-stat-bir">🐦</th>
                  <th class="col-stat">✅</th>
                  <th class="col-stat col-stat-bog">✗</th>
                  <th class="col-stat col-stat-dbl">✗✗</th>
                </tr>
              </thead>
              <tbody>${filas}</tbody>
            </table>
          </div>
        </div>`;
    }).join('');
  }

  function renderEntrenoBlock(entreno, expanded){
    return `
      <details class="entreno-block" data-entreno-id="${entreno.id}"${expanded ? ' open' : ''}>
        <summary>
          <div class="entreno-meta">
            <div class="eyebrow">Entrenamiento · ${entreno.jornadaInterclubs}ª Jornada Interclubs</div>
            <div class="titulo">${entreno.campo}</div>
          </div>
          <div class="entreno-fecha">${entreno.fecha}</div>
          <div class="entreno-chevron">▾</div>
        </summary>
        <div class="entreno-body">
          <div class="ent-section-title">Indis</div>
          <div class="players-grid grid-2" data-role="indis"></div>

          <div class="ent-section-title">Parejas</div>
          <div class="players-grid grid-2" data-role="parejas"></div>

          <div class="ent-section-title">Banquillo</div>
          <div class="players-grid" data-role="banquillo"></div>

          <div class="ent-section-title">Resultados por jornada</div>
          <div data-role="jornadas"></div>
        </div>
      </details>`;
  }

  window.renderEntrenamiento = function(el){
    if(ENTRENAMIENTOS.length === 0){
      el.innerHTML = `
        <div class="ent-wrap">
          <div class="empty-state">
            <div class="ico">🎯</div>
            <h3>Aún no hay entrenamientos</h3>
            <p>Cuando juguéis el primer entreno preparatorio aparecerá aquí.</p>
          </div>
        </div>`;
      return;
    }

    // Más reciente arriba (último del array → primero en pantalla)
    const ordenados = [...ENTRENAMIENTOS].reverse();
    const bloques = ordenados.map((e, i) => renderEntrenoBlock(e, i === 0)).join('');

    el.innerHTML = `
      <div class="ent-wrap">
        ${bloques}
        <div class="ent-foot">Roc &amp; Roll <span>·</span> Entreno</div>
      </div>`;

    // Inyectar contenido dinámico (cuadraditos + tablas) en cada bloque
    ordenados.forEach(entreno => {
      const blockEl = el.querySelector(`[data-entreno-id="${entreno.id}"]`);
      if(blockEl){
        renderPlayers(blockEl, entreno);
        renderJornadas(blockEl, entreno);
      }
    });
  };
})();

// Sistema de popover fijo al click para los cuadraditos de Entrenamiento.
// Click en card → abre popover anclado, marca card activa.
// Click en otra card → cierra anterior y abre nueva.
// Click fuera → cierra.
(function(){
  function closePop(){
    const open = document.querySelector('#tab-entrenamiento .pcard-popover');
    if(open) open.remove();
    document.querySelectorAll('#tab-entrenamiento .pcard.pcard-active').forEach(c => c.classList.remove('pcard-active'));
  }
  window.__entTogglePop = function(card, ev){
    if(ev) ev.stopPropagation();
    const yaActiva = card.classList.contains('pcard-active');
    closePop();
    if(yaActiva) return; // segundo click sobre la misma cierra
    let data;
    try { data = JSON.parse(card.getAttribute('data-pop').replace(/&quot;/g,'"')); }
    catch(e){ return; }
    let html = '';
    if(data.tipo === 'sindatos'){
      html = `
        <div class="pop-title">${data.jugador} <span style="font-weight:400;color:#888">(sin datos en este campo)</span></div>
        <span class="pop-close" onclick="window.__entTogglePop(this.closest('.pcard'), event)">×</span>
        <div class="pop-row"><span class="pop-label">⭐ Score banquillo</span><span class="pop-value">${data.scoreBanquillo}</span></div>
        <div class="pop-row"><span class="pop-label">🆔 Hcp global</span><span class="pop-value">${data.hcpStr}</span></div>
        <div class="pop-row"><span class="pop-label">⏱️ Últ. 6 sem</span><span class="pop-value">${data.partidos} partidos</span></div>
        <div class="pop-row"><span class="pop-label">🪙 Consistencia</span><span class="pop-value">${data.sigmaStr}</span></div>
      `;
    } else {
      const compromisoBlock = data.compromiso ? `
        <div style="margin-top:6px;padding-top:5px;border-top:1px solid #ece6c8;">
          <div class="pop-row"><span class="pop-label">🤝 Compromiso</span><span class="pop-value">${data.compromiso.descripcion}</span></div>
          ${data.compromiso.scoreCrudoIndi !== null && data.compromiso.scoreCrudoIndi !== data.scoreIndi ? `<div class="pop-row" style="font-size:10px;color:#888"><span class="pop-label">Score crudo INDI</span><span class="pop-value">${data.compromiso.scoreCrudoIndi}/100 → ${data.scoreIndi}</span></div>` : ''}
          ${data.compromiso.scoreCrudoPareja !== null && data.compromiso.scoreCrudoPareja !== data.scorePareja ? `<div class="pop-row" style="font-size:10px;color:#888"><span class="pop-label">Score crudo PAREJA</span><span class="pop-value">${data.compromiso.scoreCrudoPareja}/100 → ${data.scorePareja}</span></div>` : ''}
        </div>` : '';
      html = `
        <div class="pop-title">${data.jugador} <span style="font-weight:400;color:#888">· slot ${data.slot} · ${data.visitas} ${data.visitas===1?'visita':'visitas'}</span></div>
        <span class="pop-close" onclick="window.__entTogglePop(this.closest('.pcard'), event)">×</span>
        <div class="pop-row"><span class="pop-label">⭐ Score INDI</span><span class="pop-value">${data.scoreIndi}/100</span></div>
        <div class="pop-row"><span class="pop-label">⭐ Score PAREJA</span><span class="pop-value">${data.scorePareja}/100</span></div>
        <div class="pop-row"><span class="pop-label">🎯 Avg real campo</span><span class="pop-value">${data.avgDeltaCrudo}</span></div>
        <div class="pop-row"><span class="pop-label">🎯 Avg efectivo*</span><span class="pop-value">${data.avgDelta}</span></div>
        <div class="pop-row"><span class="pop-label">🛡️ Floor (peor)</span><span class="pop-value">${data.floorDelta}</span></div>
        <div class="pop-row"><span class="pop-label">🐦 Birdies/ronda</span><span class="pop-value">${data.birdiesRonda}</span></div>
        <div class="pop-row"><span class="pop-label">⏱️ Asistencia</span><span class="pop-value">${data.asistRatio}</span></div>
        <div class="pop-row"><span class="pop-label">🆔 Hcp global</span><span class="pop-value">${data.hcpGlobal}</span></div>
        ${compromisoBlock}
        <div style="margin-top:6px;padding-top:5px;border-top:1px solid #ece6c8;font-size:10px;color:#888;line-height:1.4">* Avg efectivo: media regresada al Hcp global con muestra pequeña (k=3)</div>
      `;
    }
    const pop = document.createElement('div');
    pop.className = 'pcard-popover';
    pop.innerHTML = html;
    pop.addEventListener('click', e => e.stopPropagation());
    card.classList.add('pcard-active');
    card.appendChild(pop);
  };
  // Click fuera cierra el popover
  document.addEventListener('click', function(e){
    if(!e.target.closest('#tab-entrenamiento')) return;
    if(e.target.closest('.pcard') || e.target.closest('.pcard-popover')) return;
    closePop();
  });
  // Cerrar al cambiar de pestaña
  if(typeof window.__entCloseOnTabSwitch === 'undefined'){
    window.__entCloseOnTabSwitch = true;
    document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', closePop));
  }
})();

renderTab('handicapglobal');
document.getElementById('tab-handicapglobal').dataset.rendered='1';
</script>

<!-- Modal crónica -->
<div id="cronica-overlay" onclick="if(event.target===this)closeCronica()" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.55);z-index:9999;align-items:flex-start;justify-content:center;padding:20px 10px;overflow-y:auto">
  <div style="background:#fffbf0;border:1px solid #fde68a;border-radius:14px;max-width:560px;width:100%;box-shadow:0 10px 40px rgba(0,0,0,0.3);margin:20px 0">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #fde68a">
      <div id="cronica-titulo" style="font-weight:600;font-size:13px;color:#92400e"></div>
      <span onclick="closeCronica()" style="cursor:pointer;font-size:20px;line-height:1;color:#92400e;padding:2px 6px;border-radius:4px" onmouseover="this.style.background='rgba(146,64,14,0.1)'" onmouseout="this.style.background='transparent'">×</span>
    </div>
    <div id="cronica-cuerpo" style="padding:16px 18px;font-size:13px;color:#374151;line-height:1.65"></div>
  </div>
</div>
</body>
</html>
