// Recalcular n, current, best y best_f desde RAW + history (nunca hardcodeados)
(function recalcHCP(){
  PLAYERS.forEach(p=>{
    const d=HCP_DATA[p];
    if(!d)return;
    // n = partidas jugadas
    d.n=RAW.filter(r=>r.jugador===p).length;
    // current = último hcp del history
    const hist=d.history.filter(x=>x.hcp!==null).sort((a,b)=>a.j-b.j);
    d.current=hist.length?hist[hist.length-1].hcp:null;
    // best = mínimo score en RAW
    const scores=RAW.filter(r=>r.jugador===p).map(r=>r.total);
    if(scores.length){
      const minScore=Math.min(...scores);
      if(minScore<(d.best??Infinity)){
        d.best=minScore;
        const bestRow=RAW.find(r=>r.jugador===p&&r.total===minScore);
        if(bestRow)d.best_f=bestRow.f;
      }
    }
  });
})();

// Subpestañas que pertenecen al grupo Super ROC
const SUPERROC_TABS = ['handicap','tabla','records','stats','radiografia','bitacora'];

function showTab(t,ev){
  // Ocultar todos los content
  document.querySelectorAll('.content').forEach(el=>el.style.display='none');
  // Limpiar active de TODOS los tabs y subtabs
  document.querySelectorAll('.tabs .tab, .subtabs .subtab').forEach(x=>x.classList.remove('active'));

  // Mostrar el contenido pedido
  const el = document.getElementById('tab-'+t);
  if(!el) return;
  el.style.display='block';
  if(!el.dataset.rendered){renderTab(t);el.dataset.rendered='1';}

  // Activar el botón correspondiente y la sub-barra si procede
  if(SUPERROC_TABS.includes(t)){
    const padre = document.querySelector('.tabs .tab[data-tab="superroc"]');
    if(padre) padre.classList.add('active');
    document.getElementById('subtabs-superroc').style.display = 'flex';
    const sub = document.querySelector(`.subtabs .subtab[data-tab="${t}"]`);
    if(sub) sub.classList.add('active');
  } else {
    document.getElementById('subtabs-superroc').style.display = 'none';
    const btn = document.querySelector(`.tabs .tab[data-tab="${t}"]`);
    if(btn) btn.classList.add('active');
  }
}

function showSuperRoc(ev){
  // Click en pestaña padre Super ROC → entrar por defecto en Hándicap SR
  showTab('handicap');
}
function fmt(t,abd){if(abd)return'ABD';if(t===0)return'E';return t>0?'+'+t:''+t;}
function tc(t,abd){if(abd)return'#7c3aed';if(t<0)return'#15803d';if(t===0)return'#888';return'#b91c1c';}
function hc(v){if(v===null||v===undefined)return{bg:'transparent',col:'#ccc',fw:400};if(v<=2)return{bg:'#fef9c3',col:'#854d0e',fw:600};if(v===3)return{bg:'transparent',col:'#333',fw:400};if(v===4)return{bg:'transparent',col:'#c2410c',fw:400};return{bg:'rgba(220,38,38,0.13)',col:'#991b1b',fw:600};}
function renderTab(t){
  const el=document.getElementById('tab-'+t);
  if(t==='equipo')renderEquipo(el);
  else if(t==='campos')renderCampos(el);
  else if(t==='tabla')renderTabla(el);
  else if(t==='records')renderRecords(el);
  else if(t==='stats')renderStats(el);
  else if(t==='radiografia')renderRadiografia(el);
  else if(t==='handicap')renderHandicap(el);
  else if(t==='handicapglobal')renderHandicapGlobal(el);
  else if(t==='interclubs')renderInterclubs(el);
  else if(t==='ranking')renderRanking(el);
  else if(t==='torneos')renderTorneos(el);
  else if(t==='coparocroll')renderCopaRocRoll(el);
  else if(t==='entrenamiento')renderEntrenamiento(el);
  else if(t==='comandos')renderComandos(el);
  else if(t==='bitacora')renderBitacora(el);
}

