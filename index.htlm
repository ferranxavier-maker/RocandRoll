// ── Recalcular total/front/back/bir/par/bog/dbl como FÓRMULA derivada de HM ──
// HM es la única fuente de verdad. RAW se sincroniza automáticamente.
(function syncRAWfromHM(){
  // Precomputar set de jornadas presentes en HM (cualquier jugador) para detectar typos de apodo
  const jornadasEnHM=new Set();
  Object.keys(HM).forEach(k=>{const j=parseInt(k.split('_')[0],10);if(!isNaN(j))jornadasEnHM.add(j);});
  RAW.forEach(r=>{
    const arr=HM[r.j+'_'+r.jugador];
    if(!arr){
      // Si la jornada SÍ está en HM para otros jugadores pero no para éste → probable typo en apodo.
      // Si la jornada entera no está en HM (datos antiguos pre-HM), silencio.
      if(jornadasEnHM.has(r.j)){
        console.warn('[syncRAWfromHM] Falta HM["'+r.j+'_'+r.jugador+'"] pero J'+r.j+' sí está en HM para otros jugadores. ¿Typo en el apodo?');
      }
      return;
    }
    const played=arr.filter(x=>x!==null&&x!==undefined);
    if(!played.length)return;
    // Conteos siempre desde HM
    r.bir=played.filter(v=>v<=2).length;
    r.par=played.filter(v=>v===3).length;
    r.bog=played.filter(v=>v===4).length;
    r.dbl=played.filter(v=>v>=5).length;
    if(played.length===18){
      r.total=arr.reduce((s,v)=>s+v,0)-54;
      r.front=arr.slice(0,9).reduce((s,v)=>s+v,0)-27;
      r.back=arr.slice(9,18).reduce((s,v)=>s+v,0)-27;
    }
  });
})();

